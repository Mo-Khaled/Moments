{%- comment -%}
  Refer a friend: the honest version. It explains and gives three ways to share the store link: WhatsApp, copy link, and the phone's
  share sheet when the browser has one. There is NO reward, code, discount or points: none exist yet. A "Reward details" block stays hidden
  until the owner fills the setting (TODO). Options for a real programme (a referral app, or manual codes) are in docs/needs-from-owner.md.
{%- endcomment -%}

{%- liquid
  assign share_url = shop.url
  assign share_text = 'refer.message' | t
  assign wa = 'https://wa.me/?text=' | append: share_text | append: ' ' | append: share_url
-%}

<section class="m-refer" aria-labelledby="m-refer-title-{{ section.id }}" data-m-refer data-url="{{ share_url }}" data-text="{{ share_text | escape }}">
  <div class="m-wrap m-refer__inner">
    <div class="m-refer__copy">
      <h1 class="m-refer__title" id="m-refer-title-{{ section.id }}">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'refer.heading' | t }}{%- endif -%}
      </h1>
      <p class="m-refer__text">{{ 'refer.text' | t }}</p>
      <div class="m-refer__actions">
        <a class="m-btn" href="{{ wa | replace: ' ', '%20' }}" target="_blank" rel="noopener">{{ 'refer.share_whatsapp' | t }}</a>
        <button class="m-btn m-btn--ghost" type="button" data-m-refer-copy data-copied="{{ 'refer.copied' | t }}">{{ 'refer.copy' | t }}</button>
        <button class="m-btn m-btn--ghost" type="button" data-m-refer-share hidden>{{ 'refer.share' | t }}</button>
      </div>
      <p class="m-refer__status m-sr-only" role="status" aria-live="polite" data-m-refer-status></p>
      {%- if section.settings.reward != blank -%}
        <div class="m-refer__reward">
          <h2>{{ 'refer.reward' | t }}</h2>
          <p>{{ section.settings.reward }}</p>
        </div>
      {%- elsif request.design_mode -%}
        <p class="m-refer__todo">TODO: reward details. Leave empty until there is a real programme.</p>
      {%- endif -%}
    </div>

    <div class="m-refer__steps">
      <h2 class="m-refer__steps-title">{{ 'refer.steps' | t }}</h2>
      <ol class="m-refer__list">
        {%- assign marks = 'night,gift,allday' | split: ',' -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign t_key = 'refer.s' | append: i
            assign x_key = 'refer.s' | append: i | append: '_text'
            assign mark = marks[forloop.index0]
          -%}
          <li class="m-refer__step m-tone--{{ mark }}">
            <span class="m-refer__art" aria-hidden="true">{% render 'moment-mark', mark: mark, size: 'lg' %}</span>
            <span class="m-refer__step-title">{{ t_key | t }}</span>
            <span class="m-refer__step-text">{{ x_key | t }}</span>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% stylesheet %}
  .m-refer {
    padding-block: clamp(40px, 6vw, 96px);
    background: var(--m-surface);
    color: var(--m-text);
  }

  .m-refer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .m-refer__title {
    margin: 0 0 12px;
    max-inline-size: 14ch;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1;
    text-wrap: balance;
  }

  .m-refer__text {
    margin: 0 0 24px;
    max-inline-size: 40ch;
    color: var(--m-text-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .m-refer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .m-refer__reward h2 {
    margin: 24px 0 4px;
    font-size: 1.25rem;
  }

  .m-refer__todo {
    margin: 24px 0 0;
    padding: 8px 12px;
    border: 1px dashed var(--m-gold-ink);
    font-size: 0.8125rem;
  }

  .m-refer__steps-title {
    margin: 0 0 12px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  html[lang='ar'] .m-refer__steps-title {
    letter-spacing: 0;
    text-transform: none;
  }

  .m-refer__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-refer__step {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    position: relative;
    display: grid;
    align-content: center;
    gap: 2px;
    min-block-size: 132px;
    padding-block: 16px;
    padding-inline: 112px 20px;
    background: var(--tile-bg);
    color: var(--tile-ink);
  }

  .m-refer__art {
    position: absolute;
    inset-block: 14px;
    inset-inline-start: 12px;
    inline-size: 92px;
  }

  .m-refer__art moment-mark {
    --mm-size: 92px;
  }

  .m-refer__step-title {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .m-refer__step-text {
    font-size: 0.9375rem;
  }

  @media screen and (min-width: 990px) {
    .m-refer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 96px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.querySelector('[data-m-refer]');
    if (!root) return;
    const url = root.dataset.url;
    const text = root.dataset.text;
    const status = root.querySelector('[data-m-refer-status]');
    const copy = root.querySelector('[data-m-refer-copy]');
    const share = root.querySelector('[data-m-refer-share]');
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(url); } catch (e) {
        const t = document.createElement('textarea'); t.value = url; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove();
      }
      status.textContent = copy.dataset.copied;
      const label = copy.textContent; copy.textContent = copy.dataset.copied;
      setTimeout(() => { copy.textContent = label; }, 1800);
    });
    if (navigator.share) {
      share.hidden = false;
      share.addEventListener('click', () => navigator.share({ title: document.title, text, url }).catch(() => {}));
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "MOMENTS refer",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "reward", "label": "Reward details", "info": "TODO: owner. There is no reward programme yet. Hidden until filled." }
  ],
  "presets": [{ "name": "MOMENTS refer" }]
}
{% endschema %}
