{%- comment -%}
  Four promises in moment colour blocks (2 x 2). DRAFT copy: the label "DRAFT, needs owner approval" is shown in the theme
  editor only, never to shoppers. Each block is a plain colour field with a title and one line: no icons, no repeated card kit.
{%- endcomment -%}

<section class="m-promises" aria-labelledby="m-promises-title-{{ section.id }}">
  <div class="m-wrap">
    <h2 class="m-promises__title" id="m-promises-title-{{ section.id }}">
      {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'about.promises.heading' | t }}{%- endif -%}
    </h2>
    {%- if request.design_mode -%}
      <p class="m-promises__draft">{{ 'about.promises.draft' | t }}</p>
    {%- endif -%}
    <ul class="m-promises__grid">
      {%- assign tones = 'night,gift,allday,fresh' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign tone = tones[forloop.index0] | default: 'night'
          assign title = block.settings.title
          assign text = block.settings.text
          assign title_key = 'about.promises.p' | append: forloop.index | append: '_title'
          assign text_key = 'about.promises.p' | append: forloop.index | append: '_text'
          if title == blank
            assign title = title_key | t
          endif
          if text == blank
            assign text = text_key | t
          endif
        -%}
        <li class="m-promise m-tone--{{ tone }}" {{ block.shopify_attributes }}>
          <h3 class="m-promise__title">{{ title }}</h3>
          <p class="m-promise__text">{{ text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .m-promises {
    padding-block: clamp(48px, 7vw, 112px);
    background: var(--m-plum);
    color: var(--m-pearl);
  }

  .m-promises__title {
    margin: 0 0 clamp(24px, 3vw, 40px);
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
  }

  .m-promises__draft {
    margin: -16px 0 24px;
    padding: 6px 10px;
    border: 1px dashed var(--m-accent-on-dark);
    color: var(--m-accent-on-dark);
    font-size: 0.75rem;
    inline-size: fit-content;
  }

  .m-promises__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-promise {
    display: grid;
    align-content: end;
    gap: 8px;
    min-block-size: 240px;
    padding: clamp(24px, 3vw, 40px);
    background: var(--tile-bg);
    color: var(--tile-ink);
  }

  .m-promise__title {
    margin: 0;
    max-inline-size: 14ch;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.1;
  }

  .m-promise__text {
    margin: 0;
    max-inline-size: 32ch;
    font-size: 1rem;
    line-height: 1.5;
  }

  html[lang='ar'] .m-promises__title,
  html[lang='ar'] .m-promise__title {
    line-height: 1.35;
  }

  html[lang='ar'] .m-promise__text {
    line-height: 1.7;
  }

  @media screen and (min-width: 750px) {
    .m-promises__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS promises",
  "limit": 1,
  "settings": [{ "type": "text", "id": "heading", "label": "Heading" }],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the translated default." },
        { "type": "text", "id": "text", "label": "Line" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "MOMENTS promises" }]
}
{% endschema %}
