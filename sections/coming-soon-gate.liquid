{%- comment -%}
  Switch for a "coming soon" page. While "Line has launched" is off it renders nothing
  for shoppers. Once the merchant turns it on and picks a collection, visitors of the
  page are sent to that collection, so the menu link never has to change.

  Usage: add it at the top of a coming soon page template, above the signup section.
{%- endcomment -%}

{%- liquid
  assign target = section.settings.collection
  assign is_live = false
  if section.settings.launched and target != blank
    assign is_live = true
  endif
-%}

{%- if is_live -%}
  <div class="coming-soon-gate">
    <a href="{{ target.url }}">{{ 'sections.coming_soon_gate.open_collection' | t: title: target.title }}</a>
  </div>
  <script>
    window.location.replace({{ target.url | json }});
  </script>
{%- elsif request.design_mode -%}
  <div class="coming-soon-gate coming-soon-gate--hint">
    {{ 'sections.coming_soon_gate.editor_hint' | t }}
  </div>
{%- endif -%}

{% stylesheet %}
  .coming-soon-gate {
    padding-block: var(--padding-md, 16px);
    padding-inline: var(--padding-lg, 24px);
    text-align: center;
  }

  .coming-soon-gate--hint {
    font-size: var(--font-size--sm, 0.875rem);
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.coming_soon_gate",
  "settings": [
    {
      "type": "checkbox",
      "id": "launched",
      "label": "t:settings.launched",
      "info": "t:info.coming_soon_launched",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.launch_collection"
    }
  ]
}
{% endschema %}
