{%- comment -%}
  Gift a Moment: a rounded colour card in the content column (not a full-bleed band, so it sits on the pearl page like every other card).
  Left: the tag, a one-line headline, one real line and one button. Right: up to three real gift sets from the Gifts collection as uncropped
  packshots (object-fit contain) on the card-frame token, staggered in height and slightly overlapping with a soft shadow, and the redrawn
  Gift mark as a small accent.
  Which sets show: the "Gift set" blocks if the owner picked products (best, because some photos in the collection are lifestyle shots, and
  the gift bags carry another vendor's name); otherwise the available products of the Gifts collection whose type is "Gift Set".
  With fewer than two valid packshots the card shows the mark large with a ribbon motif instead of a lone icon.
{%- endcomment -%}

{%- liquid
  assign shown = 0
  assign handles = ''
  for block in section.blocks
    if block.type == 'gift_set' and block.settings.product != blank and block.settings.product.featured_image != blank
      assign handles = handles | append: block.settings.product.handle | append: ','
      assign shown = shown | plus: 1
    endif
  endfor
  if shown == 0
    assign target = section.settings.collection
    if target == blank
      assign target = collections['gift-moment']
    endif
    for product in target.products
      if product.type == 'Gift Set' and product.available and product.featured_image != blank and shown < 3
        assign handles = handles | append: product.handle | append: ','
        assign shown = shown | plus: 1
      endif
    endfor
  endif
  assign gift_handles = handles | split: ','
  assign has_sets = false
  if gift_handles.size >= 2
    assign has_sets = true
  endif
  assign target_link = section.settings.collection
-%}

<section class="m-gift m-tone--gift" aria-labelledby="m-gift-title-{{ section.id }}">
  <div class="m-wrap">
    <div class="m-gift__card">
      <div class="m-gift__copy">
        <p class="m-gift__tag">{{ 'moments.gift' | t }}</p>
        <h2 class="m-gift__title" id="m-gift-title-{{ section.id }}">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ 'homepage.gift.heading' | t }}
          {%- endif -%}
        </h2>
        <p class="m-gift__text">
          {%- if section.settings.text != blank -%}
            {{ section.settings.text }}
          {%- else -%}
            {{ 'homepage.gift.text' | t }}
          {%- endif -%}
        </p>
        <a class="m-btn m-btn--outline" href="{{ target_link.url | default: routes.collections_url }}">{{ 'homepage.gift.cta' | t }}</a>
      </div>

      <div class="m-gift__art{% if has_sets %} m-gift__art--sets{% endif %}" aria-hidden="true" data-moment-host>
        {%- if has_sets -%}
          <ul class="m-gift__sets" role="list">
            {%- for handle in gift_handles limit: 3 -%}
              {%- assign gift_product = all_products[handle] -%}
              <li class="m-gift__set">
                <span class="m-gift__frame">
                  {{
                    gift_product.featured_image
                    | image_url: width: 480
                    | image_tag: class: 'm-gift__packshot', alt: '', loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 990px) 16vw, 28vw'
                  }}
                </span>
              </li>
            {%- endfor -%}
          </ul>
          <span class="m-gift__accent">{% render 'moment-mark', mark: 'gift', size: 'sm' %}</span>
        {%- else -%}
          <span class="m-gift__ribbon" aria-hidden="true"></span>
          <span class="m-gift__hero-mark">{% render 'moment-mark', mark: 'gift', size: 'lg' %}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .m-gift {
    padding-block: var(--m-space-m);
    background: var(--m-surface);
  }

  .m-gift__card {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 4.5vw, 56px);
    border-radius: var(--m-radius-card);
    background: var(--tile-bg);
    color: var(--tile-ink);
    overflow: clip;
  }

  .m-gift__copy {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .m-gift__tag {
    margin: 0;
    padding: 6px 14px;
    border: 1px solid currentcolor;
    border-radius: 9999px;
    font-size: 0.8125rem;
    line-height: 1;
  }

  .m-gift__title {
    margin: 0;
    font-size: var(--m-h2);
    line-height: 1.02;
    text-wrap: balance;
  }

  .m-gift__text {
    margin: 0;
    max-inline-size: 38ch;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  html[lang='ar'] .m-gift__title {
    line-height: 1.3;
  }

  html[lang='ar'] .m-gift__text {
    line-height: 1.75;
  }

  /* the packshots: contained, never cropped, staggered and overlapping, soft shadow */
  .m-gift__art {
    position: relative;
    display: grid;
    justify-items: center;
    align-items: center;
  }

  .m-gift__sets {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    inline-size: 100%;
  }

  .m-gift__set {
    flex: 0 1 31%;
    min-inline-size: 0;
    max-inline-size: 190px;
  }

  .m-gift__set + .m-gift__set {
    margin-inline-start: -4%;
  }

  .m-gift__set:nth-child(1) { transform: translateY(14px); }
  .m-gift__set:nth-child(2) { position: relative; z-index: 1; transform: translateY(-14px); }
  .m-gift__set:nth-child(3) { transform: translateY(22px); }

  .m-gift__frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 8%;
    border-radius: 14px;
    background: var(--m-card-frame);
    box-shadow: 0 18px 30px -16px rgb(37 18 36 / 0.55);
  }

  .m-gift__packshot {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: brightness(1.07);
  }

  .m-gift__accent {
    position: absolute;
    inset-block-start: -6px;
    inset-inline-end: 0;
    z-index: 2;
  }

  .m-gift__accent moment-mark {
    --mm-size: 56px;
  }

  @media screen and (max-width: 989px) {
    .m-gift__art--sets {
      padding-block-start: 52px;
    }

    .m-gift__accent {
      inset-inline-start: 0;
      inset-inline-end: auto;
    }
  }

  /* fewer than two real packshots: the mark, large, on a ribbon, never a lone icon */
  .m-gift__ribbon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline: -12%;
    block-size: 34px;
    transform: translateY(-50%) rotate(-8deg);
    background: color-mix(in srgb, var(--tile-ink) 16%, transparent);
    border-block: 1px solid color-mix(in srgb, var(--tile-ink) 40%, transparent);
  }

  .m-gift__hero-mark moment-mark {
    --mm-size: min(46vw, 230px);
  }

  @media screen and (min-width: 990px) {
    .m-gift__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 48px;
      min-block-size: 360px;
    }

    .m-gift__set { max-inline-size: 220px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .m-gift__set {
      transition: transform var(--m-dur-3) var(--m-ease);
    }

    @media (hover: hover) {
      .m-gift__card:hover .m-gift__set:nth-child(1) { transform: translateY(8px); }
      .m-gift__card:hover .m-gift__set:nth-child(2) { transform: translateY(-20px); }
      .m-gift__card:hover .m-gift__set:nth-child(3) { transform: translateY(16px); }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS gift block",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Gift collection" }
  ],
  "blocks": [
    {
      "type": "gift_set",
      "name": "Gift set",
      "limit": 3,
      "settings": [
        { "type": "product", "id": "product", "label": "Gift set", "info": "Pick products with a clean packshot. Leave all three empty to use the gift sets of the collection automatically." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "MOMENTS gift block" }]
}
{% endschema %}
