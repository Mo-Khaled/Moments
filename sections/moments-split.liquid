{%- comment -%}
  Reusable split: text on one side, image on the other, up to three plain feature badges and one button.
  Used for "What we sell". With no image it shows a moment colour field with the large mark (never an empty box, never a
  cropped stock photo). An image, when set, is shown uncropped (object-fit contain on the tone field).
  The badges are small outlined labels, not an icon-title-text row.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'about.sell.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'about.sell.text' | t
  endif
  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'about.sell.cta' | t
  endif
-%}

<section class="m-split{% if section.settings.reverse %} m-split--reverse{% endif %}" aria-labelledby="m-split-title-{{ section.id }}">
  <div class="m-split__inner m-wrap">
    <div class="m-split__copy">
      <h2 class="m-split__title" id="m-split-title-{{ section.id }}">{{ heading }}</h2>
      <p class="m-split__text">{{ text }}</p>
      <ul class="m-split__badges">
        {%- for block in section.blocks -%}
          {%- assign badge_key = 'about.sell.badge_' | append: forloop.index -%}
          <li {{ block.shopify_attributes }}>{% if block.settings.text != blank %}{{ block.settings.text }}{% else %}{{ badge_key | t }}{% endif %}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.cta_url != blank -%}
        <a class="m-btn" href="{{ section.settings.cta_url }}">{{ cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="m-split__media m-tone--{{ section.settings.tone }}" data-moment-host>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'm-split__image', alt: section.settings.image_alt, loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw' }}
      {%- else -%}
        <div class="m-split__art" aria-hidden="true">{% render 'moment-mark', mark: section.settings.tone, size: 'lg' %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .m-split {
    padding-block: clamp(48px, 7vw, 112px);
    background: var(--m-surface);
    color: var(--m-text);
  }

  .m-split__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  .m-split__copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .m-split__title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .m-split__text {
    margin: 0;
    max-inline-size: 46ch;
    color: var(--m-text-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .m-split__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-split__badges:empty {
    display: none;
  }

  .m-split__badges li {
    padding: 8px 14px;
    border: 1px solid var(--m-badge-ink);
    color: var(--m-badge-ink);
    font-size: 0.8125rem;
    line-height: 1;
  }

  .m-split__media {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    background: var(--tile-bg);
  }

  .m-split__art moment-mark {
    --mm-size: min(60vw, 320px);
  }

  .m-split__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  html[lang='ar'] .m-split__title {
    line-height: 1.3;
  }

  html[lang='ar'] .m-split__text {
    line-height: 1.75;
  }

  @media screen and (min-width: 990px) {
    .m-split__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 96px;
    }

    .m-split--reverse .m-split__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS split",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image first", "default": false },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour and mark",
      "options": [
        { "value": "night", "label": "Night" },
        { "value": "gift", "label": "Gift" },
        { "value": "allday", "label": "All day" },
        { "value": "daily", "label": "Daily" },
        { "value": "fresh", "label": "Fresh" },
        { "value": "love", "label": "Love" }
      ],
      "default": "allday"
    },
    { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Shown uncropped. TODO: a real photograph, once one exists." },
    { "type": "text", "id": "image_alt", "label": "Image description" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature badge",
      "limit": 3,
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "MOMENTS split" }]
}
{% endschema %}
