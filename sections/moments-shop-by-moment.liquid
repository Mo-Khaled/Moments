{%- comment -%}
  The six Moment tiles, shared by the homepage and /pages/moments. One tile component (snippets/moment-tile.liquid),
  one strict grid: 3 x 2 on desktop, 2 x 3 on tablet, 2 columns on phones. Six tiles always fill it, so there is
  never an orphan cell. Tiles are colour fields with the large Moment mark. They never hold a cropped photograph.
  Photography for moments can be added later as a separate, uncropped treatment once normalised images exist.
{%- endcomment -%}

{%- liquid
  assign tag = section.settings.heading_level | default: 'h2'
  assign tile_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign tile_count = tile_count | plus: 1
    endif
  endfor
-%}

<section class="m-moments" aria-labelledby="m-moments-title-{{ section.id }}">
  <div class="m-wrap">
    <header class="m-moments__head">
      <{{ tag }} class="m-moments__title" id="m-moments-title-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'homepage.moments.heading' | t }}
        {%- endif -%}
      </{{ tag }}>
      <p class="m-moments__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          {{ 'homepage.moments.text' | t }}
        {%- endif -%}
      </p>
      {%- if section.settings.show_count -%}
        <p class="m-moments__total">{{ 'homepage.moments.total' | t: count: tile_count }}</p>
      {%- endif -%}
    </header>

    <ul class="m-moments__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <li class="m-tile-item" {{ block.shopify_attributes }}>
            {% render 'moment-tile', collection: block.settings.collection, mark: block.settings.mark, label: block.settings.label, packshot: block.settings.packshot %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .m-moments {
    padding-block: var(--m-space-l);
    background: var(--m-plum);
    color: var(--m-text-on-dark);
  }

  .m-moments__head {
    display: grid;
    gap: 8px;
    margin-block-end: clamp(24px, 3vw, 40px);
  }

  .m-moments__title {
    margin: 0;
    color: var(--m-pearl);
    font-size: var(--m-h2);
    line-height: 1;
  }

  .m-moments__text {
    margin: 0;
    max-inline-size: 48ch;
    color: var(--m-nude);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .m-moments__total {
    margin: 0;
    color: var(--m-nude);
    font-size: 0.875rem;
  }

  html[lang='ar'] .m-moments__title {
    line-height: 1.35;
  }

  html[lang='ar'] .m-moments__text {
    line-height: 1.7;
  }

  .m-moments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .m-moments__grid {
      gap: 12px;
    }
  }

  @media screen and (min-width: 990px) {
    .m-moments__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS shop by moment",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use H1 when the section is the main heading of a page.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" }
      ],
      "default": "h2"
    },
    { "type": "textarea", "id": "text", "label": "Intro line" },
    { "type": "checkbox", "id": "show_count", "label": "Show the number of moments", "default": false }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment tile",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "select",
          "id": "mark",
          "label": "Moment mark and colour",
          "options": [
            { "value": "night", "label": "Evening out" },
            { "value": "gift", "label": "Gift" },
            { "value": "allday", "label": "All day" },
            { "value": "daily", "label": "Office (briefcase)" },
            { "value": "fresh", "label": "Summer heat" },
            { "value": "love", "label": "Date night" },
            { "value": "occasions", "label": "Weddings & Eid" },
            { "value": "winter", "label": "Winter nights" }
          ],
          "default": "night"
        },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave empty to use the moment name." },
        {
          "type": "image_picker",
          "id": "packshot",
          "label": "Bottle packshot (optional)",
          "info": "A normalised, uncropped packshot of a real best seller of this moment (for example 9 PM for Night). Leave empty until such an image exists."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "MOMENTS shop by moment",
      "blocks": [
        { "type": "moment", "settings": { "mark": "night" } },
        { "type": "moment", "settings": { "mark": "gift" } },
        { "type": "moment", "settings": { "mark": "allday" } },
        { "type": "moment", "settings": { "mark": "daily" } },
        { "type": "moment", "settings": { "mark": "fresh" } },
        { "type": "moment", "settings": { "mark": "love" } }
      ]
    }
  ]
}
{% endschema %}
