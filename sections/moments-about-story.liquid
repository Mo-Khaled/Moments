{%- comment -%}
  About v2, part 1: the story card. A headline in two weights ("Our story behind **MOMENTS.**", the accent word in berry), a subline, and a
  large rounded video block. With a looping video set it plays muted with a pause control; with a long story video set, a "Play our story"
  pill opens it in an accessible dialog. With neither, the block is a moment colour field with the large mark (never an empty box).
  The "inside look" headline is a TODO until real footage exists. All copy is DRAFT for owner approval (label shown in the editor only).
  The experimental hero video (docs/assets/image-credits.md) may be used in the looping slot.
{%- endcomment -%}

{%- liquid
  assign video = section.settings.video
  assign story = section.settings.story_video
  assign poster = section.settings.poster
-%}

<section class="m-astory" aria-labelledby="m-astory-title-{{ section.id }}">
  <div class="m-wrap m-astory__inner">
    {%- if request.design_mode -%}<p class="m-draft">{{ 'about2.draft' | t }}</p>{%- endif -%}
    <h1 class="m-astory__title" id="m-astory-title-{{ section.id }}">{{ 'about2.story_light' | t }} <span class="m-accent">{{ 'about2.story_accent' | t }}</span></h1>
    <p class="m-astory__sub">{{ 'about2.story_sub' | t }}</p>

    <div class="m-astory__media m-tone--night">
      {%- if poster != blank -%}
        {{ poster | image_url: width: 1800 | image_tag: class: 'm-astory__poster', alt: '', widths: '768, 1280, 1800', sizes: '(min-width: 990px) 1200px, 100vw', loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        <div class="m-astory__art" aria-hidden="true">{% render 'moment-mark', mark: 'night', size: 'lg' %}</div>
      {%- endif -%}
      {%- if video != blank -%}
        <video class="m-astory__video" muted loop playsinline preload="none" tabindex="-1" data-m-astory-video data-src="{% for source in video.sources %}{% if source.format == 'mp4' %}{{ source.url }}{% endif %}{% endfor %}"></video>
        <button class="m-astory__pause" type="button" data-m-astory-pause hidden aria-label="{{ 'about2.pause' | t }}" data-pause="{{ 'about2.pause' | t }}" data-play="{{ 'about2.play_loop' | t }}">II</button>
      {%- endif -%}
      {%- if story != blank -%}
        <button class="m-astory__play m-btn m-btn--outline" type="button" data-m-astory-open>{{ 'about2.play' | t }}</button>
      {%- endif -%}
    </div>
    {%- if request.design_mode and video == blank -%}
      <p class="m-draft">{{ 'about2.inside_todo' | t }}</p>
    {%- endif -%}
  </div>

  {%- if story != blank -%}
    <dialog class="m-adialog" data-m-astory-dialog aria-label="{{ 'about2.play' | t }}">
      <button class="m-adialog__close" type="button" data-m-astory-close aria-label="{{ 'about2.close' | t }}">&times;</button>
      <video controls playsinline preload="none" data-src="{% for source in story.sources %}{% if source.format == 'mp4' %}{{ source.url }}{% endif %}{% endfor %}"></video>
    </dialog>
  {%- endif -%}
</section>

{% stylesheet %}
  .m-astory {
    padding-block: var(--m-space-m);
    background: var(--m-surface);
    color: var(--m-text);
  }

  .m-astory__inner {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .m-astory__title {
    margin: 0;
    max-inline-size: 14ch;
    font-size: var(--m-h1);
    line-height: 1;
    text-wrap: balance;
  }

  .m-astory__sub {
    margin: 0 0 16px;
    font-size: clamp(1.0625rem, 1.6vw, 1.375rem);
    color: var(--m-text-muted);
  }

  .m-astory__media {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    position: relative;
    isolation: isolate;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    max-block-size: 70svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 28px;
    background: var(--tile-bg);
  }

  .m-astory__poster,
  .m-astory__video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .m-astory__video {
    opacity: 0;
    transition: opacity var(--m-dur-3) var(--m-ease);
  }

  .m-astory__video[data-playing] {
    opacity: 1;
  }

  .m-astory__art moment-mark {
    --mm-size: min(46vw, 360px);
  }

  .m-astory__play {
    position: absolute;
    inset-block-end: 20px;
    inset-inline-start: 20px;
  }

  .m-astory__pause {
    position: absolute;
    inset-block-end: 20px;
    inset-inline-end: 20px;
    inline-size: 44px;
    block-size: 44px;
    border: 1px solid var(--m-pearl);
    border-radius: 9999px;
    background: rgb(37 18 36 / 0.55);
    color: var(--m-pearl);
    font-size: 0.75rem;
    letter-spacing: 2px;
    cursor: pointer;
  }

  .m-adialog {
    inline-size: min(92vw, 1100px);
    padding: 0;
    border: 0;
    background: var(--m-plum-900);
  }

  .m-adialog::backdrop {
    background: rgb(37 18 36 / 0.8);
  }

  .m-adialog video {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .m-adialog__close {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
    z-index: 1;
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    border-radius: 9999px;
    background: var(--m-pearl);
    color: var(--m-plum);
    font-size: 1.5rem;
    cursor: pointer;
  }

  html[lang='ar'] .m-astory__title {
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-astory__video {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const video = document.querySelector('[data-m-astory-video]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = !!(navigator.connection && navigator.connection.saveData);
    const pause = document.querySelector('[data-m-astory-pause]');
    if (video && video.dataset.src && !reduced && !saveData && window.matchMedia('(min-width: 750px)').matches && 'IntersectionObserver' in window) {
      let paused = false;
      new IntersectionObserver((entries, obs) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        video.src = video.dataset.src;
        video.play().then(() => { video.setAttribute('data-playing', ''); if (pause) pause.hidden = false; }).catch(() => {});
      }).observe(video);
      document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); else if (video.src && !paused) video.play().catch(() => {}); });
      if (pause) pause.addEventListener('click', () => {
        paused = !paused;
        if (paused) video.pause(); else video.play().catch(() => {});
        pause.setAttribute('aria-label', paused ? pause.dataset.play : pause.dataset.pause);
      });
    }
    const dialog = document.querySelector('[data-m-astory-dialog]');
    const open = document.querySelector('[data-m-astory-open]');
    if (dialog && open) {
      const player = dialog.querySelector('video');
      open.addEventListener('click', () => { player.src = player.dataset.src; dialog.showModal(); player.play().catch(() => {}); });
      dialog.querySelector('[data-m-astory-close]').addEventListener('click', () => { player.pause(); dialog.close(); open.focus(); });
      dialog.addEventListener('cancel', () => player.pause());
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "MOMENTS about story",
  "limit": 1,
  "settings": [
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Optional. Shown first." },
    { "type": "video", "id": "video", "label": "Looping video", "info": "Muted, 6 to 12 seconds, under 4 MB. The experimental hero loop may be used here. Desktop only, after the poster." },
    { "type": "video", "id": "story_video", "label": "Story video", "info": "The long video for Play our story. The pill stays hidden until one is set. TODO: owner." }
  ],
  "presets": [{ "name": "MOMENTS about story" }]
}
{% endschema %}
