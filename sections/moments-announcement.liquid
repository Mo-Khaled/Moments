{%- comment -%}
  Announcement bar: a slim rounded bar with ONE message visible at a time (clutter budget).
  Style "rotate" (default): up to three messages take turns every few seconds with a short vertical slide and fade
  (CSS only, transform and opacity, paused on hover and focus, no arrows, no dots). Style "marquee": the same messages in the
  continuous ticker. Reduced motion: the first message, static. Screen readers get one plain list (aria-live is off) and the
  animated copy is aria-hidden.
  Messages are blocks: "Original and sealed", "Cash on delivery", "Free shipping" (the amount comes from the theme setting
  "Free shipping above") or a custom line. The returns policy link lives in the footer, not here.
{%- endcomment -%}

{%- liquid
  assign threshold = settings.moments_free_shipping | times: 100 | money_without_trailing_zeros
  assign interval = section.settings.interval | at_least: 3
  assign speed = section.settings.speed | at_least: 10
  assign count = section.blocks.size | at_most: 3
-%}

{%- capture messages -%}
  {%- for block in section.blocks limit: 3 -%}
    {%- liquid
      assign msg = ''
      case block.settings.kind
        when 'original'
          assign msg = 'homepage.pillars.original_title' | t
        when 'cod'
          assign msg = 'homepage.pillars.cod_title' | t
        when 'shipping'
          assign msg = 'homepage.ticker.shipping' | t: amount: threshold
        else
          assign msg = block.settings.text
      endcase
    -%}
    {%- if msg != blank -%}
      <li class="m-announce__msg" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if block.settings.url != blank and block.settings.kind == 'custom' -%}
          <a href="{{ block.settings.url }}">{{ msg }}</a>
        {%- else -%}
          <span>{{ msg }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<aside class="m-announce" aria-label="MOMENTS">
  {%- if section.settings.style == 'marquee' -%}
    {%- liquid
      assign chars = 0
      for block in section.blocks limit: 3
        assign chars = chars | plus: 24
      endfor
      assign group_width = chars | times: 9 | plus: 96 | times: 6
      assign duration = group_width | divided_by: speed | at_least: 20
    -%}
    {%- capture ticker_items -%}
      {{ messages | replace: 'class="m-announce__msg"', 'class="m-ticker__item"' }}
    {%- endcapture -%}
    <div class="m-announce__ticker">
      {% render 'moments-ticker', items: ticker_items, duration: duration, mode: 'single', copies: 6, label: 'MOMENTS' %}
    </div>
  {%- else -%}
    <div class="m-announce__bar m-announce__bar--n{{ count }}" style="--m-rot-interval: {{ interval }}s; --n: {{ count }}">
      <ul class="m-sr-only">{{ messages }}</ul>
      <ul class="m-announce__stage" aria-hidden="true">{{ messages }}</ul>
    </div>
  {%- endif -%}
</aside>

{% stylesheet %}
  .m-announce {
    background: var(--m-plum);
    color: var(--m-text-on-dark);
  }

  .m-announce__bar,
  .m-announce__ticker {
    position: relative;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .m-announce__bar {
    block-size: 32px;
  }

  .m-announce__ticker .m-ticker {
    block-size: 32px;
  }

  .m-announce__ticker .m-ticker__track,
  .m-announce__ticker .m-ticker__group,
  .m-announce__ticker .m-ticker__list {
    block-size: 100%;
    align-items: center;
  }

  /* messages run left to right like the brand strip, each followed by the brand's four-point sparkle in nude */
  .m-announce__ticker .m-ticker__item {
    display: flex;
    align-items: center;
    padding-inline: 0;
    white-space: nowrap;
  }

  .m-announce__ticker .m-ticker__item::after {
    content: '';
    flex: none;
    inline-size: 9px;
    block-size: 9px;
    margin-inline: 36px;
    background: var(--m-nude);
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
  }

  .m-announce__stage {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .m-announce__msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    list-style: none;
    white-space: nowrap;
    animation: m-announce-rotate-3 calc(var(--n) * var(--m-rot-interval)) infinite;
    animation-delay: calc(var(--i) * var(--m-rot-interval));
  }

  .m-announce__msg a {
    color: inherit;
    text-decoration: none;
  }

  /* the rotating copy is decoration for sighted visitors (the stage ignores the pointer); links work in the ticker style */
  .m-announce__msg a:hover,
  .m-announce__msg a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .m-announce__bar:hover .m-announce__msg,
  .m-announce__bar:focus-within .m-announce__msg {
    animation-play-state: paused;
  }

  /* One message only: it never rotates. Two keyframe sets for 2 and 3 messages, because each owns 1/n of the loop. */
  .m-announce__bar--n1 .m-announce__msg {
    opacity: 1;
    animation: none;
  }

  .m-announce__bar--n2 .m-announce__msg {
    animation-name: m-announce-rotate-2;
  }

  /* Opacity and transform only. These keyframes used to switch `visibility` too, which cannot run on the compositor: the page recalculated styles
     about 145 times a second, forever, on every page (22% of the main thread while idle). The rotating copy is aria-hidden and the real text is in
     the screen-reader list, so a faded-out message needs no visibility change. */
  @keyframes m-announce-rotate-2 {
    0% { opacity: 0; transform: translateY(10px); }
    5% { opacity: 1; transform: translateY(0); }
    45% { opacity: 1; transform: translateY(0); }
    50% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 0; transform: translateY(-10px); }
  }

  @keyframes m-announce-rotate-3 {
    0% { opacity: 0; transform: translateY(10px); }
    3.5% { opacity: 1; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(0); }
    33.3% { opacity: 0; transform: translateY(-10px); }
    100% { opacity: 0; transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-announce__msg {
      animation: none;
    }

    .m-announce__stage .m-announce__msg:first-child {
      opacity: 1;
    }
  }

  html[lang='ar'] .m-announce__bar,
  html[lang='ar'] .m-announce__ticker {
    letter-spacing: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS announcement",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "rotate", "label": "Rotate, one at a time" },
        { "value": "marquee", "label": "Marquee ticker" }
      ],
      "default": "rotate"
    },
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 3, "max": 8, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "speed", "label": "Marquee speed", "info": "Pixels per second.", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "Message",
          "options": [
            { "value": "original", "label": "100% original, sealed" },
            { "value": "cod", "label": "Cash on delivery" },
            { "value": "shipping", "label": "Free shipping over (theme amount)" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "original"
        },
        { "type": "text", "id": "text", "label": "Custom text", "visible_if": "{{ block.settings.kind == 'custom' }}" },
        { "type": "url", "id": "url", "label": "Custom link", "visible_if": "{{ block.settings.kind == 'custom' }}" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "MOMENTS announcement",
      "blocks": [
        { "type": "message", "settings": { "kind": "original" } },
        { "type": "message", "settings": { "kind": "cod" } },
        { "type": "message", "settings": { "kind": "shipping" } }
      ]
    }
  ]
}
{% endschema %}
