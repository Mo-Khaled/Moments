{%- comment -%}
  Trust strip for the About page: only true facts, each linking to its policy page when there is one.
  Facts: 100% original and sealed, cash on delivery, free shipping above the theme amount, the returns and exchange policy.
  No invented exchange policy: the returns item links to the existing page and says nothing about its terms.
  The links are settings; an item with no link is plain text.
{%- endcomment -%}

{%- liquid
  assign threshold = settings.moments_free_shipping | times: 100 | money_without_trailing_zeros
  assign shipping_url = section.settings.shipping_url
  if shipping_url == blank and shop.shipping_policy.body != blank
    assign shipping_url = shop.shipping_policy.url
  endif
-%}

<section class="m-trust" aria-label="{{ 'homepage.pillars.original_title' | t }}">
  <ul class="m-trust__list m-wrap">
    <li><p>{{ 'homepage.pillars.original_title' | t }}</p></li>
    <li>
      {%- if section.settings.cod_url != blank -%}
        <p><a href="{{ section.settings.cod_url }}">{{ 'homepage.pillars.cod_title' | t }}</a></p>
      {%- else -%}
        <p>{{ 'homepage.pillars.cod_title' | t }}</p>
      {%- endif -%}
    </li>
    <li>
      {%- if shipping_url != blank -%}
        <p><a href="{{ shipping_url }}">{{ 'homepage.ticker.shipping' | t: amount: threshold }}</a></p>
      {%- else -%}
        <p>{{ 'homepage.ticker.shipping' | t: amount: threshold }}</p>
      {%- endif -%}
    </li>
    <li>
      {%- if section.settings.returns_url != blank -%}
        <p><a href="{{ section.settings.returns_url }}">{{ 'homepage.pillars.returns_title' | t }}</a></p>
      {%- else -%}
        <p>{{ 'homepage.pillars.returns_title' | t }}</p>
      {%- endif -%}
    </li>
  </ul>
</section>

{% stylesheet %}
  .m-trust {
    background: var(--m-nude);
    color: var(--m-plum);
  }

  .m-trust__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }

  .m-trust__list li {
    padding-block: 20px;
    padding-inline-end: 16px;
  }

  .m-trust__list p {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .m-trust__list a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  @media screen and (min-width: 990px) {
    .m-trust__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .m-trust__list li {
      padding-block: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS trust strip",
  "limit": 1,
  "settings": [
    { "type": "url", "id": "cod_url", "label": "Cash on delivery link", "info": "Optional." },
    { "type": "url", "id": "shipping_url", "label": "Shipping policy link", "info": "Optional. Falls back to the store's shipping policy when it has content." },
    { "type": "url", "id": "returns_url", "label": "Returns and exchange policy page" }
  ],
  "presets": [{ "name": "MOMENTS trust strip" }]
}
{% endschema %}
