{%- comment -%}
  Used by templates/page.page.json, the template of the pages whose template suffix is "page" (the Brands page and a placeholder Home Page page). It renders the grid only on /pages/brands; other pages show their normal page content.
  The Brands page: every brand collection as a rounded card in an A to Z grid. Each card shows the brand's logo (plum, from assets/brand-<handle>.png when the file
  exists) or the brand name in the display type, the number of bottles, and an arrow. Same card edge, radius and 4px hover lift as the product cards.
  The brands are the collections picked in the section settings (the same list the old page used); nothing here edits store data.
{%- endcomment -%}

{%- liquid
  assign logo_handles = 'afnan,khadlaj,lattafa,faan,assaf,rasasi-perfumes,laverne,nabeel-perfumes,ibraq,le-falcone,lattafa-pride,armaf,zimaya,dkhoon-emirates' | split: ','
  assign brands = section.settings.collection_list | sort: 'title'
-%}

{%- if page.handle == 'brands' or request.design_mode -%}
<section class="m-bidx" aria-labelledby="m-bidx-title-{{ section.id }}">
  <div class="m-wrap">
    <header class="m-bidx__head">
      <h1 class="m-bidx__title" id="m-bidx-title-{{ section.id }}">{%- if page.title != blank -%}{{ page.title }}{%- else -%}{{ 'brands_index.title' | t }}{%- endif -%}</h1>
      <p class="m-bidx__text">
        {%- if section.settings.text != blank -%}{{ section.settings.text }}{%- else -%}{{ 'brands_index.text' | t }}{%- endif -%}
      </p>
      <p class="m-bidx__count">{{ 'brands_index.count' | t: count: brands.size }}</p>
    </header>

    <ul class="m-bidx__grid" role="list">
      {%- for brand in brands -%}
        <li class="m-bidx__item">
          <a class="m-bidx__card" href="{{ brand.url }}">
            <span class="m-bidx__logo">
              {%- if logo_handles contains brand.handle -%}
                {%- assign logo_file = 'brand-' | append: brand.handle | append: '.png' -%}
                <img src="{{ logo_file | asset_url }}" alt="{{ brand.title | escape }}" width="160" height="40" loading="{% if forloop.index > 8 %}lazy{% else %}eager{% endif %}" decoding="async">
              {%- else -%}
                <span class="m-bidx__name">{{ brand.title }}</span>
              {%- endif -%}
            </span>
            <span class="m-bidx__meta">
              <span>{{ 'brands_index.products' | t: count: brand.products_count }}</span>
              <span class="m-bidx__go" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M10.5 5l5 5-5 5"/></svg></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .m-bidx {
    padding-block: clamp(32px, 5vw, 72px) clamp(48px, 7vw, 112px);
  }

  .m-bidx__head {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-block-end: clamp(24px, 4vw, 48px);
  }

  .m-bidx__title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .m-bidx__text {
    margin: 0;
    max-inline-size: 52ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--m-text-muted);
    text-wrap: pretty;
  }

  .m-bidx__count {
    margin: 0;
    padding: 6px 14px;
    border: 1px solid var(--m-card-border);
    border-radius: 9999px;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--m-text-muted);
  }

  .m-bidx__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .m-bidx__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }

  @media screen and (min-width: 1100px) {
    .m-bidx__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .m-bidx__card {
    display: grid;
    grid-template-rows: 1fr auto;
    block-size: 100%;
    min-block-size: 168px;
    border: 1px solid var(--m-card-border);
    border-radius: var(--m-radius-card);
    background: var(--m-card-surface);
    color: var(--m-plum);
    text-decoration: none;
    overflow: clip;
    transition: transform var(--m-dur-2) var(--m-ease), border-color var(--m-dur-2) var(--m-ease), box-shadow var(--m-dur-2) var(--m-ease);
    -webkit-tap-highlight-color: transparent;
  }

  .m-bidx__logo {
    display: grid;
    place-items: center;
    padding: 28px 20px 12px;
    background: var(--m-card-frame);
  }

  .m-bidx__logo img {
    display: block;
    inline-size: auto;
    max-inline-size: min(100%, 160px);
    block-size: 40px;
    object-fit: contain;
    /* the logo files are pearl on transparent: shown in plum on the card */
    filter: brightness(0) saturate(100%) invert(12%) sepia(23%) saturate(1432%) hue-rotate(264deg) brightness(92%);
  }

  .m-bidx__name {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }

  html[lang='ar'] .m-bidx__name {
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.4;
  }

  .m-bidx__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px 12px 16px;
    border-block-start: 1px solid var(--m-card-border);
    font-size: 0.875rem;
    color: var(--m-text-muted);
  }

  html[dir='rtl'] .m-bidx__meta {
    padding: 12px 16px 12px 14px;
  }

  .m-bidx__go {
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border: 1px solid var(--m-card-border);
    border-radius: 9999px;
    color: var(--m-plum);
    transition: transform var(--m-dur-2) var(--m-ease), background-color var(--m-dur-2) var(--m-ease), color var(--m-dur-2) var(--m-ease);
  }

  html[dir='rtl'] .m-bidx__go svg {
    transform: scaleX(-1);
  }

  .m-bidx__card:focus-visible {
    outline: 2px solid var(--m-berry);
    outline-offset: 2px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .m-bidx__card:hover {
      transform: translateY(-4px);
      border-color: var(--m-card-border-strong);
      box-shadow: 0 14px 24px -16px rgb(59 30 58 / 0.35);
    }

    .m-bidx__card:hover .m-bidx__go {
      transform: translateX(3px);
      background: var(--m-plum);
      color: var(--m-pearl);
    }

    html[dir='rtl'] .m-bidx__card:hover .m-bidx__go {
      transform: translateX(-3px);
    }
  }

  @media (forced-colors: active) {
    .m-bidx__card { border-color: CanvasText; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS brands index",
  "limit": 1,
  "settings": [
    { "type": "textarea", "id": "text", "label": "Intro line", "info": "Leave empty to use the default line." },
    { "type": "collection_list", "id": "collection_list", "label": "Brands", "info": "The brand collections shown, sorted A to Z.", "limit": 40 }
  ],
  "presets": [{ "name": "MOMENTS brands index" }]
}
{% endschema %}
