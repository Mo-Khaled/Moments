{%- comment -%}
  Wishlist page. With Wishlist Guru active it opens the app's list (signed-in visitors; signed-out ones are sent to sign in first by the header heart).
  Without the app it shows "coming soon". Same look as the site, English and Arabic.
{%- endcomment -%}
{%- assign is_ar = false -%}
{%- if request.locale.iso_code == 'ar' -%}{%- assign is_ar = true -%}{%- endif -%}
<section class="m-wl" aria-labelledby="m-wl-title-{{ section.id }}" data-m-wl data-signed-in="{% if customer %}true{% else %}false{% endif %}">
  <div class="m-wrap">
    <svg class="m-wl__heart" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.7 8 3.5 4.8 6.8 4.6c2-.1 3.7 1 5.2 3 1.5-2 3.2-3.1 5.2-3 3.3.2 5.1 3.4 4 6.6-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg>
    <h1 class="m-wl__title" id="m-wl-title-{{ section.id }}" data-m-wl-title>{% if is_ar %}قائمة مفضلتك قادمة قريبًا{% else %}Your wishlist is coming soon{% endif %}</h1>
    <p class="m-wl__text" data-m-wl-text>{% if is_ar %}نجهّز لك مكانًا تحفظ فيه عطورك المفضلة. في الوقت الحالي، تصفّح مجموعاتنا.{% else %}We are preparing a place to save the perfumes you love. For now, keep exploring.{% endif %}</p>
    <button type="button" class="m-btn" data-m-wl-open hidden>{% if is_ar %}افتح مفضلتي{% else %}Open my wishlist{% endif %}</button>
    <a class="m-btn m-btn--ghost" href="{{ routes.all_products_collection_url }}" data-m-wl-shop>{% if is_ar %}تسوّق الآن{% else %}Shop now{% endif %}</a>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-m-wl]');
    if (!root) return;
    const ar = document.documentElement.lang === 'ar';
    const wire = () => {
      if (typeof window.heartButtonHandle !== 'function') return false;
      root.querySelector('[data-m-wl-title]').textContent = ar ? 'قائمة مفضلتك' : 'Your wishlist';
      root.querySelector('[data-m-wl-text]').textContent = ar ? 'العطور التي أحببتها، في مكان واحد.' : 'The perfumes you love, in one place.';
      const open = root.querySelector('[data-m-wl-open]');
      open.hidden = false;
      open.addEventListener('click', () => window.heartButtonHandle());
      if (root.dataset.signedIn === 'true') window.heartButtonHandle();
      return true;
    };
    let tries = 0;
    const t = setInterval(() => { if (wire() || ++tries > 20) clearInterval(t); }, 300);
  })();
</script>

{% stylesheet %}
  .m-wl { padding-block: clamp(56px, 10vw, 112px); text-align: center; }
  .m-wl .m-wrap { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .m-wl__heart { color: var(--m-plum); }
  .m-wl__title { margin: 0; font-size: var(--m-h2); line-height: 1.1; text-wrap: balance; }
  .m-wl__text { margin: 0 0 8px; max-inline-size: 36ch; color: var(--m-plum); opacity: .8; text-wrap: balance; }
  .m-wl [hidden] { display: none; }
{% endstylesheet %}

{% schema %}
{ "name": "Wishlist", "settings": [], "presets": [] }
{% endschema %}
