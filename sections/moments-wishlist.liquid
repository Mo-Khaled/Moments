{%- comment -%}
  Wishlist page placeholder until a wishlist app is installed: "Your wishlist is coming soon." with a link back to the shop.
  Same look as the rest of the site (plum headline, berry pill button, English and Arabic).
{%- endcomment -%}
{%- assign is_ar = false -%}
{%- if request.locale.iso_code == 'ar' -%}{%- assign is_ar = true -%}{%- endif -%}
<section class="m-wl" aria-labelledby="m-wl-title-{{ section.id }}">
  <div class="m-wrap">
    <svg class="m-wl__heart" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.7 8 3.5 4.8 6.8 4.6c2-.1 3.7 1 5.2 3 1.5-2 3.2-3.1 5.2-3 3.3.2 5.1 3.4 4 6.6-1.7 4.7-9.2 9.3-9.2 9.3z"/></svg>
    <h1 class="m-wl__title" id="m-wl-title-{{ section.id }}">{% if is_ar %}قائمة مفضلتك قادمة قريبًا{% else %}Your wishlist is coming soon{% endif %}</h1>
    <p class="m-wl__text">{% if is_ar %}نجهّز لك مكانًا تحفظ فيه عطورك المفضلة. في الوقت الحالي، تصفّح مجموعاتنا.{% else %}We are preparing a place to save the perfumes you love. For now, keep exploring.{% endif %}</p>
    <a class="m-btn" href="{{ routes.all_products_collection_url }}">{% if is_ar %}تسوّق الآن{% else %}Shop now{% endif %}</a>
  </div>
</section>

{% stylesheet %}
  .m-wl { padding-block: clamp(56px, 10vw, 112px); text-align: center; }
  .m-wl .m-wrap { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .m-wl__heart { color: var(--m-plum); }
  .m-wl__title { margin: 0; font-size: var(--m-h2); line-height: 1.1; text-wrap: balance; }
  .m-wl__text { margin: 0 0 8px; max-inline-size: 36ch; color: var(--m-plum); opacity: .8; text-wrap: balance; }
{% endstylesheet %}

{% schema %}
{ "name": "Wishlist (coming soon)", "settings": [], "presets": [] }
{% endschema %}
