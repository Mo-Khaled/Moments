{%- comment -%}
  Brand marquee, directly under the hero. Same ticker technique as the announcement bar (snippets/moments-ticker.liquid):
  continuous, seamless, constant speed, pause on hover and focus, reversed in RTL, static wrapped row under reduced motion.
  Every logo links to its brand collection. Logos are the store's own collection logos, derived to transparent, trimmed,
  single-colour (pearl) files by scripts/prepare-brand-logos.py (assets/brand-<handle>.png), so they share one optical height
  and the Laverne silhouette and the baked-in backgrounds are gone. A brand without a derived file falls back to its collection image.
{%- endcomment -%}

{%- liquid
  assign logo_h = 32
  assign list_width = 0
  assign speed = section.settings.speed | at_least: 10
-%}

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign collection = block.settings.collection
      assign has_logo = false
      assign aspect = 3
      case collection.handle
      when 'afnan'
        assign aspect = 5.08
        assign has_logo = true
      when 'khadlaj'
        assign aspect = 5.19
        assign has_logo = true
      when 'lattafa'
        assign aspect = 3.47
        assign has_logo = true
      when 'faan'
        assign aspect = 5.78
        assign has_logo = true
      when 'assaf'
        assign aspect = 4.93
        assign has_logo = true
      when 'rasasi-perfumes'
        assign aspect = 3.72
        assign has_logo = true
      when 'laverne'
        assign aspect = 6.44
        assign has_logo = true
      when 'nabeel-perfumes'
        assign aspect = 3.03
        assign has_logo = true
      when 'ibraq'
        assign aspect = 4.41
        assign has_logo = true
      when 'le-falcone'
        assign aspect = 4.17
        assign has_logo = true
      when 'lattafa-pride'
        assign aspect = 5.86
        assign has_logo = true
      when 'armaf'
        assign aspect = 5.25
        assign has_logo = true
      when 'zimaya'
        assign aspect = 2.98
        assign has_logo = true
      when 'dkhoon-emirates'
        assign aspect = 3.09
        assign has_logo = true
      endcase
      assign h = logo_h
      if aspect > 5.25
        assign h = logo_h | times: 5.25 | divided_by: aspect
      endif
      assign w = aspect | times: h
      assign list_width = list_width | plus: w | plus: 80
    -%}
    {%- if collection != blank -%}
      <li class="m-brands__item" {{ block.shopify_attributes }}>
        <a class="m-brands__link" href="{{ collection.url }}">
          {%- if has_logo -%}
            {%- assign logo_file = 'brand-' | append: collection.handle | append: '.png' -%}
            <img
              src="{{ logo_file | asset_url }}"
              alt="{{ collection.title | escape }}"
              width="{{ w | round }}"
              height="{{ h | round }}"
              style="--m-logo-h: {{ h | round }}px"
              loading="lazy"
              decoding="async"
            >
          {%- elsif collection.image != blank -%}
            {{ collection.image | image_url: width: 400 | image_tag: alt: collection.title, class: 'm-brands__fallback', loading: 'lazy' }}
          {%- else -%}
            <span class="m-brands__name">{{ collection.title }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign duration = list_width | divided_by: speed | at_least: 20 -%}

{%- assign region_label = 'homepage.brands.label' | t -%}

<section class="m-brands" aria-label="{{ region_label }}">
  {%- comment -%} White page (2026-11-20): the pearl logo files are recoloured plum (#3B1E3A) on white, keeping their alpha. {%- endcomment -%}
  <svg class="m-brands__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="m-brands-plum" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0 0 0 0 0.2314  0 0 0 0 0.1176  0 0 0 0 0.2275  0 0 0 1 0"/>
    </filter>
  </svg>
  {% render 'moments-ticker', items: items, duration: duration, mode: 'wrap', copies: 1, label: region_label %}
</section>

{% javascript %}
  // Drag (mouse) or swipe (touch) the brand strip back and forth; it carries on by itself when let go (owner request
  // 2026-10-31: "if I miss the brand I can get back to it"). Drives the CSS animation's clock, so the loop stays seamless.
  // Vertical swipes still scroll the page (touch-action: pan-y). A drag of more than 6px does not open the brand under it.
  (() => {
    const init = (ticker) => {
      if (ticker.dataset.dragReady) return;
      const track = ticker.querySelector('.m-ticker__track');
      const animation = track && track.getAnimations()[0];
      if (!animation) return; // reduced motion: a static row, nothing to drag
      ticker.dataset.dragReady = 'true';

      const rtl = document.documentElement.dir === 'rtl';
      const duration = animation.effect.getComputedTiming().duration;
      let startX = 0;
      let startTime = 0;
      let dragging = false;
      let moved = false;
      let hovered = false;

      const resume = () => {
        if (!dragging && !hovered && !ticker.contains(document.activeElement)) animation.play();
      };

      ticker.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') {
          hovered = true;
          animation.pause();
        }
      });
      ticker.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') {
          hovered = false;
          resume();
        }
      });
      ticker.addEventListener('focusin', () => animation.pause());
      ticker.addEventListener('focusout', () => setTimeout(resume));

      ticker.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = true;
        moved = false;
        startX = event.clientX;
        startTime = animation.currentTime;
        animation.pause();
      });
      ticker.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        if (!moved && Math.abs(dx) > 6) {
          moved = true;
          ticker.setPointerCapture(event.pointerId);
          ticker.classList.add('is-dragging');
        }
        if (!moved) return;
        const msPerPx = duration / (track.scrollWidth / 2);
        const time = startTime - dx * (rtl ? -1 : 1) * msPerPx;
        animation.currentTime = ((time % duration) + duration) % duration;
      });
      const end = () => {
        if (!dragging) return;
        dragging = false;
        ticker.classList.remove('is-dragging');
        resume();
      };
      ticker.addEventListener('pointerup', end);
      ticker.addEventListener('pointercancel', end);
      // a drag is not a click on the logo under the finger
      ticker.addEventListener(
        'click',
        (event) => {
          if (moved) {
            event.preventDefault();
            event.stopPropagation();
            moved = false;
          }
        },
        true
      );
      ticker.addEventListener('dragstart', (event) => event.preventDefault());
    };

    const run = () => document.querySelectorAll('.m-brands .m-ticker').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    document.addEventListener('shopify:section:load', run);
  })();

  // Touch screens have no hover: highlight the logo nearest the middle of the screen while the strip moves (same look as the mouse hover).
  // Only runs on touch devices, only while the strip is on screen, about ten checks a second, and not under reduced motion.
  (() => {
    if (!window.matchMedia('(hover: none)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const init = (ticker) => {
      if (ticker.dataset.focusReady) return;
      ticker.dataset.focusReady = 'true';
      const items = [...ticker.querySelectorAll('.m-brands__item')];
      let visible = false;
      let last = 0;
      let raf = 0;
      const tick = (time) => {
        raf = 0;
        if (!visible) return;
        if (time - last > 90) {
          last = time;
          const mid = window.innerWidth / 2;
          let best = null;
          let bestDistance = Infinity;
          items.forEach((item) => {
            const box = item.getBoundingClientRect();
            if (box.right < 0 || box.left > window.innerWidth) return;
            const distance = Math.abs(box.left + box.width / 2 - mid);
            if (distance < bestDistance) {
              bestDistance = distance;
              best = item;
            }
          });
          items.forEach((item) => item.classList.toggle('is-center', item === best));
          ticker.classList.add('has-focus');
        }
        raf = requestAnimationFrame(tick);
      };
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible && !raf) raf = requestAnimationFrame(tick);
      }).observe(ticker);
    };
    const run = () => document.querySelectorAll('.m-brands .m-ticker').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    document.addEventListener('shopify:section:load', run);
  })();
{% endjavascript %}

{% stylesheet %}
  .m-brands {
    margin: 0;
    background: var(--m-surface);
    border-block: 1px solid rgb(59 30 58 / 0.24); /* was 8%: a clearer line above and below the strip */
  }

  .m-brands__defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  .m-brands .m-ticker {
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .m-brands .m-ticker.is-dragging {
    cursor: grabbing;
  }

  .m-brands .m-ticker {
    padding-block: 28px;
  }

  .m-brands .m-ticker__group {
    align-items: center;
    justify-content: space-around;
  }

  .m-brands .m-ticker__list {
    align-items: center;
  }

  .m-brands__item {
    flex: none;
    padding-inline: 40px;
  }

  .m-brands__link {
    display: flex;
    align-items: center;
    opacity: 0.86;
    transition: opacity var(--m-dur-2) var(--m-ease);
  }

  .m-brands__link:hover,
  .m-brands__link:focus-visible {
    opacity: 1;
  }

  .m-brands__link:focus-visible {
    outline: 2px solid var(--m-focus);
    outline-offset: 6px;
  }

  .m-brands__link img {
    display: block;
    inline-size: auto;
    block-size: var(--m-logo-h, 32px);
    max-block-size: none;
    filter: url('#m-brands-plum');
  }

  .m-brands__fallback {
    block-size: 32px;
    inline-size: auto;
  }

  .m-brands__name {
    color: var(--m-plum);
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .m-brands .m-ticker {
      padding-block: 20px;
    }

    .m-brands__item {
      padding-inline: 28px;
    }

    .m-brands__link img {
      block-size: calc(var(--m-logo-h, 32px) * 0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-brands .m-ticker__list {
      gap: 24px 8px;
    }
  }

  /* Hover and touch feel (owner 2026-11-24). Mouse: the strip dims, the logo under the pointer lifts, grows and gets a plum underline.
     Touch has no hover, so the logo nearest the middle of the screen takes that same highlight as the strip moves (set by the script below),
     and a tapped logo presses in. */
  .m-brands .m-brands__link {
    position: relative;
    transition: opacity 0.25s var(--m-ease, ease), transform 0.25s var(--m-ease, ease);
  }

  .m-brands .m-brands__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -10px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--m-plum);
    transform: scaleX(0);
    transition: transform 0.25s var(--m-ease, ease);
  }

  .m-brands .m-brands__link:active {
    transform: scale(0.94);
  }

  @media (hover: hover) {
    .m-brands .m-ticker:hover .m-brands__link {
      opacity: 0.4;
    }

    .m-brands .m-ticker:hover .m-brands__link:hover,
    .m-brands .m-brands__link:focus-visible {
      opacity: 1;
      transform: translateY(-2px) scale(1.1);
    }

    .m-brands .m-brands__link:hover::after,
    .m-brands .m-brands__link:focus-visible::after {
      transform: scaleX(1);
    }
  }

  @media (hover: none) {
    .m-brands .m-ticker.has-focus .m-brands__link {
      opacity: 0.5;
    }

    .m-brands .m-ticker.has-focus .m-brands__item.is-center .m-brands__link {
      opacity: 1;
      transform: scale(1.12);
    }

    .m-brands .m-brands__item.is-center .m-brands__link::after {
      transform: scaleX(1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS brand marquee",
  "limit": 1,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "info": "Pixels per second.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [{ "type": "collection", "id": "collection", "label": "Brand collection" }]
    }
  ],
  "presets": [{ "name": "MOMENTS brand marquee" }]
}
{% endschema %}
