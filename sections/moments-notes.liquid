  .m-note__more {
    border-block: 1px solid var(--m-hairline, #E6DDE3);
    margin-block: 8px 20px;
  }

  .m-note__more summary {
    display: flex;
    align-items: center;
    min-block-size: 48px;
    cursor: pointer;
    font-weight: 600;
  }

  .m-note__more h3 {
    margin: 16px 0 4px;
    font-size: 1rem;
  }

  .m-note__more p {
    margin: 0;
    line-height: 1.6;
    color: var(--m-text-muted);
  }

  .m-note__facts {
    display: grid;
    gap: 8px;
    margin: 0 0 8px;
  }

  .m-note__facts div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 8px;
  }

  .m-note__facts dt {
    color: var(--m-text-muted);
  }

  .m-note__facts dd {
    margin: 0;
  }

  .m-note__row-head {
    display: grid;
    gap: 0;
  }

  .m-note__row-head h3,
  .m-note__rel-head {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-weight: 400;
  }

  .m-note__row-head a {
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--m-berry-ink);
  }

  .m-note__legend {
    margin: 4px 0 12px;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--m-text-muted);
  }

  .m-key { display: grid; gap: 8px; margin: 0 0 8px; padding: 12px 14px; list-style: none; border-radius: 12px; background: #F7F3F5; }
  .m-key li { display: flex; align-items: center; gap: 12px; font-size: 0.875rem; line-height: 1.35; }
  .m-key .m-str__bar { flex: none; }
  .m-key b { font-weight: 600; }
  .m-note__est { margin: 0 0 14px; font-size: 0.8125rem; color: var(--m-text-muted); }

  .m-note__tag {
    display: inline-block;
    margin-inline-start: 6px;
    padding: 1px 8px;
    border-radius: 9999px;
    background: #F7F3F5;
    border: 1px solid var(--m-hairline, #E6DDE3);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* Perfume row: swipes sideways with snap on phones; a 3-column grid on desktop. */
  .m-note__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 42%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 20px;
    margin: 0 -20px 24px;
    padding: 0 20px 6px;
    list-style: none;
    scrollbar-width: none;
  }

  @media screen and (min-width: 750px) {
    .m-note__row {
