{%- comment -%}
  Notes page (2026-11-20, staging): a grid of the 37 fragrance notes. Tapping a note opens its card: a bottom sheet on phones
  (closes with the X, a tap outside, Esc or a swipe down) and a centred window on desktop. The page behind does not scroll while it
  is open; the URL becomes /pages/notes/<handle> and the browser back button closes it.
  Data: assets/notes-data.json, built by scripts/notes-build-data.py from the owner's approved texts (notes_content.json, copied
  as is) and the calculated data (scripts/notes-recalc.py). Perfume cards are read from /products/<handle>.js when a card opens.
  Note strength dots are an estimate (labelled); no percentages anywhere.
{%- endcomment -%}

{%- liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}

<section
  class="m-notes"
  data-m-notes
  data-src="{{ 'notes-data.json' | asset_url }}"
  data-lang="{% if is_ar %}ar{% else %}en{% endif %}"
  data-root="{{ root }}"
  data-base="{{ routes.root_url | append: '/pages/notes' | replace: '//', '/' }}"
  data-money="{{ shop.money_format | escape }}"
  data-see-all="{{ routes.collections_url }}/bundle-perfumes?filter.p.m.filter.notes="
>
  <div class="m-wrap">
    <header class="m-notes__head">
      <h1 class="m-notes__title">{% if is_ar %}النوتات.{% else %}Notes.{% endif %}</h1>
      <p class="m-notes__lede">
        {%- if is_ar -%}اكتشف المكوّنات التي تصنع العطور: ما رائحتها، ومن أين تأتي، وأي عطورنا تحملها.
        {%- else -%}Meet the ingredients behind every perfume: what each one smells like, where it comes from, and which of our perfumes carry it.
        {%- endif -%}
      </p>
    </header>
  </div>

  <div class="m-wrap">
   <div data-nf-inline>
    <div class="m-nf" data-filters role="group" aria-label="{% if is_ar %}تصفية النوتات{% else %}Filter notes{% endif %}">
      <div class="m-nf__group">
        <span class="m-nf__label">{% if is_ar %}الموسم{% else %}Season{% endif %}</span>
        <div class="m-nf__seg" data-seg="season">
          <button type="button" class="m-nf__b" data-g="season" data-v="" aria-pressed="true"><span class="m-nf__l">{% if is_ar %}الكل{% else %}All{% endif %}</span><span class="m-nf__n"></span></button>
          <button type="button" class="m-nf__b" data-g="season" data-v="summer" aria-pressed="false"><span class="m-nf__l">{% if is_ar %}صيف{% else %}Summer{% endif %}</span><span class="m-nf__n"></span></button>
          <button type="button" class="m-nf__b" data-g="season" data-v="winter" aria-pressed="false"><span class="m-nf__l">{% if is_ar %}شتاء{% else %}Winter{% endif %}</span><span class="m-nf__n"></span></button>
        </div>
      </div>
      <div class="m-nf__group">
        <span class="m-nf__label">{% if is_ar %}لمن{% else %}For{% endif %}</span>
        <div class="m-nf__seg" data-seg="gender">
          <button type="button" class="m-nf__b" data-g="gender" data-v="" aria-pressed="true"><span class="m-nf__l">{% if is_ar %}الكل{% else %}All{% endif %}</span><span class="m-nf__n"></span></button>
          <button type="button" class="m-nf__b" data-g="gender" data-v="men" aria-pressed="false"><span class="m-nf__l">{% if is_ar %}رجالي{% else %}Men{% endif %}</span><span class="m-nf__n"></span></button>
          <button type="button" class="m-nf__b" data-g="gender" data-v="women" aria-pressed="false"><span class="m-nf__l">{% if is_ar %}نسائي{% else %}Women{% endif %}</span><span class="m-nf__n"></span></button>
          <button type="button" class="m-nf__b" data-g="gender" data-v="unisex" aria-pressed="false"><span class="m-nf__l">{% if is_ar %}للجنسين{% else %}Unisex{% endif %}</span><span class="m-nf__n"></span></button>
        </div>
      </div>
      <div class="m-nf__group">
        <span class="m-nf__label">{% if is_ar %}اللحظة{% else %}Moment{% endif %}</span>
        <div class="m-nf__chips" data-seg="moment">
          <button type="button" class="m-nf__chip" data-g="moment" data-v="" aria-pressed="true"><span class="m-nf__l">{% if is_ar %}الكل{% else %}All{% endif %}</span><span class="m-nf__n"></span></button>
          {%- assign mh = 'fresh-moment,winter-moment,love-moment,night-moment,gift-moment,self-care-moment' | split: ',' -%}
          {%- for h in mh -%}
            {%- assign c = collections[h] -%}
            {%- if c != blank -%}
              <button type="button" class="m-nf__chip" data-g="moment" data-v="{{ h }}" aria-pressed="false"><span class="m-nf__l">{{ c.title }}</span><span class="m-nf__n"></span></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
   </div>
  </div>

  <dialog class="m-fsheet" data-fsheet aria-labelledby="m-fsheet-title">
    <div class="m-fsheet__panel">
      <div class="m-fsheet__head">
        <h2 id="m-fsheet-title" class="m-fsheet__title">{% if is_ar %}التصفية{% else %}Filters{% endif %}</h2>
        <button type="button" class="m-fsheet__x" data-fclose aria-label="{% if is_ar %}إغلاق{% else %}Close{% endif %}"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
      </div>
      <div class="m-fsheet__slot" data-nf-sheet></div>
      <div class="m-fsheet__foot">
        <button type="button" class="m-btn m-fsheet__apply" data-fapply></button>
      </div>
    </div>
  </dialog>

  <div class="m-notes__bar" data-bar>
    <div class="m-wrap m-notes__barin">
      <p class="m-notes__count" data-count aria-live="polite"></p>
      <button type="button" class="m-notes__fbtn" data-fopen aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/><circle cx="16" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="8" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>{% if is_ar %}التصفية{% else %}Filters{% endif %}</span><span class="m-notes__fn" data-fn hidden></span>
      </button>
    </div>
  </div>

  <div class="m-wrap m-notes__chiprow" data-chiprow hidden>
    <div class="m-notes__active" data-active></div>
    <button type="button" class="m-notes__reset" data-reset hidden>{% if is_ar %}إعادة ضبط{% else %}Reset{% endif %}</button>
  </div>

  <div class="m-wrap">
    <div class="m-notes__empty" data-empty hidden>
      <p>{% if is_ar %}لا توجد نوتات بهذه التصفية.{% else %}No notes match these filters.{% endif %}</p>
      <button type="button" class="m-btn m-btn--ghost" data-reset-empty>{% if is_ar %}إعادة ضبط{% else %}Reset{% endif %}</button>
    </div>
    <ul class="m-notes__grid" data-grid></ul>
    <noscript><p>{% if is_ar %}فعّل جافاسكربت لعرض النوتات.{% else %}Turn on JavaScript to see the notes.{% endif %}</p></noscript>
  </div>

</section>

{%- comment -%} the note card (dialog, labels, picture map, card script) is shared with the product page {%- endcomment -%}
{% render 'note-card' %}

<script>
  (() => {
    const root = document.querySelector('[data-m-notes]');
    if (!root) return;
    const C = window.MNoteCard;
    if (!C) return;
    const L = C.labels;
    const ar = C.ar;
    const grid = root.querySelector('[data-grid]');
    const countEl = root.querySelector('[data-count]');
    const base = root.dataset.base.replace(/\/$/, '');
    const isPhone = () => matchMedia('(max-width: 749px)').matches;
    const esc = (s) => String(s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const name = C.name;
    const tile = C.tile;
    let notes = [], byHandle = C.byHandle, active = { season: '', gender: '', moment: '' };
    const countText = (c) => {
      if (!ar) return `${c} ${c === 1 ? 'note' : 'notes'}`;
      const d = c.toLocaleString('ar-EG');
      if (c === 1) return 'نوتة واحدة';
      if (c === 2) return 'نوتتان';
      return `${d} ${c >= 3 && c <= 10 ? 'نوتات' : 'نوتة'}`;
    };

    const render = () => {
      const shown = notes.filter((n) =>
        (!active.season || active.season === n.season) &&
        (!active.gender || active.gender === n.gender) &&
        (!active.moment || n.moments.includes(active.moment)));
      const anyActive = !!(active.season || active.gender || active.moment);
      grid.innerHTML = shown.map((n, i) => `<li><a class="m-notes__item" href="${base}/${n.handle}" data-open="${n.handle}">${tile(n, false, i < 6)}<span class="m-notes__name">${esc(name(n))}</span></a></li>`).join('');
      countEl.textContent = countText(shown.length);
      root.querySelector('[data-empty]').hidden = shown.length > 0;
      root.querySelector('[data-reset]').hidden = !anyActive;
      root.querySelector('[data-chiprow]').hidden = !anyActive;
      root.querySelector('[data-active]').innerHTML = ['season', 'gender', 'moment'].filter((g) => active[g]).map((g) => {
        const b = root.querySelector(`[data-g="${g}"][data-v="${active[g]}"]`);
        const lab = b.querySelector('.m-nf__l').textContent;
        return `<button type="button" class="m-notes__tag" data-clear="${g}" aria-label="${esc(L.clear)}: ${esc(lab)}">${esc(lab)}<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>`;
      }).join('');
      const fmt = (c) => (ar ? c.toLocaleString('ar-EG') : String(c));
      const matches = (n, a) => (!a.season || a.season === n.season) && (!a.gender || a.gender === n.gender) && (!a.moment || n.moments.includes(a.moment));
      root.querySelectorAll('[data-g]').forEach((b) => {
        const g = b.dataset.g, v = b.dataset.v;
        b.setAttribute('aria-pressed', String(active[g] === v));
        const c = notes.filter((n) => matches(n, { ...active, [g]: v })).length;
        b.querySelector('.m-nf__n').textContent = fmt(c);
        const dead = c === 0 && v !== '' && active[g] !== v;
        b.classList.toggle('is-dead', dead);
        b.setAttribute('aria-disabled', String(dead));
      });
      const nAct = ['season', 'gender', 'moment'].filter((g) => active[g]).length;
      const fn = root.querySelector('[data-fn]');
      fn.hidden = !nAct;
      fn.textContent = fmt(nAct);
      root.querySelector('[data-fapply]').textContent = ar ? `عرض ${countText(shown.length)}` : `Show ${countText(shown.length)}`;
    };

    // the URL and the page title follow the open card (back closes it), as before the card moved to snippets/note-card
    C.onOpen = (n, push) => {
      document.title = ar ? `${name(n)} – لحظات` : `${name(n)} – MOMENTS`;
      if (push) history.pushState({ note: n.handle }, '', `${base}/${n.handle}`);
    };
    C.onClose = (pop) => {
      if (!pop && history.state && history.state.note) history.back();
    };
    const open = (h, push = true) => C.open(h, { history: true, push });
    const close = (pop = false) => C.close(pop);

    root.addEventListener('click', (e) => {
      const a = e.target.closest('[data-open]');
      if (a) { e.preventDefault(); open(a.dataset.open, !C.isOpen() || C.current() !== a.dataset.open); return; }
      const fb = e.target.closest('[data-g]');
      if (fb && fb.getAttribute('aria-disabled') === 'true') return;
      if (fb) { active[fb.dataset.g] = fb.dataset.v; render(); return; }
      const clr = e.target.closest('[data-clear]');
      if (clr) { active[clr.dataset.clear] = ''; render(); return; }
      if (e.target.closest('[data-reset], [data-reset-empty]')) {
        active = { season: '', gender: '', moment: '' };
        render();
      }
    });
    window.addEventListener('popstate', (e) => {
      const h = e.state && e.state.note;
      if (h) open(h, false); else close(true);
    });

    // The count bar sticks directly under the header: its offset is the header's real height (+ the header's own sticky top), measured, never a fixed number.
    const hdr = document.querySelector('#header-component');
    const barEl = root.querySelector('[data-bar]');
    const setBarTop = () => {
      if (!hdr) return;
      const sec = hdr.closest('.shopify-section') || hdr;
      const top = parseFloat(getComputedStyle(sec).top) || 0;
      barEl.style.setProperty('--m-bar-top', `${Math.round((hdr.getBoundingClientRect().height + top) * 100) / 100}px`);
    };
    setBarTop();
    addEventListener('resize', setBarTop);
    if (hdr && 'ResizeObserver' in window) new ResizeObserver(setBarTop).observe(hdr);
    addEventListener('scroll', setBarTop, { passive: true });

    // Filters: the three groups sit inline on desktop and move into a bottom sheet on phones.
    const nf = root.querySelector('[data-filters]');
    const slotInline = root.querySelector('[data-nf-inline]');
    const slotSheet = root.querySelector('[data-nf-sheet]');
    const fsheet = root.querySelector('[data-fsheet]');
    const placeFilters = () => { const t = isPhone() ? slotSheet : slotInline; if (nf.parentNode !== t) t.appendChild(nf); };
    placeFilters();
    matchMedia('(max-width: 749px)').addEventListener('change', () => { if (fsheet.open) fsheet.close(); placeFilters(); });
    root.querySelector('[data-fopen]').addEventListener('click', () => fsheet.showModal());
    root.querySelector('[data-fclose]').addEventListener('click', () => fsheet.close());
    root.querySelector('[data-fapply]').addEventListener('click', () => fsheet.close());
    fsheet.addEventListener('click', (e) => { if (e.target === fsheet) fsheet.close(); });

    C.load().then((d) => {
      notes = d.notes.slice().sort((a, b) => b.count - a.count);
      render();
      const m = location.pathname.match(/\/pages\/notes\/([a-z0-9-]+)/) || location.search.match(/[?&]note=([a-z0-9-]+)/);
      if (m && byHandle[m[1]]) open(m[1], false);
    });
  })();
</script>

{% stylesheet %}
  .m-notes {
    padding-block: var(--m-home-y, 48px);
  }

  .m-notes__head {
    display: grid;
    gap: 8px;
    margin-block-end: 16px;
  }

  .m-notes__title {
    margin: 0;
    font-size: var(--m-h1);
  }

  .m-notes__lede {
    margin: 0;
    max-inline-size: 52ch;
    color: var(--m-text-muted);
  }

  /* One vertical rhythm on the page: 24px between title, description, filters, count bar and grid. */
  .m-notes { --m-nrh: 24px; }

  .m-notes__head { margin-block-end: var(--m-nrh); }

  /* Filters: three labelled groups in one card (Season / For: segmented, Moment: one scrolling row of chips). */
  .m-nf {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--m-hairline, #E6DDE3);
    border-radius: 16px;
    background: #F7F3F5;
  }

  .m-nf__l { pointer-events: none; }
  .m-nf__n { margin-inline-start: 6px; font-size: 0.75rem; opacity: 0.6; pointer-events: none; }
  .m-nf__b.is-dead, .m-nf__chip.is-dead { opacity: 0.4; cursor: not-allowed; }
  .m-nf__b[aria-pressed='true'] .m-nf__n, .m-nf__chip[aria-pressed='true'] .m-nf__n { opacity: 0.8; }

  .m-nf__group { display: grid; gap: 6px; min-inline-size: 0; }
  .m-nf__label { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.02em; color: var(--m-text-muted); }

  .m-nf__seg {
    display: flex;
    padding: 3px;
    border: 1px solid var(--m-hairline, #E6DDE3);
    border-radius: 9999px;
    background: var(--m-surface);
  }

  .m-nf__b {
    flex: 1 1 0;
    min-block-size: 44px;
    padding-inline: 8px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--m-plum);
    font: inherit;
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .m-nf__b[aria-pressed='true'] { background: var(--m-plum); color: var(--m-pearl); }

  .m-nf__chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-inline: -16px;
    padding-inline: 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .m-nf__chips::-webkit-scrollbar { display: none; }

  .m-nf__chip {
    flex: none;
    min-block-size: 44px;
    padding-inline: 16px;
    border: 1px solid rgb(59 30 58 / 0.22);
    border-radius: 9999px;
    background: var(--m-surface);
    color: var(--m-plum);
    font: inherit;
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .m-nf__chip[aria-pressed='true'] { background: var(--m-plum); border-color: var(--m-plum); color: var(--m-pearl); }
  .m-nf__b:focus-visible, .m-nf__chip:focus-visible { outline: 2px solid var(--m-plum); outline-offset: 2px; }

  @media screen and (min-width: 750px) {
    .m-nf { grid-template-columns: auto auto minmax(0, 1fr); align-items: end; gap: 24px; }
    .m-nf__b { padding-inline: 18px; }
  }

  .m-notes__fbtn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding-inline: 16px;
    border: 1px solid rgb(59 30 58 / 0.3);
    border-radius: 9999px;
    background: var(--m-surface);
    color: var(--m-plum);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .m-notes__fn {
    display: inline-grid;
    place-items: center;
    min-inline-size: 20px;
    block-size: 20px;
    border-radius: 9999px;
    background: var(--m-plum);
    color: var(--m-pearl);
    font-size: 0.75rem;
  }

  .m-notes__fn[hidden] { display: none; }

  @media screen and (min-width: 750px) {
    .m-notes__fbtn { display: none; }
  }

  .m-fsheet {
    position: fixed;
    inset: auto 0 0 0;
    inline-size: 100%;
    max-inline-size: none;
    max-block-size: 88dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 20px 20px 0 0;
    background: var(--m-surface);
    color: var(--m-plum);
    box-shadow: 0 -8px 32px rgb(59 30 58 / 0.18);
  }

  .m-fsheet::backdrop { background: rgb(29 15 28 / 0.45); }
  .m-fsheet__panel { display: flex; flex-direction: column; max-block-size: 88dvh; }
  .m-fsheet__head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px 4px 16px; }
  .m-fsheet__title { margin: 0; font-size: var(--m-h3, 1.375rem); }
  .m-fsheet__x { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border: 1px solid rgb(59 30 58 / 0.2); border-radius: 14px; background: transparent; color: inherit; cursor: pointer; }
  .m-fsheet__slot { overflow-y: auto; padding: 8px 16px; }
  .m-fsheet__slot .m-nf { border: 0; padding: 0; background: transparent; }
  .m-fsheet__foot { padding: 12px 16px calc(16px + env(safe-area-inset-bottom, 0px)); border-block-start: 1px solid var(--m-hairline, #E6DDE3); }
  .m-fsheet__apply { inline-size: 100%; }

  @media screen and (min-width: 750px) {
    .m-fsheet { display: none; }
  }

  /* Slim sticky bar (about 52px): the count, the active filters as removable chips, Reset. */
  [data-nf-inline]:empty { display: none; }

  .m-notes__bar {
    position: sticky;
    inset-block-start: var(--m-bar-top, 60px);
    z-index: 5;
    margin: 0;
    background: var(--m-surface);
    border-block-end: 1px solid var(--m-hairline, #E6DDE3);
  }

  @media screen and (min-width: 750px) {
    .m-notes__bar { margin-block-start: var(--m-nrh); }
  }

  .m-notes__barin { display: flex; align-items: center; justify-content: space-between; gap: 12px; block-size: 52px; }
  .m-notes__count { margin: 0; flex: none; font-variant-numeric: tabular-nums; font-size: 0.9375rem; color: var(--m-text-muted); }
  .m-notes__chiprow { display: flex; align-items: center; gap: 12px; padding-block: 10px; }
  .m-notes__chiprow[hidden] { display: none; }
  .m-notes__active { display: flex; gap: 8px; flex: 1 1 auto; min-inline-size: 0; overflow-x: auto; scrollbar-width: none; }
  .m-notes__active::-webkit-scrollbar { display: none; }

  .m-notes__tag {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 44px;
    padding-inline: 12px;
    border: 0;
    border-radius: 9999px;
    background: var(--m-plum);
    color: var(--m-pearl);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .m-notes__reset {
    flex: none;
    min-block-size: 44px;
    padding-inline: 4px;
    border: 0;
    background: none;
    color: var(--m-berry-ink);
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .m-notes__empty { display: grid; justify-items: center; gap: 12px; padding-block: 40px; text-align: center; }
  .m-notes__empty[hidden] { display: none; }
  .m-notes__empty p { margin: 0; }

  .m-notes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: var(--m-nrh) 0 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .m-notes__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (min-width: 1100px) {
    .m-notes__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .m-notes__item {
    display: grid;
    gap: 8px;
    min-block-size: 44px;
    color: var(--m-plum);
    text-decoration: none;
  }

  /* Fixed square, so pictures never shift the layout. Until the owner's pictures arrive, a tinted tile with the initial. */
  .m-notes__pic {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    background: #F7F3F5;
    overflow: hidden;
  }

  .m-notes__pic img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .m-notes__ph {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 9vw, 3.5rem);
    color: color-mix(in srgb, var(--m-plum) 45%, transparent);
  }

  .m-notes__name {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    text-align: center;
  }

  /* The card: bottom sheet on phones, centred window on desktop. */
  html.m-notes-lock,
  html.m-notes-lock body {
    overflow: hidden;
  }

  .m-note {
    padding: 0;
    border: 0;
    background: transparent;
    max-inline-size: none;
    max-block-size: none;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
  }

  .m-note::backdrop {
    background: rgb(29 15 28 / 0.45);
  }

  .m-note__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    flex-direction: column;
    max-block-size: 88dvh;
    border-radius: 20px 20px 0 0;
    background: var(--m-surface);
    color: var(--m-plum);
    transition: transform var(--m-dur-2) var(--m-ease);
  }

  .m-note[open] .m-note__panel {
    animation: m-note-up var(--m-dur-3) var(--m-ease);
  }

  @keyframes m-note-up {
    from { transform: translateY(100%); }
  }

  @media screen and (min-width: 750px) {
    .m-note__panel {
      inset: 50% auto auto 50%;
      transform: translate(-50%, -50%);
      inline-size: min(720px, 92vw);
      max-block-size: 86vh;
      border-radius: 20px;
    }

    html[dir='rtl'] .m-note__panel {
      inset: 50% 50% auto auto;
      transform: translate(50%, -50%);
    }

    .m-note[open] .m-note__panel {
      animation: none;
    }

    .m-note__grip {
      display: none;
    }
  }

  .m-note__grip {
    display: grid;
    place-items: center;
    block-size: 24px;
    flex: none;
  }

  .m-note__grip span {
    inline-size: 40px;
    block-size: 4px;
    border-radius: 4px;
    background: var(--m-hairline, #E6DDE3);
  }

  .m-note__close {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-end: 8px;
    z-index: 2;
    box-shadow: 0 0 0 1px var(--m-hairline, #E6DDE3);
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    border-radius: 9999px;
    background: var(--m-surface);
    color: var(--m-plum);
    cursor: pointer;
  }

  .m-note__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 20px calc(40px + env(safe-area-inset-bottom, 0px));
  }

  .m-note__hero .m-notes__pic {
    inline-size: min(180px, 46vw);
    margin-inline: auto;
  }

  .m-note__title {
    margin: 16px 0 8px;
    text-align: center;
    font-size: var(--m-h2);
  }

  .m-note__simple {
    margin: 0 auto 16px;
    max-inline-size: 46ch;
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .m-note__more {
    border-block: 1px solid var(--m-hairline, #E6DDE3);
    margin-block: 8px 20px;
  }

  /* Open state: same breathing room below the text as the summary has above it */
  .m-note__more[open] {
    padding-block-end: 16px;
    margin-block-end: 16px;
  }

  .m-note__more summary {
    display: flex;
    align-items: center;
    min-block-size: 48px;
    cursor: pointer;
    font-weight: 600;
  }

  .m-note__more h3 {
    margin: 16px 0 4px;
    font-size: 1rem;
  }

  .m-note__more p {
    margin: 0;
    line-height: 1.6;
    color: var(--m-text-muted);
  }

  .m-note__facts {
    display: grid;
    gap: 8px;
    margin: 0 0 8px;
  }

  .m-note__facts div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 8px;
  }

  .m-note__facts dt {
    color: var(--m-text-muted);
  }

  .m-note__facts dd {
    margin: 0;
  }

  .m-note__row-head {
    display: grid;
    gap: 0;
  }

  .m-note__row-head h3,
  .m-note__rel-head {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .m-note__row-head a {
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--m-berry-ink);
  }

  .m-note__legend {
    margin: 4px 0 12px;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--m-text-muted);
  }

  .m-key { display: grid; gap: 8px; margin: 0 0 8px; padding: 12px 14px; list-style: none; border-radius: 12px; background: #F7F3F5; }
  .m-key li { display: flex; align-items: center; gap: 12px; font-size: 0.875rem; line-height: 1.35; }
  .m-key .m-str__bar { flex: none; }
  .m-key b { font-weight: 600; }
  .m-note__est { margin: 0 0 14px; font-size: 0.8125rem; color: var(--m-text-muted); }

  .m-note__tag {
    display: inline-block;
    margin-inline-start: 6px;
    padding: 1px 8px;
    border-radius: 9999px;
    background: #F7F3F5;
    border: 1px solid var(--m-hairline, #E6DDE3);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* Perfume row: swipes sideways with snap on phones; a 3-column grid on desktop. */
  .m-note__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 42%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 20px;
    margin: 0 -20px 24px;
    padding: 0 20px 6px;
    list-style: none;
    scrollbar-width: none;
  }

  @media screen and (min-width: 750px) {
    .m-note__row {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .m-pcard {
    scroll-snap-align: start;
  }

  .m-pcard a {
    display: grid;
    gap: 4px;
    color: var(--m-plum);
    text-decoration: none;
  }

  .m-pcard__img {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    background: #F7F3F5;
    overflow: hidden;
  }

  .m-pcard__img img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .m-pcard__name {
    font-family: var(--font-heading--family);
    font-size: 0.9375rem;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .m-pcard__price {
    font-size: 0.875rem;
  }

  .m-str { display: grid; gap: 4px; margin-block-start: 2px; }
  .m-str__bar { display: flex; gap: 3px; inline-size: 54px; }
  .m-str__bar i { flex: 1; block-size: 5px; border-radius: 3px; background: #E9DFE6; }
  .m-str__bar i.on { background: var(--m-plum); }
  .m-str__w { font-size: 0.8125rem; line-height: 1.3; color: var(--m-text-muted); }

  .m-pcard__allbtn { display: grid; place-items: center; min-block-size: 120px; padding: 12px; border: 1px solid rgb(59 30 58 / 0.22); border-radius: 12px; text-align: center; font-size: 0.9375rem; color: var(--m-berry-ink); }

  .m-note__related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .m-note__related { display: flex; flex-wrap: wrap; }
  }

  .m-note__related a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    padding-inline: 16px;
    border: 1px solid var(--m-hairline, #E6DDE3);
    border-radius: 9999px;
    color: var(--m-plum);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-note[open] .m-note__panel {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS notes",
  "limit": 1,
  "settings": [],
  "presets": [{ "name": "MOMENTS notes" }]
}
{% endschema %}
