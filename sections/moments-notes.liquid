    padding-inline: 16px;
    border: 1px solid var(--m-hairline, #E6DDE3);
    border-radius: 9999px;
    color: var(--m-plum);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-note[open] .m-note__panel {
      animation: none;
    }
  }
