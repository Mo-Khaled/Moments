      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .m-pcard {
    scroll-snap-align: start;
  }

  .m-pcard a {
    display: grid;
    gap: 4px;
    color: var(--m-plum);
    text-decoration: none;
  }

  .m-pcard__img {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    background: #F7F3F5;
