{%- comment -%}
  Value strip under the hero: four short promises, text only, separated by hairlines.
  Every promise is already stated elsewhere in the store: sealed originals (decision: "100% original, sealed",
  the "authorized distributors" claim is not used until it is confirmed), cash on delivery and the free
  shipping threshold (announcement bar), and the returns and exchange policy page.
  The free shipping amount is a setting so it matches the announcement bar and the cart.
{%- endcomment -%}

{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
-%}

<section class="m-pillars" aria-label="{{ 'homepage.pillars.original_title' | t }}">
  <ul class="m-pillars__list m-wrap">
    <li class="m-pillars__item">
      <p class="m-pillars__title">{{ 'homepage.pillars.original_title' | t }}</p>
      <p class="m-pillars__text">{{ 'homepage.pillars.original_text' | t }}</p>
    </li>
    <li class="m-pillars__item">
      <p class="m-pillars__title">{{ 'homepage.pillars.cod_title' | t }}</p>
      <p class="m-pillars__text">{{ 'homepage.pillars.cod_text' | t }}</p>
    </li>
    <li class="m-pillars__item">
      <p class="m-pillars__title">{{ 'homepage.pillars.shipping_title' | t }}</p>
      <p class="m-pillars__text">{{ 'homepage.pillars.shipping_text' | t: amount: threshold }}</p>
    </li>
    <li class="m-pillars__item">
      <p class="m-pillars__title">
        {%- if section.settings.returns_url != blank -%}
          <a href="{{ section.settings.returns_url }}">{{ 'homepage.pillars.returns_title' | t }}</a>
        {%- else -%}
          {{ 'homepage.pillars.returns_title' | t }}
        {%- endif -%}
      </p>
      <p class="m-pillars__text">{{ 'homepage.pillars.returns_text' | t }}</p>
    </li>
  </ul>
</section>

{% stylesheet %}
  .m-pillars {
    background: var(--m-surface);
    border-block-end: 1px solid var(--m-rule-quiet);
  }

  .m-pillars__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }

  .m-pillars__item {
    padding-block: 20px;
    padding-inline: 0 16px;
  }

  /* Hairline between items. In the 2-column layout only the first column needs a trailing rule. */
  .m-pillars__item:nth-child(odd) {
    border-inline-end: 1px solid var(--m-rule-quiet);
  }

  .m-pillars__item:nth-child(even) {
    padding-inline-start: 20px;
  }

  .m-pillars__item:nth-child(n + 3) {
    border-block-start: 1px solid var(--m-rule-quiet);
  }

  .m-pillars__title {
    margin: 0 0 4px;
    color: var(--m-text);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .m-pillars__title a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .m-pillars__text {
    margin: 0;
    color: var(--m-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  html[lang='ar'] .m-pillars__text {
    line-height: 1.7;
  }

  @media screen and (min-width: 990px) {
    .m-pillars__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .m-pillars__list > .m-pillars__item:nth-child(n) {
      padding-block: 28px;
      padding-inline: 24px;
      border-block-start: 0;
      border-inline-end: 1px solid var(--m-rule-quiet);
    }

    .m-pillars__list > .m-pillars__item:first-child {
      padding-inline-start: 0;
    }

    .m-pillars__list > .m-pillars__item:last-child {
      border-inline-end: 0;
    }

    .m-pillars__title {
      font-size: 1rem;
    }

    .m-pillars__text {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS value strip",
  "limit": 1,
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping above (LE)",
      "info": "Keep in step with the announcement bar and the cart.",
      "default": 3000
    },
    { "type": "url", "id": "returns_url", "label": "Returns and exchange policy page" }
  ],
  "presets": [{ "name": "MOMENTS value strip" }]
}
{% endschema %}
