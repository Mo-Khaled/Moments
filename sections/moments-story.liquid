{%- comment -%}
  Brand story band, in the plum family (the colour flow has three surface tones only: plum family, pearl, and the nude used inside cards). The active moment still shows in the marks and links through --m-live.
  Left: the confirmed facts and a link. Right: the six moments as large type, each linking to its collection.
  Only confirmed facts: MOMENTS is a fragrance store in Egypt and sorts its bottles by moment.
  TODO (shown in the theme editor only): the real brand story, founding year and team photograph.
{%- endcomment -%}

<section class="m-story" aria-labelledby="m-story-title-{{ section.id }}">
  <div class="m-story__inner m-wrap">
    <div class="m-story__copy">
      <h2 class="m-story__title" id="m-story-title-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'homepage.story.heading' | t }}
        {%- endif -%}
      </h2>
      <p class="m-story__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          {{ 'homepage.story.text' | t }}
        {%- endif -%}
      </p>
      {%- if section.settings.link_url != blank -%}
        <a class="m-link" href="{{ section.settings.link_url }}">{{ 'homepage.story.link' | t }}</a>
      {%- endif -%}
      {%- if request.design_mode -%}
        <p class="m-story__todo">{{ 'homepage.story.todo' | t }}</p>
      {%- endif -%}
    </div>

    <ul class="m-story__index">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="m-story__row m-tone--{{ block.settings.mark }}" href="{{ block.settings.collection.url }}" data-moment-host>
              <span class="m-story__chip" aria-hidden="true">{% render 'moment-mark', mark: block.settings.mark, size: 'sm', class: 'm-story__mark' %}</span>
              <span class="m-story__name">
                {%- case block.settings.mark -%}
                  {%- when 'night' -%}
                    {{ 'moments.night' | t }}
                  {%- when 'gift' -%}
                    {{ 'moments.gift' | t }}
                  {%- when 'allday' -%}
                    {{ 'moments.all_day' | t }}
                  {%- when 'daily' -%}
                    {{ 'moments.daily' | t }}
                  {%- when 'fresh' -%}
                    {{ 'moments.fresh' | t }}
                  {%- else -%}
                    {{ 'moments.love' | t }}
                {%- endcase -%}
              </span>
              <span class="m-story__count">{{ 'homepage.moments.count' | t: count: block.settings.collection.products_count }}</span>
              <span class="m-story__go" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M10.5 5l5 5-5 5"/></svg></span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .m-story {
    --m-mark-ink: var(--m-live-ink);
    --m-mark-body: transparent;
    --m-mark-accent: var(--m-live-ink);
    --m-mark-gold: var(--m-live-ink);

    background: var(--m-plum);
    color: var(--m-pearl);
    padding-block: var(--m-space-l);
  }

  .m-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .m-story__copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .m-story__title {
    margin: 0;
    max-inline-size: 12ch;
    font-size: var(--m-h2);
    line-height: 1;
    text-wrap: balance;
  }

  .m-story__text {
    margin: 0;
    max-inline-size: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .m-story__todo {
    margin: 0;
    padding: 8px 12px;
    border: 1px dashed currentcolor;
    font-size: 0.8125rem;
  }

  /* The six moments as rounded rows: a colour chip with the mark, the name, how many bottles, and an arrow. Same card radius as everything else. */
  .m-story__index {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-story__chip {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    display: grid;
    place-items: center;
    inline-size: 60px;
    block-size: 60px;
    border-radius: 14px;
    background: var(--tile-bg);
    transition: transform var(--m-dur-2) var(--m-ease);
  }

  moment-mark.m-story__mark {
    --mm-size: 58px;
  }

  .m-story__row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: 16px;
    padding: 10px 16px 10px 10px;
    border: 1px solid rgb(250 246 242 / 0.16);
    border-radius: var(--m-radius-card);
    background: rgb(250 246 242 / 0.05);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--m-dur-2) var(--m-ease), border-color var(--m-dur-2) var(--m-ease), transform var(--m-dur-2) var(--m-ease);
  }

  html[dir='rtl'] .m-story__row {
    padding: 10px 10px 10px 16px;
  }

  .m-story__name {
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 3.2vw, 2.25rem);
    line-height: 1.1;
  }

  .m-story__count {
    font-size: 0.875rem;
    color: rgb(250 246 242 / 0.78);
  }

  .m-story__go {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border: 1px solid rgb(250 246 242 / 0.4);
    border-radius: 9999px;
    transition: transform var(--m-dur-2) var(--m-ease), background-color var(--m-dur-2) var(--m-ease), color var(--m-dur-2) var(--m-ease);
  }

  html[dir='rtl'] .m-story__go svg {
    transform: scaleX(-1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .m-story__row:hover {
      background: rgb(250 246 242 / 0.1);
      border-color: rgb(250 246 242 / 0.4);
      transform: translateY(-2px);
    }

    .m-story__row:hover .m-story__chip {
      transform: scale(1.04);
    }

    .m-story__row:hover .m-story__go {
      transform: translateX(3px);
      background: var(--m-pearl);
      color: var(--m-plum);
    }

    html[dir='rtl'] .m-story__row:hover .m-story__go {
      transform: translateX(-3px);
    }
  }

  @media screen and (max-width: 749px) {
    .m-story__row {
      grid-template-columns: 52px minmax(0, 1fr) auto;
    }

    .m-story__chip {
      inline-size: 52px;
      block-size: 52px;
    }

    moment-mark.m-story__mark {
      --mm-size: 50px;
    }

    .m-story__count {
      display: none;
    }
  }

  .m-story__row:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  html[lang='ar'] .m-story__title {
    line-height: 1.3;
  }

  html[lang='ar'] .m-story__text {
    line-height: 1.75;
  }

  html[lang='ar'] .m-story__name {
    line-height: 1.35;
  }

  @media screen and (min-width: 990px) {
    .m-story__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 96px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS brand story",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Only confirmed facts." },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment row",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "select",
          "id": "mark",
          "label": "Moment mark",
          "options": [
            { "value": "night", "label": "Night" },
            { "value": "gift", "label": "Gift" },
            { "value": "allday", "label": "All day" },
            { "value": "daily", "label": "Daily" },
            { "value": "fresh", "label": "Fresh" },
            { "value": "love", "label": "Love" }
          ],
          "default": "night"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "MOMENTS brand story" }]
}
{% endschema %}
