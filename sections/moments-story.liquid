{%- comment -%}
  Brand story. Only facts that are confirmed are written here: MOMENTS is a fragrance store in Egypt and sorts
  its bottles by moment. Everything else (founding year, team, sourcing story, photograph) stays a TODO, shown
  to the merchant in the theme editor only, and never to shoppers.
  TODO: real brand story, founding year, team photograph. Do not add authenticity or distributor claims until confirmed.
{%- endcomment -%}

<section class="m-story" aria-labelledby="m-story-title-{{ section.id }}">
  <div class="m-story__inner m-wrap">
    <div class="m-story__copy">
      <h2 class="m-story__title" id="m-story-title-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'homepage.story.heading' | t }}
        {%- endif -%}
      </h2>
      <p class="m-story__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          {{ 'homepage.story.text' | t }}
        {%- endif -%}
      </p>
      {%- if section.settings.link_url != blank -%}
        <a class="m-link" href="{{ section.settings.link_url }}">{{ 'homepage.story.link' | t }}</a>
      {%- endif -%}
      {%- if request.design_mode -%}
        <p class="m-story__todo">{{ 'homepage.story.todo' | t }}</p>
      {%- endif -%}
    </div>

    <div class="m-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag: class: 'm-story__image', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: section.settings.image_alt
        }}
      {%- else -%}
        <ul class="m-story__marks" aria-hidden="true" data-moment-host>
          {%- assign mark_list = 'night,gift,allday,daily,fresh,love' | split: ',' -%}
          {%- for mark in mark_list -%}
            <li>{% render 'moment-mark', mark: mark, size: 'lg' %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .m-story {
    padding-block: clamp(40px, 6vw, 88px);
    background: var(--m-nude);
    color: var(--m-text);
  }

  .m-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  .m-story__copy {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .m-story__title {
    margin: 0;
    max-inline-size: 16ch;
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .m-story__text {
    margin: 0;
    max-inline-size: 46ch;
    color: var(--m-text-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .m-story__todo {
    margin: 0;
    padding: 8px 12px;
    border: 1px dashed var(--m-gold-ink);
    color: var(--m-text-muted);
    font-size: 0.8125rem;
  }

  .m-story__image {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .m-story__marks {
    --m-mark-body: var(--m-pearl);

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The large marks are 160 px wide. On phones each sits in a 104 px cell and is scaled down to fit it. */
  .m-story__marks li {
    display: grid;
    place-items: center;
    block-size: 104px;
  }

  .m-story__marks li > * {
    transform: scale(0.62);
  }

  html[lang='ar'] .m-story__title {
    line-height: 1.35;
  }

  html[lang='ar'] .m-story__text {
    line-height: 1.75;
  }

  @media screen and (min-width: 990px) {
    .m-story__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 80px;
    }

    .m-story__marks {
      gap: 24px 16px;
    }

    .m-story__marks li {
      block-size: auto;
    }

    .m-story__marks li > * {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS brand story",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Only confirmed facts." },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Photograph", "info": "TODO: team or workshop photograph. Without one, the six Moment marks are shown." },
    { "type": "text", "id": "image_alt", "label": "Image description" }
  ],
  "presets": [{ "name": "MOMENTS brand story" }]
}
{% endschema %}
