{%- comment -%}
  Brand story band. The band takes the colour of the active moment (--m-live), so it changes when the hero moment changes.
  Left: the confirmed facts and a link. Right: the six moments as large type, each linking to its collection.
  Only confirmed facts: MOMENTS is a fragrance store in Egypt and sorts its bottles by moment.
  TODO (shown in the theme editor only): the real brand story, founding year and team photograph.
{%- endcomment -%}

<section class="m-story" aria-labelledby="m-story-title-{{ section.id }}">
  <div class="m-story__inner m-wrap">
    <div class="m-story__copy">
      <h2 class="m-story__title" id="m-story-title-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'homepage.story.heading' | t }}
        {%- endif -%}
      </h2>
      <p class="m-story__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          {{ 'homepage.story.text' | t }}
        {%- endif -%}
      </p>
      {%- if section.settings.link_url != blank -%}
        <a class="m-link" href="{{ section.settings.link_url }}">{{ 'homepage.story.link' | t }}</a>
      {%- endif -%}
      {%- if request.design_mode -%}
        <p class="m-story__todo">{{ 'homepage.story.todo' | t }}</p>
      {%- endif -%}
    </div>

    <ul class="m-story__index">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="m-story__row" href="{{ block.settings.collection.url }}" data-moment-host>
              {% render 'moment-mark', mark: block.settings.mark, size: 'sm', class: 'm-story__mark' %}
              <span class="m-story__name">
                {%- case block.settings.mark -%}
                  {%- when 'night' -%}
                    {{ 'moments.night' | t }}
                  {%- when 'gift' -%}
                    {{ 'moments.gift' | t }}
                  {%- when 'allday' -%}
                    {{ 'moments.all_day' | t }}
                  {%- when 'daily' -%}
                    {{ 'moments.daily' | t }}
                  {%- when 'fresh' -%}
                    {{ 'moments.fresh' | t }}
                  {%- else -%}
                    {{ 'moments.love' | t }}
                {%- endcase -%}
              </span>
              <span class="m-story__count">{{ block.settings.collection.products_count }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .m-story {
    --m-mark-ink: var(--m-live-ink);
    --m-mark-body: transparent;
    --m-mark-accent: var(--m-live-ink);
    --m-mark-gold: var(--m-live-ink);

    background: var(--m-live);
    color: var(--m-live-ink);
    padding-block: clamp(56px, 8vw, 112px);
  }

  .m-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .m-story__copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .m-story__title {
    margin: 0;
    max-inline-size: 12ch;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .m-story__text {
    margin: 0;
    max-inline-size: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .m-story__todo {
    margin: 0;
    padding: 8px 12px;
    border: 1px dashed currentcolor;
    font-size: 0.8125rem;
  }

  .m-story__index {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid currentcolor;
  }

  moment-mark.m-story__mark {
    --mm-size: 40px;
  }

  .m-story__row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 16px;
    padding-block: 14px;
    border-block-end: 1px solid currentcolor;
    color: inherit;
    text-decoration: none;
  }

  .m-story__name {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .m-story__count {
    font-size: 0.875rem;
  }

  .m-story__row:hover .m-story__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
  }

  .m-story__row:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  html[lang='ar'] .m-story__title {
    line-height: 1.3;
  }

  html[lang='ar'] .m-story__text {
    line-height: 1.75;
  }

  html[lang='ar'] .m-story__name {
    line-height: 1.35;
  }

  @media screen and (min-width: 990px) {
    .m-story__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 96px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS brand story",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Only confirmed facts." },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment row",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "select",
          "id": "mark",
          "label": "Moment mark",
          "options": [
            { "value": "night", "label": "Night" },
            { "value": "gift", "label": "Gift" },
            { "value": "allday", "label": "All day" },
            { "value": "daily", "label": "Daily" },
            { "value": "fresh", "label": "Fresh" },
            { "value": "love", "label": "Love" }
          ],
          "default": "night"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "MOMENTS brand story" }]
}
{% endschema %}
