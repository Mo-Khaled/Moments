{%- comment -%}
  Standalone page for one fragrance note (metaobject type "note", URL /pages/notes/<handle>). It is the server-rendered version for
  search engines and direct links (a reload of a note opened on the Notes page lands here); the interactive grid and sheet are on /pages/notes. Texts are the owner's approved ones (EN and AR fields).
{%- endcomment -%}
{%- liquid
  assign n = metaobject
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  if is_ar
    assign name = n.name_ar.value | default: n.name.value
    assign family = n.family_ar.value
    assign longevity = n.longevity_ar.value
    assign simple = n.simple_ar.value
    assign source = n.source_ar.value
    assign story = n.story_ar.value
  else
    assign name = n.name.value
    assign family = n.family_en.value
    assign longevity = n.longevity_en.value
    assign simple = n.simple_en.value
    assign source = n.source_en.value
    assign story = n.story_en.value
  endif
  assign notes_url = routes.root_url | append: '/pages/notes' | replace: '//', '/'
  assign img_asset = 'note-' | append: n.system.handle | append: '-1024.webp'
  assign key_notes = 'Vanilla,Oud,Rose,Musk,Amber,Saffron,Jasmine,Sandalwood,Patchouli,Tonka Bean,Tobacco,Leather,Coffee,Caramel,Honey,Lavender,Incense,Iris,Coconut,Cherry,Chocolate,Pistachio,Orange Blossom,Citrus,Marine,Vetiver,Apple,Berries,Pineapple,Cinnamon' | split: ','
  assign key_ar = 'فانيليا,عود,ورد,مسك,عنبر,زعفران,ياسمين,خشب الصندل,باتشولي,حبوب التونكا,تبغ,جلد,قهوة,كراميل,عسل,خزامى,بخور,سوسن,جوز الهند,كرز,شوكولاتة,فستق,زهر البرتقال,الحمضيات,نفحات بحرية,نجيل الهند,تفاح,التوت,أناناس,قرفة' | split: ','
  assign en_name = n.name.value
  assign all_url = routes.search_url | append: '?type=product&q=' | append: en_name
  for k in key_notes
    if k == en_name
      assign filter_value = k
      if is_ar
        assign filter_value = key_ar[forloop.index0]
      endif
      assign all_url = routes.collections_url | append: '/bundle-perfumes?filter.p.m.filter.notes=' | append: filter_value
    endif
  endfor
  assign all_url = all_url | replace: ' ', '+'
-%}
<article class="m-notepage">
  <div class="m-wrap m-notepage__grid">
    <div class="m-notepage__img">
      {%- if n.image.value != blank -%}
        {{ n.image.value | image_url: width: 1024 | image_tag: alt: name, loading: 'eager', sizes: '(min-width: 750px) 480px, 100vw' }}
      {%- else -%}
        <img src="{{ img_asset | asset_url }}" alt="{{ name | escape }}" width="1024" height="1024" loading="eager">
      {%- endif -%}
    </div>
    <div class="m-notepage__body">
      <p class="m-notepage__eyebrow">{% if is_ar %}نوتة عطرية{% else %}Fragrance note{% endif %}{% if family != blank %} · {{ family }}{% endif %}</p>
      <h1 class="m-notepage__title">{{ name }}</h1>
      {%- if simple != blank -%}<p class="m-notepage__lead">{{ simple }}</p>{%- endif -%}
      {%- comment -%} The three facts as one compact list (owner 2026-11-27: less empty space). {%- endcomment -%}
      {%- if longevity != blank or source != blank or story != blank -%}
        <dl class="m-notepage__facts">
          {%- if longevity != blank -%}
            <div class="m-notepage__fact"><dt class="m-notepage__h">{% if is_ar %}الثبات{% else %}How long it lasts{% endif %}</dt><dd>{{ longevity }}</dd></div>
          {%- endif -%}
          {%- if source != blank -%}
            <div class="m-notepage__fact"><dt class="m-notepage__h">{% if is_ar %}من أين تأتي{% else %}Where it comes from{% endif %}</dt><dd>{{ source }}</dd></div>
          {%- endif -%}
          {%- if story != blank -%}
            <div class="m-notepage__fact"><dt class="m-notepage__h">{% if is_ar %}حكايتها{% else %}Its story{% endif %}</dt><dd>{{ story }}</dd></div>
          {%- endif -%}
        </dl>
      {%- endif -%}
      <div class="m-notepage__ctas">
        <a class="m-btn" href="{{ all_url }}">{% if is_ar %}اكتشف كل العطور التي تحتوي على {{ name }}{% else %}See all perfumes with {{ name }}{% endif %}</a>
        <a class="m-btn m-btn--ghost" href="{{ notes_url }}">{% if is_ar %}استكشف كل النوتات{% else %}Explore all notes{% endif %}</a>
      </div>
    </div>
  </div>
  {%- comment -%} "Perfumes with <note>": the same section as the note card (data, bars, perfume row, See all), filled by the shared card script. {%- endcomment -%}
  <div class="m-wrap m-notepage__perfumes" data-note-perfumes="{{ n.system.handle }}" hidden></div>
</article>
{% render 'note-card' %}
<script>
  (() => {
    const box = document.querySelector('[data-note-perfumes]');
    const C = window.MNoteCard;
    if (!box || !C) return;
    C.load().then(() => {
      const n = C.byHandle[box.dataset.notePerfumes];
      if (!n || !(n.perfumes || []).length) return;
      box.innerHTML = C.perfumesHtml(n);
      box.hidden = false;
      C.fillPerfumes(n, box.querySelector('[data-row]'));
    });
  })();
</script>

{% stylesheet %}
  .m-notepage { padding-block: clamp(16px, 3vw, 40px); }
  /* One column on phones that never grows past the screen (a long fact line would widen an auto track). */
  .m-notepage__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: start; }
  .m-notepage__body { min-inline-size: 0; }
  .m-notepage__img img { inline-size: 100%; block-size: auto; border-radius: 16px; background: #F7F3F5; }
  .m-notepage__body { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .m-notepage__eyebrow { margin: 0; font-size: .875rem; opacity: .75; }
  .m-notepage__title { margin: 0; font-size: var(--m-h2); line-height: 1.1; }
  .m-notepage__lead { margin: 0; font-size: 1.1875rem; line-height: 1.5; }
  .m-notepage__body p { margin: 0; }
  .m-notepage__facts { inline-size: 100%; margin: 8px 0 0; border-block-start: 1px solid var(--m-hairline, #E6DDE3); }
  .m-notepage__fact { display: grid; gap: 2px; padding-block: 12px; border-block-end: 1px solid var(--m-hairline, #E6DDE3); }
  .m-notepage__fact dt { margin: 0; font-size: .8125rem; font-weight: 600; line-height: 1.4; opacity: .7; }
  .m-notepage__fact dd { margin: 0; font-size: 1rem; line-height: 1.55; }
  .m-notepage__body .m-btn { align-self: center; margin-block-start: 12px; }
  .m-notepage__ctas { display: flex; flex-direction: column; gap: 12px; inline-size: 100%; margin-block-start: 16px; }
  .m-notepage__ctas .m-btn { align-self: stretch; inline-size: 100%; max-inline-size: none; margin: 0; justify-content: center; text-align: center; min-block-size: 48px; }
  .m-notepage__perfumes[hidden] { display: none; }
  .m-notepage__perfumes { margin-block-start: clamp(28px, 4vw, 48px); }
  .m-notepage__perfumes .m-note__legend { margin-block-end: 8px; }
  .m-notepage__perfumes .m-note__all { margin-block-start: 16px; }
  /* The row bleeds to the screen edge by the card's 20 px; the page's own edge is 16 px (20 px made the page scroll sideways by 4 px). */
  .m-notepage__perfumes .m-note__row { margin-inline: -16px; padding-inline: 16px; }
  .m-notepage__perfumes .m-note__row-head h3 { font-size: var(--m-h3, 1.75rem); }
  @media screen and (min-width: 750px) { .m-notepage__perfumes .m-note__row { grid-template-columns: repeat(6, minmax(0, 1fr)); } .m-notepage__perfumes .m-key { display: flex; flex-wrap: wrap; gap: 8px 28px; inline-size: fit-content; max-inline-size: 100%; } }
  @media screen and (min-width: 750px) { .m-notepage__ctas { flex-direction: row; flex-wrap: wrap; inline-size: auto; } .m-notepage__ctas .m-btn { align-self: auto; inline-size: auto; } }
  @media screen and (min-width: 750px) {
    .m-notepage__grid { grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 56px; align-items: center; }
    /* Wide screens: each fact's label beside its text, one line each where it fits. */
    .m-notepage__fact { grid-template-columns: 180px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  }
{% endstylesheet %}

{% schema %}
{ "name": "Note page", "settings": [] }
{% endschema %}
