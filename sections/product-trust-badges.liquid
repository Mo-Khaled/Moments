{%- assign free_shipping_amount = settings.moments_free_shipping | times: 100 | money_without_trailing_zeros -%}
<div class="trust-badges color-{{ section.settings.color_scheme }} section--page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="trust-badges__list">

    <div class="trust-badges__item">
      <span class="trust-badges__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
          <rect x="9" y="11" width="14" height="10" rx="2"/>
          <circle cx="12" cy="20" r="1"/>
          <circle cx="20" cy="20" r="1"/>
        </svg>
      </span>
      <div class="trust-badges__text">
        <strong class="trust-badges__title">{{ 'homepage.pillars.shipping_title' | t }}</strong>
        <span class="trust-badges__subtitle">{{ 'homepage.pillars.shipping_text' | t: amount: free_shipping_amount }}</span>
      </div>
    </div>

    <div class="trust-badges__item">
      <span class="trust-badges__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </span>
      <div class="trust-badges__text">
        <strong class="trust-badges__title">{{ 'homepage.pillars.original_title' | t }}</strong>
        <span class="trust-badges__subtitle">{{ 'homepage.pillars.original_text' | t }}</span>
      </div>
    </div>

    <div class="trust-badges__item">
      <span class="trust-badges__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
          <path d="M12 7v5l4 2"/>
        </svg>
      </span>
      <div class="trust-badges__text">
        <strong class="trust-badges__title">{{ 'homepage.pillars.returns_title' | t }}</strong>
        <span class="trust-badges__subtitle"><a href="/pages/returns-exchange-policy">{{ 'homepage.pillars.returns_text' | t }}</a></span>
      </div>
    </div>

  </div>
</div>

{% stylesheet %}
.trust-badges {
  padding-left: var(--page-width-padding, 1.5rem);
  padding-right: var(--page-width-padding, 1.5rem);
  margin: 0 auto;
  max-width: var(--page-width, 1200px);
}

.trust-badges__list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid rgba(60, 18, 23, 0.12);
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
}

.trust-badges__item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.125rem 1.25rem;
  background: transparent;
  transition: background 0.15s ease;
}

.trust-badges__item:not(:last-child) {
  border-bottom: 1px solid rgba(60, 18, 23, 0.08);
}

.trust-badges__icon {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3c1217;
  opacity: 0.75;
}

.trust-badges__icon svg {
  width: 1.5rem;
  height: 1.5rem;
}

.trust-badges__text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.trust-badges__title {
  font-weight: 600;
  font-size: 0.875rem;
  color: #22070a;
  line-height: 1.3;
  font-family: var(--font-body--family, inherit);
}

.trust-badges__subtitle {
  font-size: 0.775rem;
  color: rgba(60, 18, 23, 0.6);
  line-height: 1.4;
  font-family: var(--font-body--family, inherit);
}

/* ── Mobile: compact 3-column grid instead of tall stacked rows ── */
@media screen and (max-width: 749px) {
  .trust-badges__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 10px;
  }

  .trust-badges__item {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    text-align: center;
  }

  .trust-badges__item:not(:last-child) {
    border-bottom: none;
    border-right: 1px solid rgba(60, 18, 23, 0.08);
  }

  .trust-badges__icon {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.7;
  }

  .trust-badges__icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .trust-badges__text {
    align-items: center;
    gap: 0.1rem;
  }

  .trust-badges__title {
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .trust-badges__subtitle {
    display: none;
  }
}

@media screen and (min-width: 750px) {
  .trust-badges__list {
    flex-direction: row;
  }
  .trust-badges__item {
    flex: 1;
  }
  .trust-badges__item:not(:last-child) {
    border-bottom: none;
    border-right: 1px solid rgba(60, 18, 23, 0.08);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badges",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": []
}
{% endschema %}
