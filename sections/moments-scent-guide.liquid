{%- comment -%}
  "Understanding this scent": a plain-language guide on the product page for someone who knows nothing about perfume
  (owner request 2026-10-31). Follows the pattern of the big perfume sites (how the note pyramid unfolds, the scent
  family, the notes, when to wear it), in our own words. Built from the product tags written by scripts/fragrance-db.py
  (family:, note:, season:, time:) and the glossary in locales "scent" (data/scent-glossary.py), so it works for every
  product without per-product setup. The top/heart/base notes from the product's own metafields are shown when present.
{%- endcomment -%}

{%- comment -%}
  A set (several perfumes in one product, data/descriptions/sets.json) shows one panel per perfume, each from that
  perfume's own product, with a switcher (owner request 2026-11-06). Without JavaScript every panel is shown, one under another.
{%- endcomment -%}
{%- capture set_panels -%}{%- render 'moments-set-guide', product: product -%}{%- endcapture -%}
{%- if set_panels != blank -%}
  {%- assign panels = set_panels -%}
{%- else -%}
  {%- capture panels -%}{%- render 'scent-guide-panel', perfume: product -%}{%- endcapture -%}
{%- endif -%}

{%- if panels != blank -%}
  <section class="m-guide m-wrap" aria-labelledby="ScentGuide-{{ section.id }}">
    <div class="m-guide__head">
      <h2 class="m-guide__title" id="ScentGuide-{{ section.id }}">{{ 'scent.explain_title' | t }}</h2>
      <p class="m-guide__intro">{{ 'scent.explain_intro' | t }}</p>
    </div>
    {%- if set_panels != blank -%}
      <div class="m-guide__set" data-m-guide-set>{{ panels }}</div>
      <script>
        (() => {
          const set = document.currentScript.previousElementSibling;
          const panels = [...set.querySelectorAll('.m-guide__perfume[data-perfume]')];
          if (panels.length < 2) return;
          const list = document.createElement('div');
          list.className = 'm-guide__tabs';
          list.setAttribute('role', 'tablist');
          const show = (i, focus) => panels.forEach((panel, j) => {
            panel.hidden = i !== j;
            const tab = list.children[j];
            tab.setAttribute('aria-selected', String(i === j));
            tab.tabIndex = i === j ? 0 : -1;
            if (focus && i === j) tab.focus();
          });
          panels.forEach((panel, i) => {
            const id = set.closest('section').id + '-perfume-' + i;
            panel.id = id;
            panel.setAttribute('role', 'tabpanel');
            panel.classList.add('m-guide__perfume--tabbed');
            const tab = document.createElement('button');
            tab.type = 'button';
            tab.className = 'm-guide__tab';
            tab.setAttribute('role', 'tab');
            tab.setAttribute('aria-controls', id);
            tab.textContent = panel.dataset.perfume;
            tab.addEventListener('click', () => show(i, false));
            tab.addEventListener('keydown', (e) => {
              const rtl = getComputedStyle(list).direction === 'rtl';
              const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
              if (!step) return;
              e.preventDefault();
              show((i + step + panels.length) % panels.length, true);
            });
            list.appendChild(tab);
          });
          set.prepend(list);
          show(0, false);
        })();
      </script>
    {%- else -%}
      {{ panels }}
    {%- endif -%}
  </section>
  {%- comment -%}
    Hint near the buy button that the scent story is further down (owner request 2026-11-22; owner chose both): a card under
    the buy buttons, and a pulsing floating pill shown until the visitor reaches the notes.
  {%- endcomment -%}
  <template data-m-hint-tpl>
    <a class="m-hint" href="#ScentGuide-{{ section.id }}" data-m-hint-card>
      <span class="m-hint__imgs" data-m-hint-imgs></span>
      <span class="m-hint__text">
        <span class="m-hint__cta">{{ 'scent.hint_cta' | t }}</span>
        <span class="m-hint__notes" data-m-hint-notes></span>
      </span>
    </a>
    <a class="m-hintpill" href="#ScentGuide-{{ section.id }}" data-m-hint-pill hidden>
      {{- 'scent.hint_pill' | t -}}
    </a>
  </template>
  <script>
    (() => {
      const tpl = document.currentScript.previousElementSibling;
      const guide = tpl.previousElementSibling;
      const buy = document.querySelector('.product-information .buy-buttons-block, .buy-buttons-block');
      if (!guide || !buy) return;
      const frag = tpl.content.cloneNode(true);
      const card = frag.querySelector('[data-m-hint-card]');
      const pill = frag.querySelector('[data-m-hint-pill]');
      // scroll to whichever comes first on the page: the Scent Notes chips or this guide
      const sn = document.querySelector('.sn');
      const target = sn && sn.compareDocumentPosition(guide) & Node.DOCUMENT_POSITION_FOLLOWING ? sn : guide;
      const go = (e) => { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
      {
        // the perfume's own notes (named in the top/heart/base text) first, and only notes with a picture
        const own = [...guide.querySelectorAll('.m-guide__step-notes')].map((p) => p.textContent.toLowerCase()).join(' ');
        const notes = [...guide.querySelectorAll('.m-guide__note')].filter((li) => li.querySelector('img'))
          .map((li, i) => ({ li, i, name: li.querySelector('strong')?.textContent.trim() || '' }))
          .sort((a, b) => (own.includes(b.name.toLowerCase()) - own.includes(a.name.toLowerCase())) || a.i - b.i)
          .slice(0, 3);
        if (notes.length) notes.forEach(({ li }) => { const c = li.querySelector('img').cloneNode(); c.className = 'm-hint__img'; c.loading = 'eager'; card.querySelector('[data-m-hint-imgs]').append(c); });
        const sep = document.documentElement.lang.startsWith('ar') ? '، ' : ', ';
        card.querySelector('[data-m-hint-notes]').textContent = notes.map((n) => n.name).join(sep);
        if (notes.length) { card.addEventListener('click', go); buy.after(card); }
      }
      {
        // shown until the visitor reaches the notes; gone for good after that
        pill.addEventListener('click', go);
        document.body.append(pill);
        new IntersectionObserver(([e], io) => {
          const reached = e.isIntersecting || e.boundingClientRect.top < 0;
          pill.hidden = reached;
          if (reached) io.disconnect();
        }).observe(target);
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .m-hint {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-block-start: 16px;
    padding: 14px 16px;
    border: 1px solid var(--m-hairline, #E6DDE3);
    border-radius: 16px;
    background: #F7F3F5;
    color: var(--m-plum, #3B1E3A);
    text-decoration: none;
  }

  .m-hint:hover { border-color: var(--m-plum, #3B1E3A); }

  .m-hint__imgs { display: flex; flex: none; }

  .m-hint__img {
    inline-size: 44px;
    block-size: 44px;
    border: 2px solid #F7F3F5;
    border-radius: 50%;
    background: #fff;
    object-fit: cover;
  }

  .m-hint__img + .m-hint__img { margin-inline-start: -12px; }

  .m-hint__text { display: grid; gap: 2px; min-inline-size: 0; }

  .m-hint__notes {
    overflow: hidden;
    font-size: 0.8125rem;
    color: var(--m-text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .m-hint__cta { font-weight: 600; }

  .m-hintpill {
    position: fixed;
    inset-inline: 0;
    inset-block-end: calc(var(--m-tabbar-space, 0px) + 16px);
    z-index: 20;
    inline-size: max-content;
    margin-inline: auto;
    padding: 12px 20px;
    border-radius: 9999px;
    background: var(--m-plum, #3B1E3A);
    box-shadow: 0 10px 28px rgb(59 30 58 / 0.25);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .m-hintpill[hidden] { display: none; }

  /* a soft pulse ring so the pill catches the eye (owner request 2026-11-22) */
  .m-hintpill { animation: m-hint-pulse 2s ease-out infinite; }

  @keyframes m-hint-pulse {
    0% { box-shadow: 0 10px 28px rgb(59 30 58 / 0.25), 0 0 0 0 rgb(184 64 106 / 0.55); transform: scale(1); }
    15% { transform: scale(1.05); }
    30% { transform: scale(1); }
    70% { box-shadow: 0 10px 28px rgb(59 30 58 / 0.25), 0 0 0 14px rgb(184 64 106 / 0); }
    100% { box-shadow: 0 10px 28px rgb(59 30 58 / 0.25), 0 0 0 0 rgb(184 64 106 / 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-hintpill { animation: none; }
  }

  .m-guide__set {
    display: grid;
    gap: 32px;
  }

  .m-guide__perfume-name {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .m-guide__perfume--tabbed .m-guide__perfume-name {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .m-guide__perfume[hidden] {
    display: none;
  }

  .m-guide__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: -8px;
  }

  .m-guide__tab {
    min-block-size: 44px;
    padding-inline: 18px;
    border: 1px solid var(--m-rule-quiet, currentColor);
    border-radius: 9999px;
    background: transparent;
    color: var(--m-text);
    font: inherit;
    cursor: pointer;
  }

  .m-guide__tab[aria-selected='true'] {
    border-color: var(--m-plum, currentColor);
    background: var(--m-plum, currentColor);
    color: var(--m-pearl, #fff);
  }

  .m-guide__tab:focus-visible {
    outline: 2px solid var(--m-focus, currentColor);
    outline-offset: 2px;
  }

  .m-guide {
    padding-block: 48px;
    color: var(--m-text);
  }

  .m-guide__head {
    max-inline-size: 640px;
    margin-block-end: 24px;
  }

  .m-guide__title {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .m-guide__intro {
    margin: 0;
    color: var(--m-text-muted);
  }

  .m-guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .m-guide__card {
    padding: 22px;
    border: 1px solid var(--m-rule-quiet);
    border-radius: 16px;
    background: var(--m-surface, transparent);
  }

  .m-guide__card--notes {
    grid-column: span 2;
  }

  @media screen and (max-width: 749px) {
    .m-guide {
      padding-block: 32px;
    }

    .m-guide__card--notes {
      grid-column: auto;
    }
  }

  /* the card title is the quiet frame; what is particular to this perfume is the largest text in each card (owner 2026-11-09) */
  .m-guide__card h3 {
    margin: 0 0 18px;
    color: var(--m-text-muted);
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 0.9375rem;
  }

  .m-guide__list {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-guide__list--notes {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    column-gap: 28px;
  }

  /* a note beside a taller one stretches with its row: keep the description directly under its word (owner 2026-11-09) */
  .m-guide__list li {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  /* this perfume's own family, note, season or time: large, in the heading face */
  .m-guide__list strong,
  .m-guide__step-notes {
    color: var(--m-text);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  /* the general explanation, the same on every page: small and quiet */
  .m-guide__list span,
  .m-guide__step-text,
  .m-guide__skin {
    color: var(--m-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  html[lang='ar'] .m-guide__list strong,
  html[lang='ar'] .m-guide__step-notes {
    line-height: 1.35;
  }

  html[lang='ar'] .m-guide__list span,
  html[lang='ar'] .m-guide__step-text,
  html[lang='ar'] .m-guide__skin {
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media screen and (max-width: 749px) {
    .m-guide__list strong,
    .m-guide__step-notes {
      font-size: 1.25rem;
    }
  }

  .m-guide__pyramid {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-guide__step {
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 10px;
  }

  .m-guide__step p {
    grid-column: 2;
    margin: 0;
  }

  .m-guide__step-mark {
    grid-row: span 2;
    inline-size: 14px;
    block-size: 14px;
    margin-block-start: 8px;
    border-radius: 50%;
    background: var(--m-berry-600, currentColor);
  }

  .m-guide__step--top .m-guide__step-mark {
    opacity: 0.35;
  }

  .m-guide__step--heart .m-guide__step-mark {
    opacity: 0.65;
  }

  /* the perfume's own notes lead; the generic layer explanation sits quietly under them (owner request 2026-11-06) */
  .m-guide__step-notes + .m-guide__step-text {
    margin-block-start: 4px;
  }

  .m-guide__skin {
    margin: 14px 0 0;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS scent guide",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "MOMENTS scent guide" }]
}
{% endschema %}
