{%- comment -%}
  "Understanding this scent": a plain-language guide on the product page for someone who knows nothing about perfume
  (owner request 2026-10-31). Follows the pattern of the big perfume sites (how the note pyramid unfolds, the scent
  family, the notes, when to wear it), in our own words. Built from the product tags written by scripts/fragrance-db.py
  (family:, note:, season:, time:) and the glossary in locales "scent" (data/scent-glossary.py), so it works for every
  product without per-product setup. The top/heart/base notes from the product's own metafields are shown when present.
{%- endcomment -%}

{%- comment -%}
  A set (several perfumes in one product, data/descriptions/sets.json) shows one panel per perfume, each from that
  perfume's own product, with a switcher (owner request 2026-11-06). Without JavaScript every panel is shown, one under another.
{%- endcomment -%}
{%- capture set_panels -%}{%- render 'moments-set-guide', product: product -%}{%- endcapture -%}
{%- if set_panels != blank -%}
  {%- assign panels = set_panels -%}
{%- else -%}
  {%- capture panels -%}{%- render 'scent-guide-panel', perfume: product -%}{%- endcapture -%}
{%- endif -%}

{%- if panels != blank -%}
  <section class="m-guide m-wrap" aria-labelledby="ScentGuide-{{ section.id }}">
    <div class="m-guide__head">
      <h2 class="m-guide__title" id="ScentGuide-{{ section.id }}">{{ 'scent.explain_title' | t }}</h2>
      <p class="m-guide__intro">{{ 'scent.explain_intro' | t }}</p>
    </div>
    {%- if set_panels != blank -%}
      <div class="m-guide__set" data-m-guide-set>{{ panels }}</div>
      <script>
        (() => {
          const set = document.currentScript.previousElementSibling;
          const panels = [...set.querySelectorAll('.m-guide__perfume[data-perfume]')];
          if (panels.length < 2) return;
          const list = document.createElement('div');
          list.className = 'm-guide__tabs';
          list.setAttribute('role', 'tablist');
          const show = (i, focus) => panels.forEach((panel, j) => {
            panel.hidden = i !== j;
            const tab = list.children[j];
            tab.setAttribute('aria-selected', String(i === j));
            tab.tabIndex = i === j ? 0 : -1;
            if (focus && i === j) tab.focus();
          });
          panels.forEach((panel, i) => {
            const id = set.closest('section').id + '-perfume-' + i;
            panel.id = id;
            panel.setAttribute('role', 'tabpanel');
            panel.classList.add('m-guide__perfume--tabbed');
            const tab = document.createElement('button');
            tab.type = 'button';
            tab.className = 'm-guide__tab';
            tab.setAttribute('role', 'tab');
            tab.setAttribute('aria-controls', id);
            tab.textContent = panel.dataset.perfume;
            tab.addEventListener('click', () => show(i, false));
            tab.addEventListener('keydown', (e) => {
              const rtl = getComputedStyle(list).direction === 'rtl';
              const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
              if (!step) return;
              e.preventDefault();
              show((i + step + panels.length) % panels.length, true);
            });
            list.appendChild(tab);
          });
          set.prepend(list);
          show(0, false);
        })();
      </script>
    {%- else -%}
      {{ panels }}
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .m-guide__set {
    display: grid;
    gap: 32px;
  }

  .m-guide__perfume-name {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .m-guide__perfume--tabbed .m-guide__perfume-name {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .m-guide__perfume[hidden] {
    display: none;
  }

  .m-guide__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-end: -8px;
  }

  .m-guide__tab {
    min-block-size: 44px;
    padding-inline: 18px;
    border: 1px solid var(--m-rule-quiet, currentColor);
    border-radius: 9999px;
    background: transparent;
    color: var(--m-text);
    font: inherit;
    cursor: pointer;
  }

  .m-guide__tab[aria-selected='true'] {
    border-color: var(--m-plum, currentColor);
    background: var(--m-plum, currentColor);
    color: var(--m-pearl, #fff);
  }

  .m-guide__tab:focus-visible {
    outline: 2px solid var(--m-focus, currentColor);
    outline-offset: 2px;
  }

  .m-guide {
    padding-block: 48px;
    color: var(--m-text);
  }

  .m-guide__head {
    max-inline-size: 640px;
    margin-block-end: 24px;
  }

  .m-guide__title {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .m-guide__intro {
    margin: 0;
    color: var(--m-text-muted);
  }

  .m-guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .m-guide__card {
    padding: 22px;
    border: 1px solid var(--m-rule-quiet);
    border-radius: 16px;
    background: var(--m-surface, transparent);
  }

  .m-guide__card--notes {
    grid-column: span 2;
  }

  @media screen and (max-width: 749px) {
    .m-guide {
      padding-block: 32px;
    }

    .m-guide__card--notes {
      grid-column: auto;
    }
  }

  .m-guide__card h3 {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.125rem;
  }

  .m-guide__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-guide__list--notes {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .m-guide__list li {
    display: grid;
    gap: 2px;
  }

  .m-guide__list strong {
    font-weight: 600;
  }

  .m-guide__list span,
  .m-guide__pyramid p,
  .m-guide__skin {
    color: var(--m-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .m-guide__pyramid {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-guide__step {
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 10px;
  }

  .m-guide__step p {
    grid-column: 2;
    margin: 0;
  }

  .m-guide__step-mark {
    grid-row: span 2;
    inline-size: 14px;
    block-size: 14px;
    margin-block-start: 4px;
    border-radius: 50%;
    background: var(--m-berry-600, currentColor);
  }

  .m-guide__step--top .m-guide__step-mark {
    opacity: 0.35;
  }

  .m-guide__step--heart .m-guide__step-mark {
    opacity: 0.65;
  }

  /* the perfume's own notes lead; the generic layer explanation sits quietly under them (owner request 2026-11-06) */
  .m-guide__step-notes {
    color: var(--m-text) !important;
    font-size: 1.0625rem !important;
    font-weight: 600;
    line-height: 1.4;
  }

  .m-guide__pyramid .m-guide__step-text {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .m-guide__step-notes + .m-guide__step-text {
    margin-block-start: 2px;
  }

  .m-guide__skin {
    margin: 14px 0 0;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS scent guide",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "MOMENTS scent guide" }]
}
{% endschema %}
