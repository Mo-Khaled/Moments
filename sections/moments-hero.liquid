{%- comment -%}
  Homepage hero: edge to edge, one slide per moment (Night, Gift, All day, Daily, Fresh, Love), added as editor blocks.
  The page opens on the moment that matches the visitor's local hour, and the active moment sets the page accent
  (html[data-moment] drives --m-live in assets/moments.css). A switcher lets the visitor change it.

  How the first paint stays clean: an inline script at the top of this section picks the moment from the hour and sets
  html[data-moment] before any slide is parsed. Without JavaScript the first block is shown. Only the active slide is displayed
  (display: none on the others, so their images and videos are not fetched). The first block's poster is the preloaded
  LCP image (fetchpriority high); the active slide's poster is promoted to eager if it is another one.

  Slide media: a video (desktop only, loaded after the poster paints, paused off screen and in a hidden tab) over a poster.
  Phones, Save-Data and reduced motion get the poster only. A slide with no video and no poster is a moment gradient, the large
  Moment mark and an optional packshot (object-fit contain, never cropped), with a very slow transform-only drift.
  Posters shot as a square photograph use "Fit": the whole photo is shown at the end side over a blurred copy of itself, so the
  bottle is never cropped. A 16:9 photograph or video uses "Fill".

  EXPERIMENTAL: the All day slide uses the Island Sun Khadlaj photo from Files until real footage exists.
{%- endcomment -%}

{%- liquid
  assign cfg_override = section.settings.override
-%}

<section class="m-hero" data-m-hero data-autoplay="{{ section.settings.autoplay_seconds | default: 6 }}" aria-label="{{ 'homepage.hero.label' | t }}" style="--m-hero-scrim: {{ section.settings.scrim_strength }}%">
  <script type="application/json" data-m-hero-config>
    {
      "override": {{ cfg_override | json }},
      "slides": [
        {%- for block in section.blocks -%}
          { "moment": {{ block.settings.moment | json }}, "from": {{ block.settings.from_hour }}, "to": {{ block.settings.to_hour }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script>
    (function () {
      try {
        var cfg = JSON.parse(document.currentScript.previousElementSibling.textContent);
        if (!cfg.slides.length) return;
        var hour = typeof window.__MOMENTS_HOUR__ === 'number' ? window.__MOMENTS_HOUR__ : new Date().getHours();
        var has = function (m) { return cfg.slides.some(function (s) { return s.moment === m; }); };
        var pick = cfg.override && cfg.override !== 'auto' && has(cfg.override) ? cfg.override : null;
        if (!pick) { try { var saved = sessionStorage.getItem('mMoment'); if (saved && has(saved)) pick = saved; } catch (e) {} }
        if (!pick) {
          cfg.slides.forEach(function (s) {
            if (pick || s.from === s.to) return;
            var inside = s.from < s.to ? hour >= s.from && hour < s.to : hour >= s.from || hour < s.to;
            if (inside) pick = s.moment;
          });
        }
        var root = document.documentElement;
        root.dataset.moment = pick || cfg.slides[0].moment;
        root.classList.add('m-js');
      } catch (e) {}
    })();
  </script>

  <div class="m-hero__stage">
    {%- for block in section.blocks -%}
      {%- liquid
        assign key = block.settings.moment
        assign tint = block.settings.tint
        if tint == 'moment' or tint == blank
          assign tint = key
        endif
        case key
          when 'night'
            assign label = 'moments.night' | t
          when 'gift'
            assign label = 'moments.gift' | t
          when 'allday'
            assign label = 'moments.all_day' | t
          when 'daily'
            assign label = 'moments.daily' | t
          when 'fresh'
            assign label = 'moments.fresh' | t
          when 'occasions'
            assign label = 'moments.occasions' | t
          when 'winter'
            assign label = 'moments.winter' | t
          else
            assign label = 'moments.love' | t
        endcase

        assign headline = block.settings.headline
        assign subline = block.settings.subline
        assign primary_label = block.settings.primary_label
        assign secondary_label = block.settings.secondary_label
        case key
          when 'night'
            if headline == blank
              assign headline = 'homepage.hero.slides.night.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.night.text' | t
            endif
          when 'gift'
            if headline == blank
              assign headline = 'homepage.hero.slides.gift.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.gift.text' | t
            endif
          when 'allday'
            if headline == blank
              assign headline = 'homepage.hero.slides.allday.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.allday.text' | t
            endif
          when 'daily'
            if headline == blank
              assign headline = 'homepage.hero.slides.daily.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.daily.text' | t
            endif
          when 'fresh'
            if headline == blank
              assign headline = 'homepage.hero.slides.fresh.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.fresh.text' | t
            endif
          when 'occasions'
            if headline == blank
              assign headline = 'homepage.hero.slides.occasions.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.occasions.text' | t
            endif
          when 'winter'
            if headline == blank
              assign headline = 'homepage.hero.slides.winter.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.winter.text' | t
            endif
          else
            if headline == blank
              assign headline = 'homepage.hero.slides.love.headline' | t
            endif
            if subline == blank
              assign subline = 'homepage.hero.slides.love.text' | t
            endif
        endcase
        if primary_label == blank
          assign primary_label = 'homepage.hero.shop_moment' | t: moment: label
        endif
        if secondary_label == blank
          assign secondary_label = 'homepage.hero.link'  | t
        endif

        assign poster = block.settings.poster
        if poster == blank and key == 'allday'
          assign poster = images['island-sun-grid_05.png']
        endif
        assign poster_m = block.settings.poster_mobile
        assign video = block.settings.video
        assign video_mobile = block.settings.video_mobile
        assign poster_loading = 'lazy'
        assign poster_priority = 'auto'
        if forloop.first
          assign poster_loading = 'eager'
          assign poster_priority = 'high'
        endif
      -%}

      <article
        class="m-slide m-tone--{{ tint }}{% if poster != blank and block.settings.poster_fit == 'fill' %} m-slide--photo{% endif %}"
        data-moment="{{ key }}"
        data-subject="{{ block.settings.subject_side | default: 'right' }}"
        data-has-video="{% if video != blank %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="m-slide__bg" aria-hidden="true"></div>

        {%- if poster != blank -%}
          <div class="m-slide__media m-slide__media--{{ block.settings.poster_fit }}" aria-hidden="true">
            {%- if block.settings.poster_fit == 'fit' -%}
              {{
                poster
                | image_url: width: 480
                | image_tag: class: 'm-slide__blur', loading: 'lazy', alt: '', widths: '480'
              }}
            {%- endif -%}
            {%- if poster_m != blank and block.settings.poster_fit == 'fill' -%}
              <picture style="display: contents">
                <source media="(max-width: 749px)" srcset="{{ poster_m | image_url: width: 780 }} 780w, {{ poster_m | image_url: width: 1170 }} 1170w" sizes="100vw">
            {%- endif -%}
            {{
              poster
              | image_url: width: 2000
              | image_tag:
                class: 'm-slide__poster',
                alt: '',
                widths: '768, 1280, 1920, 2560',
                sizes: '100vw',
                loading: poster_loading,
                fetchpriority: poster_priority
            }}
            {%- if poster_m != blank and block.settings.poster_fit == 'fill' -%}
              </picture>
            {%- endif -%}
            {%- if video != blank -%}
              <video
                class="m-slide__video"
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
                data-desktop-src="{% for source in video.sources %}{% if source.format == 'mp4' %}{{ source.url }}{% endif %}{% endfor %}"
                {% if video_mobile != blank %}
                  data-mobile-src="{% for source in video_mobile.sources %}{% if source.format == 'mp4' %}{{ source.url }}{% endif %}{% endfor %}"
                {% endif %}
              ></video>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="m-slide__art" aria-hidden="true">
            {% render 'moment-mark', mark: key, size: 'lg' %}
          </div>
        {%- endif -%}

        {%- if block.settings.packshot != blank -%}
          {{
            block.settings.packshot
            | image_url: width: 1000
            | image_tag: class: 'm-slide__packshot', alt: block.settings.packshot_alt, loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 40vw, 70vw'
          }}
        {%- endif -%}

        <div class="m-slide__scrim" aria-hidden="true"></div>

        <div class="m-slide__copy m-wrap">
          <p class="m-slide__tag">{{ label }}</p>
          <div class="m-slide__title" role="heading" aria-level="1">{{ headline }}</div>
          <p class="m-slide__text">{{ subline }}</p>
          <div class="m-slide__actions">
            <a class="m-btn" href="{{ block.settings.primary_url | default: routes.collections_url }}">{{ primary_label }}</a>
            {%- if block.settings.secondary_label != blank and block.settings.secondary_url != blank -%}
              <a class="m-btn m-btn--outline" href="{{ block.settings.secondary_url }}">{{ secondary_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  <div class="m-hero__controls m-wrap">
    <div class="m-switch" role="group" aria-label="{{ 'homepage.hero.switcher' | t }}">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.moment
            when 'night'
              assign label = 'moments.night' | t
            when 'gift'
              assign label = 'moments.gift' | t
            when 'allday'
              assign label = 'moments.all_day' | t
            when 'daily'
              assign label = 'moments.daily' | t
            when 'fresh'
              assign label = 'moments.fresh' | t
            when 'occasions'
              assign label = 'moments.occasions' | t
            when 'winter'
              assign label = 'moments.winter' | t
            else
              assign label = 'moments.love' | t
          endcase
        -%}
        <button class="m-switch__btn" type="button" data-moment-switch="{{ block.settings.moment }}" aria-pressed="false">
          {% render 'moment-mark', mark: block.settings.moment, size: 'sm', class: 'm-switch__mark' %}
          <span class="m-switch__label">{{ label }}</span>
        </button>
      {%- endfor -%}
    </div>

    <div class="m-playback" data-m-playback hidden>
      <button class="m-playback__btn" type="button" data-m-pause aria-pressed="false" aria-label="{{ 'homepage.hero.pause' | t }}" data-label-pause="{{ 'homepage.hero.pause' | t }}" data-label-play="{{ 'homepage.hero.play' | t }}">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <g data-icon-pause fill="currentColor"><rect x="3" y="2" width="3.5" height="12"/><rect x="9.5" y="2" width="3.5" height="12"/></g>
          <path data-icon-play fill="currentColor" d="M4 2l10 6-10 6z" hidden/>
        </svg>
      </button>
      <button class="m-playback__btn" type="button" data-m-mute aria-pressed="true" aria-label="{{ 'homepage.hero.unmute' | t }}" data-label-mute="{{ 'homepage.hero.mute' | t }}" data-label-unmute="{{ 'homepage.hero.unmute' | t }}">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M2 6v4h3l4 3V3L5 6z"/>
          <path data-icon-on fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M11.5 5.5a3.5 3.5 0 0 1 0 5" hidden/>
          <path data-icon-off fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M11 6l4 4M15 6l-4 4"/>
        </svg>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  .m-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--m-surface);
    color: var(--m-text);
    block-size: max(520px, 75svh);
  }

  .m-hero__stage,
  .m-slide {
    position: absolute;
    inset: 0;
  }

  /* Only the active slide is displayed, so the others cost nothing. No JavaScript: the first slide. */
  .m-slide {
    display: none;
  }

  html:not(.m-js) .m-slide:first-child,
  html[data-moment='night'] .m-slide[data-moment='night'],
  html[data-moment='gift'] .m-slide[data-moment='gift'],
  html[data-moment='allday'] .m-slide[data-moment='allday'],
  html[data-moment='daily'] .m-slide[data-moment='daily'],
  html[data-moment='fresh'] .m-slide[data-moment='fresh'],
  html[data-moment='winter'] .m-slide[data-moment='winter'],
  html[data-moment='love'] .m-slide[data-moment='love'] {
    display: block;
    opacity: 1;
    transition: opacity var(--m-dur-3) var(--m-ease), display var(--m-dur-3) allow-discrete;

    @starting-style {
      opacity: 0;
    }
  }

  /* Without JavaScript only the first slide may show, even if an html[data-moment] value was set. */
  .m-slide__bg {
    position: absolute;
    inset: 0;
    background: transparent; /* white page (2026-11-20): the moment shows in its mark, not as a full-bleed colour */
    transform-origin: 70% 60%;
  }

  .m-slide__art {
    /* On white: plum line, the moment's mid tone as the body, the moment's deep colour (--m-live, set for the active slide) as accent */
    --m-mark-ink: var(--m-plum);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--m-live);
    --m-mark-gold: var(--m-live);

    position: absolute;
    inset-block-end: 16%;
    inset-inline-end: var(--m-gutter);
  }

  /* The moment's mark at full contrast, on the end side, clear of the headline. */
  .m-slide__art moment-mark {
    --mm-size: min(38vw, 520px);
  }

  .m-slide__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .m-slide__poster,
  .m-slide__video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Fit: the whole photograph at the end side, over a blurred copy of itself. Nothing is cropped. */
  .m-slide__media--fit .m-slide__blur {
    position: absolute;
    inset: -8%;
    inline-size: 116%;
    block-size: 116%;
    object-fit: cover;
    filter: blur(32px) saturate(1.1);
    opacity: 0; /* white page: the photograph sits on white, no blurred field behind it */
  }

  .m-slide__media--fit .m-slide__poster {
    inset-inline-start: auto;
    inline-size: auto;
    aspect-ratio: 1 / 1;
    max-inline-size: 100%;
    object-fit: contain;
  }

  .m-slide__video {
    opacity: 0;
    transition: opacity var(--m-dur-3) var(--m-ease);
  }

  .m-slide__video[data-playing] {
    opacity: 1;
  }

  .m-slide__packshot {
    position: absolute;
    inset-block-end: 6%;
    inset-inline-end: calc(var(--m-gutter) + 4vw);
    inline-size: auto;
    block-size: 64%;
    max-inline-size: 42%;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgb(37 18 36 / 0.28));
  }

  /* White page (2026-11-20): no scrim, the copy sits on white beside the mark or photograph. */
  .m-slide__scrim {
    display: none;
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(37 18 36 / calc(var(--m-hero-scrim, 78%) + 8%)) 0%, rgb(37 18 36 / 0.45) 38%, rgb(37 18 36 / 0) 70%),
      linear-gradient(to right, rgb(37 18 36 / 0.5), rgb(37 18 36 / 0) 62%);
  }

  html[dir='rtl'] .m-slide__scrim {
    background:
      linear-gradient(to top, rgb(37 18 36 / calc(var(--m-hero-scrim, 78%) + 8%)) 0%, rgb(37 18 36 / 0.45) 38%, rgb(37 18 36 / 0) 70%),
      linear-gradient(to left, rgb(37 18 36 / 0.5), rgb(37 18 36 / 0) 62%);
  }

  .m-slide__copy {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    justify-items: start;
    gap: 16px;
    margin-inline: auto;
    padding-block-end: 112px;
    color: var(--m-text);
  }

  .m-slide__tag {
    margin: 0;
    padding: 6px 14px;
    border: 1px solid currentcolor;
    border-radius: 9999px;
    font-size: 0.8125rem;
    line-height: 1;
  }

  .m-slide__title {
    max-inline-size: min(100%, 7em);
    font-family: var(--font-heading--family);
    font-size: var(--m-h1);
    line-height: 0.98;
    text-wrap: balance;
  }

  .m-slide__text {
    margin: 0;
    max-inline-size: 38ch;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .m-hero .m-btn--outline {
    color: var(--m-plum);
  }

  .m-hero .m-btn--outline:hover {
    background: var(--m-plum);
    color: var(--m-pearl);
  }

  .m-slide__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 8px;
  }

  html[lang='ar'] .m-slide__title {
    line-height: 1.3;
    max-inline-size: min(100%, 6em);
  }

  html[lang='ar'] .m-slide__text {
    line-height: 1.7;
  }

  /* Controls: moment switcher at the start edge, playback at the end edge. */
  .m-hero__controls {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-inline: auto;
  }

  .m-switch {
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid rgb(59 30 58 / 0.18);
    border-radius: 9999px;
    background: var(--m-surface);
  }

  .m-switch__btn {
    --m-mark-ink: var(--m-plum);
    --m-mark-body: transparent;
    --m-mark-accent: var(--m-berry-ink);
    --m-mark-gold: var(--m-berry-ink);
    --mm-size: 22px;

    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    min-inline-size: 44px;
    justify-content: center;
    padding-inline: 10px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--m-plum);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background-color var(--m-dur-2) var(--m-ease), color var(--m-dur-2) var(--m-ease);
  }

  /* Phones: icons only, the name is still read by screen readers. Desktop: every label is visible. */
  .m-switch__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .m-switch__btn[aria-pressed='true'] {
    background: var(--m-plum);
    color: var(--m-pearl);
    --m-mark-ink: var(--m-pearl);
    --m-mark-body: transparent;
    --m-mark-accent: var(--m-nude);
    --m-mark-gold: var(--m-nude);
  }

  .m-switch__btn[aria-pressed='true'] .m-switch__label {
    position: static;
    inline-size: auto;
    block-size: auto;
    margin: 0;
    clip-path: none;
  }

  .m-switch__btn:focus-visible,
  .m-playback__btn:focus-visible {
    outline: 2px solid var(--m-focus);
    outline-offset: 2px;
  }

  .m-playback {
    display: flex;
    gap: 8px;
  }

  .m-playback[hidden] {
    display: none;
  }

  .m-playback__btn {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 1px solid rgb(59 30 58 / 0.3);
    border-radius: 9999px;
    background: var(--m-surface);
    color: var(--m-plum);
    cursor: pointer;
  }

  /* Very slow transform-only drift on slides without a video. */
  @media (prefers-reduced-motion: no-preference) {
    .m-slide[data-has-video='false'] .m-slide__bg,
    .m-slide[data-has-video='false'] .m-slide__poster,
    .m-slide[data-has-video='false'] .m-slide__art {
      animation: m-hero-drift 36s ease-in-out infinite alternate;
    }

    .m-hero[data-paused] .m-slide__bg,
    .m-hero[data-paused] .m-slide__poster,
    .m-hero[data-paused] .m-slide__art {
      animation-play-state: paused;
    }
  }

  @keyframes m-hero-drift {
    to {
      transform: scale(1.06) translate3d(-1%, -1%, 0);
    }
  }

  @media screen and (min-width: 750px) {
    .m-hero {
      block-size: clamp(540px, 74svh, 780px); /* white page (2026-11-20): shorter, no colour field to fill */
    }

    .m-slide__copy {
      padding-block-end: 120px;
    }

    .m-switch__btn {
      min-block-size: 44px;
      padding-inline: 14px;
    }

    .m-switch__btn .m-switch__label {
      position: static;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      clip-path: none;
    }

    .m-switch__btn {
      font-size: 0.875rem;
    }
  }

  @media screen and (max-width: 749px) {
    /* Phones: the icon bar sits in the middle; the stage takes horizontal swipes, the page keeps vertical scroll. */
    .m-hero__controls {
      justify-content: center;
    }

    .m-hero {
      touch-action: pan-y;
    }

    .m-slide__copy {
      padding-block-end: 96px;
    }

    .m-slide__media--fit .m-slide__poster {
      inset-inline-start: 0;
      inline-size: 100%;
      block-size: 62%;
    }

    .m-slide__art {
      inset-block-start: 0;
      inset-block-end: auto;
    }

    .m-slide__art moment-mark {
      --mm-size: min(30vw, 112px);
    }

    .m-slide__packshot {
      block-size: 40%;
      inset-block-end: 30%;
    }
  }
  .m-slide--photo .m-slide__scrim { display: block; }

  /* Photo slides on desktop (2026-11-20): the text sits on the side AWAY from the product, in both languages. The side is a physical
     one (the photo is not mirrored in Arabic), so "start"/"end" are chosen per direction. Arabic keeps right-aligned text inside the
     box. The photo keeps the product in frame at every width (object-position on the product's side) and the scrim darkens the text side. */
  @media screen and (min-width: 750px) {
    .m-slide--photo[data-subject='right'] .m-slide__poster { object-position: 70% 50%; }
    .m-slide--photo[data-subject='left'] .m-slide__poster { object-position: 30% 50%; }

    /* text on the physical left (English already starts there) */
    html[dir='rtl'] .m-slide--photo[data-subject='right'] .m-slide__copy {
      justify-items: end;
    }

    html[dir='rtl'] .m-slide--photo[data-subject='right'] .m-slide__copy > * {
      text-align: right;
    }

    /* text on the physical right */
    html:not([dir='rtl']) .m-slide--photo[data-subject='left'] .m-slide__copy {
      justify-items: end;
      text-align: left;
    }

    /* centered product: text centered, the scrim is the bottom fade only */
    .m-slide--photo[data-subject='center'] .m-slide__copy {
      justify-items: center;
      text-align: center;
    }

    .m-slide--photo[data-subject='right'] .m-slide__scrim,
    html[dir='rtl'] .m-slide--photo[data-subject='right'] .m-slide__scrim {
      background:
        linear-gradient(to top, rgb(37 18 36 / calc(var(--m-hero-scrim, 78%) + 8%)) 0%, rgb(37 18 36 / 0.3) 34%, rgb(37 18 36 / 0) 60%),
        linear-gradient(to right, rgb(37 18 36 / 0.62), rgb(37 18 36 / 0) 58%);
    }

    .m-slide--photo[data-subject='left'] .m-slide__scrim,
    html[dir='rtl'] .m-slide--photo[data-subject='left'] .m-slide__scrim {
      background:
        linear-gradient(to top, rgb(37 18 36 / calc(var(--m-hero-scrim, 78%) + 8%)) 0%, rgb(37 18 36 / 0.3) 34%, rgb(37 18 36 / 0) 60%),
        linear-gradient(to left, rgb(37 18 36 / 0.62), rgb(37 18 36 / 0) 58%);
    }

    .m-slide--photo[data-subject='center'] .m-slide__scrim {
      background: linear-gradient(to top, rgb(37 18 36 / calc(var(--m-hero-scrim, 78%) + 8%)) 0%, rgb(37 18 36 / 0.4) 40%, rgb(37 18 36 / 0) 70%);
    }
  }
  .m-slide--photo .m-slide__copy, .m-slide--photo .m-slide__title, .m-slide--photo .m-slide__text, .m-slide--photo .m-slide__tag { color: #fff; }
  .m-slide--photo .m-btn--outline { color: #fff; border-color: #fff; }
  .m-slide--photo .m-btn--outline:hover { background: #fff; color: var(--m-plum); }

  /* Phones: the moment switcher becomes pagination dots (the active one is a longer pill). */
  @media screen and (max-width: 749px) {
    .m-switch {
      gap: 0;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .m-switch__btn {
      position: relative;
      min-inline-size: 26px;
      min-block-size: 44px;
      padding: 0;
      background: transparent;
    }

    .m-switch__btn > :not(.m-switch__label) {
      display: none;
    }

    .m-switch__btn .m-switch__label,
    .m-switch__btn[aria-pressed='true'] .m-switch__label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      clip-path: inset(50%);
    }

    .m-switch__btn::before {
      content: '';
      inline-size: 8px;
      block-size: 8px;
      border-radius: 9999px;
      background: rgb(59 30 58 / 0.28);
      transition: inline-size var(--m-dur-2) var(--m-ease), background-color var(--m-dur-2) var(--m-ease);
    }

    .m-switch__btn[aria-pressed='true'] {
      background: transparent;
    }

    .m-switch__btn[aria-pressed='true']::before {
      inline-size: 22px;
      background: var(--m-plum);
    }

  }

  /* Phones: copy sits lower and smaller, so the photograph keeps the stage. */
  @media screen and (max-width: 749px) {
    .m-slide__copy {
      gap: 10px;
      padding-block-end: 50px;
    }

    .m-slide__tag {
      padding: 5px 12px;
      font-size: 0.6875rem;
    }

    .m-slide__title {
      max-inline-size: 100%;
      font-size: clamp(1.625rem, 8vw, 2rem);
      line-height: 1.02;
    }

    .m-slide__text {
      max-inline-size: 34ch;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .m-slide__actions .m-btn {
      min-block-size: 40px;
      padding-inline: 20px;
      font-size: 0.875rem;
    }

    .m-hero__controls {
      inset-block-end: 4px;
    }

    html[data-moment='winter'] .m-switch__btn::before {
      background: rgb(255 255 255 / 0.4);
    }

    html[data-moment='winter'] .m-switch__btn[aria-pressed='true']::before {
      background: #fff;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const hero = document.querySelector('[data-m-hero]');
    if (!hero) return;

    const root = document.documentElement;
    const slides = [...hero.querySelectorAll('.m-slide')];
    const switches = [...hero.querySelectorAll('[data-moment-switch]')];
    const playback = hero.querySelector('[data-m-playback]');
    const pauseBtn = hero.querySelector('[data-m-pause]');
    const muteBtn = hero.querySelector('[data-m-mute]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = !!(navigator.connection && navigator.connection.saveData);
    const desktop = window.matchMedia('(min-width: 750px)');
    const state = { paused: false, muted: true, visible: true, tabVisible: !document.hidden };

    const activeSlide = () => slides.find((s) => s.dataset.moment === root.dataset.moment) || slides[0];
    const videoOf = (slide) => slide && slide.querySelector('.m-slide__video');

    const loadVideo = (video) => {
      if (!video || video.dataset.loaded || reduced || saveData) return false;
      const src = desktop.matches ? video.dataset.desktopSrc : video.dataset.mobileSrc;
      if (!src) return false;
      video.dataset.loaded = 'true';
      video.preload = 'metadata';
      video.src = src;
      return true;
    };

    const syncPlayback = () => {
      slides.forEach((slide) => {
        const video = videoOf(slide);
        if (!video || !video.dataset.loaded) return;
        const shouldPlay = slide === activeSlide() && !state.paused && state.visible && state.tabVisible;
        if (shouldPlay) {
          video.play().then(() => video.setAttribute('data-playing', '')).catch(() => {});
        } else {
          video.pause();
        }
      });
      hero.toggleAttribute('data-paused', state.paused || !state.visible || !state.tabVisible);
    };

    const activate = (moment, user) => {
      root.dataset.moment = moment;
      if (user) { try { sessionStorage.setItem('mMoment', moment); } catch (e) {} }
      slides.forEach((slide) => {
        const on = slide.dataset.moment === moment;
        slide.toggleAttribute('inert', !on);
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
        if (on) {
          const poster = slide.querySelector('.m-slide__poster');
          if (poster && poster.loading === 'lazy') { poster.loading = 'eager'; poster.fetchPriority = 'high'; }
          const blur = slide.querySelector('.m-slide__blur');
          if (blur) blur.loading = 'eager';
          const packshot = slide.querySelector('.m-slide__packshot');
          if (packshot) packshot.loading = 'eager';
        }
      });
      switches.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.momentSwitch === moment)));
      const slide = activeSlide();
      const video = videoOf(slide);
      if (video && !video.dataset.loaded) {
        // Desktop video starts only after the poster has painted.
        const start = () => { if (loadVideo(video)) syncPlayback(); };
        const poster = slide.querySelector('.m-slide__poster');
        if (poster && !poster.complete) poster.addEventListener('load', () => requestAnimationFrame(start), { once: true });
        else requestAnimationFrame(() => setTimeout(start, 200));
      }
      if (playback) playback.hidden = !(video && video.dataset.desktopSrc && !reduced && !saveData);
      syncPlayback();
    };

    // Phones: the moments advance on their own and follow a horizontal swipe (owner request 2026-11-06).
    // Never with reduced motion; held while a finger or focus is on the hero, off screen or in a hidden tab.
    const autoplayMs = (parseFloat(hero.dataset.autoplay) || 0) * 1000;
    const rtl = document.dir === 'rtl' || root.dir === 'rtl';
    let timer = 0;
    let held = false;

    const step = (dir) => {
      const i = slides.indexOf(activeSlide());
      const next = slides[(i + dir + slides.length) % slides.length];
      if (next) activate(next.dataset.moment, false);
    };

    const schedule = () => {
      clearTimeout(timer);
      if (!autoplayMs || reduced || desktop.matches || slides.length < 2) return;
      if (held || !state.visible || !state.tabVisible) return;
      timer = setTimeout(() => { step(1); schedule(); }, autoplayMs);
    };

    let startX = 0;
    let startY = 0;
    let tracking = false;
    hero.addEventListener('touchstart', (e) => {
      if (desktop.matches || e.touches.length !== 1) return;
      tracking = true;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      held = true;
      clearTimeout(timer);
    }, { passive: true });
    hero.addEventListener('touchend', (e) => {
      held = false;
      if (tracking) {
        tracking = false;
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) step((dx < 0) !== rtl ? 1 : -1);
      }
      schedule();
    }, { passive: true });
    hero.addEventListener('touchcancel', () => { tracking = false; held = false; schedule(); }, { passive: true });
    hero.addEventListener('focusin', () => { held = true; clearTimeout(timer); });
    hero.addEventListener('focusout', (e) => { if (!hero.contains(e.relatedTarget)) { held = false; schedule(); } });

    switches.forEach((btn) => btn.addEventListener('click', () => { activate(btn.dataset.momentSwitch, true); schedule(); }));

    if (pauseBtn) {
      pauseBtn.addEventListener('click', () => {
        state.paused = !state.paused;
        pauseBtn.setAttribute('aria-pressed', String(state.paused));
        pauseBtn.setAttribute('aria-label', state.paused ? pauseBtn.dataset.labelPlay : pauseBtn.dataset.labelPause);
        pauseBtn.querySelector('[data-icon-pause]').toggleAttribute('hidden', state.paused);
        pauseBtn.querySelector('[data-icon-play]').toggleAttribute('hidden', !state.paused);
        syncPlayback();
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        state.muted = !state.muted;
        slides.forEach((slide) => { const v = videoOf(slide); if (v) v.muted = state.muted; });
        muteBtn.setAttribute('aria-pressed', String(state.muted));
        muteBtn.setAttribute('aria-label', state.muted ? muteBtn.dataset.labelUnmute : muteBtn.dataset.labelMute);
        muteBtn.querySelector('[data-icon-on]').toggleAttribute('hidden', state.muted);
        muteBtn.querySelector('[data-icon-off]').toggleAttribute('hidden', !state.muted);
      });
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        state.visible = entries.some((entry) => entry.isIntersecting);
        syncPlayback();
        schedule();
      }, { threshold: 0.15 }).observe(hero);
    }

    document.addEventListener('visibilitychange', () => { state.tabVisible = !document.hidden; syncPlayback(); schedule(); });
    desktop.addEventListener('change', () => { activate(root.dataset.moment, false); schedule(); });

    activate(root.dataset.moment || (slides[0] && slides[0].dataset.moment), false);
    schedule();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "MOMENTS hero",
  "tag": "div",
  "class": "m-hero-section",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "override",
      "label": "Opening moment",
      "info": "Auto picks the moment from the visitor's local hour (each slide's hours). Choose one to run a campaign.",
      "options": [
        { "value": "auto", "label": "Auto (by local hour)" },
        { "value": "night", "label": "Evening out" },
        { "value": "gift", "label": "Gift" },
        { "value": "allday", "label": "All day" },
        { "value": "daily", "label": "Office" },
        { "value": "fresh", "label": "Summer heat" },
        { "value": "love", "label": "Date night" },
        { "value": "occasions", "label": "Weddings & Eid" },
        { "value": "winter", "label": "Winter nights" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "scrim_strength",
      "label": "Text scrim strength",
      "info": "Darkens the bottom of the slide so the headline stays readable. Keep it at 70% or more.",
      "min": 60,
      "max": 90,
      "step": 2,
      "unit": "%",
      "default": 74
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Phones: next moment every",
      "info": "Phones only. Swiping or tapping an icon restarts the count. 0 turns it off.",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Moment slide",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "moment",
          "label": "Moment",
          "options": [
            { "value": "night", "label": "Evening out" },
            { "value": "gift", "label": "Gift" },
            { "value": "allday", "label": "All day" },
            { "value": "daily", "label": "Office" },
            { "value": "fresh", "label": "Summer heat" },
            { "value": "love", "label": "Date night" },
            { "value": "occasions", "label": "Weddings & Eid" },
            { "value": "winter", "label": "Winter nights" }
          ],
          "default": "night"
        },
        { "type": "range", "id": "from_hour", "label": "Opens from hour", "info": "Local hour, 0 to 23. Leave From and To equal to keep this moment out of the automatic rotation.", "min": 0, "max": 23, "step": 1, "default": 0 },
        { "type": "range", "id": "to_hour", "label": "Until hour", "info": "Up to, not including. A range that wraps midnight is fine (18 to 5).", "min": 0, "max": 23, "step": 1, "default": 0 },
        { "type": "header", "content": "Video and poster" },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Muted loop, 6 to 12 seconds, 1920x1080, H.264, under 4 MB. Plays on desktop only, after the poster. EXPERIMENTAL footage is marked in docs/assets/image-credits.md."
        },
        { "type": "video", "id": "video_mobile", "label": "Mobile video (optional)", "info": "9:16. Not used on phones yet: phones show the poster." },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "The first thing shown and the LCP image. The All day slide falls back to the Island Sun Khadlaj photo (EXPERIMENTAL placeholder)." },
        { "type": "image_picker", "id": "poster_mobile", "label": "Mobile poster (optional)", "info": "Used on phones only, with Poster fit set to Fill. 1170x1920 (about 9:16). Desktop keeps the main poster." },
        {
          "type": "select",
          "id": "subject_side",
          "label": "Product position in the photo",
          "info": "Desktop: the text goes on the other side, in English and in Arabic, so it never covers the product. Phones put the text under the photo.",
          "options": [
            { "value": "right", "label": "Right" },
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" }
          ],
          "default": "right"
        },
        {
          "type": "select",
          "id": "poster_fit",
          "label": "Poster fit",
          "info": "Fit shows the whole photo, never cropped (square photos, bottle shots). Fill is for 16:9 photography.",
          "options": [
            { "value": "fit", "label": "Fit (whole photo)" },
            { "value": "fill", "label": "Fill (edge to edge)" }
          ],
          "default": "fit"
        },
        { "type": "image_picker", "id": "packshot", "label": "Bottle packshot (optional)", "info": "Shown uncropped. Use a clean, transparent or evenly backed image." },
        { "type": "text", "id": "packshot_alt", "label": "Packshot description" },
        {
          "type": "select",
          "id": "tint",
          "label": "Colour",
          "info": "The gradient behind the slide when there is no poster.",
          "options": [
            { "value": "moment", "label": "Same as the moment" },
            { "value": "night", "label": "Evening out" },
            { "value": "gift", "label": "Gift" },
            { "value": "allday", "label": "All day" },
            { "value": "daily", "label": "Office" },
            { "value": "fresh", "label": "Summer heat" },
            { "value": "love", "label": "Date night" },
            { "value": "occasions", "label": "Weddings & Eid" },
            { "value": "winter", "label": "Winter nights" }
          ],
          "default": "moment"
        },
        { "type": "header", "content": "Text" },
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "textarea", "id": "subline", "label": "Subline" },
        { "type": "text", "id": "primary_label", "label": "Button label" },
        { "type": "url", "id": "primary_url", "label": "Button link" },
        { "type": "text", "id": "secondary_label", "label": "Outlined button label", "info": "Leave empty to hide the outlined button." },
        { "type": "url", "id": "secondary_url", "label": "Outlined button link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "MOMENTS hero",
      "blocks": [
        { "type": "slide", "settings": { "moment": "night", "from_hour": 18, "to_hour": 5 } },
        { "type": "slide", "settings": { "moment": "fresh", "from_hour": 5, "to_hour": 10 } },
        { "type": "slide", "settings": { "moment": "allday", "from_hour": 10, "to_hour": 18 } },
        { "type": "slide", "settings": { "moment": "gift" } },
        { "type": "slide", "settings": { "moment": "daily" } },
        { "type": "slide", "settings": { "moment": "love" } }
      ]
    }
  ]
}
{% endschema %}
