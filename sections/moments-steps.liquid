{%- comment -%}
  How it works in three steps. This one is a real sequence, so the numbers earn their place. Fine print: a link to the returns
  and exchange policy page (no policy terms are written here). Blocks may override each step; empty ones use the translated defaults.
{%- endcomment -%}

<section class="m-steps" aria-labelledby="m-steps-title-{{ section.id }}">
  <div class="m-steps__inner m-wrap">
    <h2 class="m-steps__title" id="m-steps-title-{{ section.id }}">
      {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'about.steps.heading' | t }}{%- endif -%}
    </h2>
    <ol class="m-steps__list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'about.steps.s' | append: i | append: '_title'
          assign text_key = 'about.steps.s' | append: i | append: '_text'
        -%}
        <li class="m-steps__item">
          <span class="m-steps__num" aria-hidden="true">{{ i }}</span>
          <h3 class="m-steps__step">{{ title_key | t }}</h3>
          <p class="m-steps__text">{{ text_key | t }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.returns_url != blank -%}
      <p class="m-steps__fine"><a href="{{ section.settings.returns_url }}">{{ 'about.steps.fine' | t }}</a></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .m-steps {
    padding-block: clamp(48px, 7vw, 112px);
    background: var(--m-plum);
    color: var(--m-pearl);
  }

  .m-steps__inner {
    display: grid;
    gap: 32px;
  }

  .m-steps__title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
  }

  .m-steps__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--m-accent-on-dark);
  }

  .m-steps__item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    column-gap: 16px;
    padding-block: 24px;
    border-block-end: 1px solid rgb(250 246 242 / 0.25);
  }

  .m-steps__num {
    grid-row: span 2;
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--m-accent-on-dark);
  }

  .m-steps__step {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.1;
  }

  .m-steps__text {
    margin: 6px 0 0;
    max-inline-size: 36ch;
    color: var(--m-nude);
    line-height: 1.5;
  }

  .m-steps__fine {
    margin: 0;
    font-size: 0.875rem;
  }

  .m-steps__fine a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  html[lang='ar'] .m-steps__title,
  html[lang='ar'] .m-steps__step {
    line-height: 1.35;
  }

  html[lang='ar'] .m-steps__text {
    line-height: 1.7;
  }

  @media screen and (min-width: 990px) {
    .m-steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 40px;
      border-block-start: 0;
    }

    .m-steps__item {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 24px 0;
      border-block-start: 1px solid var(--m-accent-on-dark);
      border-block-end: 0;
    }

    .m-steps__num {
      grid-row: auto;
      margin-block-end: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOMENTS steps",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "url", "id": "returns_url", "label": "Returns and exchange policy page", "info": "Shown as fine print under the steps." }
  ],
  "presets": [{ "name": "MOMENTS steps" }]
}
{% endschema %}
