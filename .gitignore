# Shopify CLI
.shopify/

# Dependencies
node_modules/
scripts/node_modules/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets and local settings: never commit tokens, keys or per-machine settings
.env
.env.*
*.pem
*.key
.claude/settings.local.json
.claude/*.local.json
shopify.theme.toml.local

# Logs and temporary files
*.log
*.tmp
*.bak

# Dev tooling and generated output (not part of the theme)
build/
dist/
scratch/
__pycache__/
*.pyc

# Raw media: video clips go through scripts/prepare-video.mjs, only the finished loop belongs in the theme
raw-video/
*.mov
*.mp4.raw
*.mkv
*.avi

# Throwaway probes and one-off scratch scripts (keep real checks in scripts/ without this prefix)
scripts/_*.mjs
scripts/_*.py

# Generated output: regenerate with the scripts, do not commit
build/
docs/screenshots/*
!docs/screenshots/README.md
!docs/screenshots/moment-marks.png
docs/design/colour-flow-*-*.md
docs/design/card-layout-*.md
docs/performance/perf-*-run*.md
scripts/.*
lighthouse-*.json

# owner inputs kept out of the repo
MOMENTS-Identity-Full.zip
/72.webp
/73.webp
/perfume_bottle.glb
