    {
      "type": "image_picker",
      "id": "arabic_flag",
      "label": "Arabic flag"
    },
    {
      "type": "url",
      "id": "arabic_url",
      "label": "Arabic URL"
    },
    {
      "type": "checkbox",
      "id": "show_english",
      "label": "Show English",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "english_flag",
      "label": "English flag"
    },
    {
      "type": "url",
      "id": "english_url",
      "label": "English URL"
    },
    {
      "type": "header",
