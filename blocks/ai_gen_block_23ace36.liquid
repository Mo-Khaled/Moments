{% doc %}
  @prompt
    I want to add a new left column to my footer.
    This column should appear before all my existing 4 footer columns.
    The left column must contain:
    – My store logo
    – A title “Need help?”
    – Phone number with an icon
    – WhatsApp number with an icon
    – Email link with an icon
    – Customer service working hours
    Make it a customizable block inside the footer section so I can edit text and icons.
    Keep my current 4 footer columns exactly as they are.
    Only add this new contact-info column to the left
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-contact-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-footer-contact__logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-contact__logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-footer-contact__title-{{ ai_gen_id }} {
    margin: 0 0 12px 0;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-contact__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-contact__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-footer-contact__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-footer-contact__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-footer-contact__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.text_size }}px;
    transition: color 0.3s ease;
  }

  .ai-footer-contact__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-contact__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-footer-contact__hours-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-contact-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-footer-contact__logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-footer-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_logo %}
    <div class="ai-footer-contact__logo-{{ ai_gen_id }}">
      {% if settings.logo %}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          loading="lazy"
        >
      {% else %}
        <span class="ai-footer-contact__text-{{ ai_gen_id }}">{{ shop.name }}</span>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.title != blank %}
    <h3 class="ai-footer-contact__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% endif %}

  <ul class="ai-footer-contact__list-{{ ai_gen_id }}">
    {% if block.settings.phone != blank %}
      <li class="ai-footer-contact__item-{{ ai_gen_id }}">
        <div class="ai-footer-contact__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
          </svg>
        </div>
        <a href="tel:{{ block.settings.phone | replace: ' ', '' }}" class="ai-footer-contact__link-{{ ai_gen_id }}">
          {{ block.settings.phone }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.whatsapp != blank %}
      <li class="ai-footer-contact__item-{{ ai_gen_id }}">
        <div class="ai-footer-contact__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </div>
        <a href="https://wa.me/{{ block.settings.whatsapp | replace: ' ', '' | replace: '+', '' }}" class="ai-footer-contact__link-{{ ai_gen_id }}" target="_blank" rel="noopener">
          {{ block.settings.whatsapp }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.email != blank %}
      <li class="ai-footer-contact__item-{{ ai_gen_id }}">
        <div class="ai-footer-contact__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </div>
        <a href="mailto:{{ block.settings.email }}" class="ai-footer-contact__link-{{ ai_gen_id }}">
          {{ block.settings.email }}
        </a>
      </li>
    {% endif %}

    {% if block.settings.working_hours != blank %}
      <li class="ai-footer-contact__item-{{ ai_gen_id }}">
        <div class="ai-footer-contact__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
            <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
          </svg>
        </div>
        <div class="ai-footer-contact__hours-{{ ai_gen_id }}">
          {{ block.settings.working_hours }}
        </div>
      </li>
    {% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Footer contact info",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true,
      "info": "Uses the logo from theme settings"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Need help?"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "TODO_PHONE"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp number",
      "default": ""
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "TODO_SUPPORT_EMAIL"
    },
    {
      "type": "textarea",
      "id": "working_hours",
      "label": "Working hours",
      "default": "10:00 AM - 10:00 PM"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#82a31a"
    }
  ],
  "presets": [
    {
      "name": "Footer contact info"
    }
  ]
}
{% endschema %}
