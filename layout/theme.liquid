<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
  {% if request.locale.iso_code == 'ar' %}dir="rtl"{% else %}dir="ltr"{% endif %}
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently. It blocks first paint, so it is only output when a view transition is switched on. {% endcomment %}
    {%- if settings.page_transition_enabled or settings.transition_to_main_product -%}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'brand-fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {% if request.locale.iso_code == 'ar' %}
      {{ 'rtl.css' | asset_url | stylesheet_tag }}
    {% endif %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% comment %}Top Language Bar{% endcomment %}
    {%- if localization.available_languages.size > 1 -%}
      <style>
        #top-lang-bar {
          display: none;
          background: #FAF6F2;
          border-bottom: 1px solid rgba(59, 30, 58, 0.08);
        }
        #top-lang-bar form {
          margin: 0;
        }
        #top-lang-bar .tlb-inner {
          display: flex;
          align-items: center;
          justify-content: flex-start;
          padding: 10px 18px;
        }
        #top-lang-bar .tlb-lang {
          display: flex;
          align-items: center;
          gap: 10px;
        }
        #top-lang-bar .tlb-globe {
          width: 15px;
          height: 15px;
          display: block;
          color: rgba(59, 30, 58, 0.6);
          flex-shrink: 0;
        }
        #top-lang-bar .tlb-current {
          color: #3B1E3A;
          font-size: 13px;
          font-weight: 700;
          letter-spacing: 0.3px;
          line-height: 1;
        }
        #top-lang-bar .tlb-sep {
          width: 1px;
          height: 13px;
          background: rgba(59, 30, 58, 0.22);
          flex-shrink: 0;
        }
        #top-lang-bar .tlb-switch {
          background: none;
          border: none;
          padding: 2px 0;
          color: rgba(59, 30, 58, 0.5);
          font-size: 13px;
          font-weight: 500;
          letter-spacing: 0.3px;
          line-height: 1;
          cursor: pointer;
          -webkit-appearance: none;
          appearance: none;
          transition: color 0.15s ease;
        }
        #top-lang-bar .tlb-switch:hover,
        #top-lang-bar .tlb-switch:active {
          color: #3B1E3A;
        }
        @media (max-width: 749px) {
          #top-lang-bar { display: block; }
        }
      </style>

      <div id="top-lang-bar">
        {%- form 'localization', id: 'TopLangForm' -%}
          <div class="tlb-inner">
            <div class="tlb-lang">
              <svg class="tlb-globe" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2c2.5 2.7 4 6.2 4 10s-1.5 7.3-4 10c-2.5-2.7-4-6.2-4-10s1.5-7.3 4-10z"/></svg>
              {%- if request.locale.iso_code == 'ar' -%}
                <span class="tlb-current">العربية</span>
                <span class="tlb-sep" aria-hidden="true"></span>
                <button type="submit" name="locale_code" value="en" class="tlb-switch" aria-label="Switch to English">English</button>
              {%- else -%}
                <span class="tlb-current">English</span>
                <span class="tlb-sep" aria-hidden="true"></span>
                <button type="submit" name="locale_code" value="ar" class="tlb-switch" aria-label="التبديل إلى العربية">العربية</button>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

  </body>
</html>
