{%- doc -%}
  Renders the product badge for a card: the saving when there is a compare-at price, "Sold out" when there is no stock.
  One badge style for the whole theme: square corners, a gold outline on the page surface (the single gold badge outline
  of the brand), no filled pill. A product that is on sale and in stock shows the saving; a sold-out product shows
  "Sold out" in muted ink. A product with no compare-at price and in stock shows nothing.

  @param {object} product - The product object.
  @param {object} settings - The theme settings object.

  @example
  {% render 'product-card-badges', product: product, settings: settings %}
{%- enddoc -%}

{%- liquid
  assign on_sale = false
  if product.available and product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign saving = product.compare_at_price | minus: product.price
  assign saving_text = saving | money
-%}

<div class="product-badges product-badges--{{ settings.badge_position }}">
  {%- if product.available == false -%}
    <div class="product-badges__badge product-badges__badge--muted">
      {{- 'content.product_badge_sold_out' | t -}}
    </div>
  {%- elsif on_sale -%}
    <div class="product-badges__badge">
      {{- 'content.product_badge_save' | t: amount: saving_text -}}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-badges {
    --badge-inset: var(--padding-xs);

    position: absolute;
    z-index: var(--layer-flat);
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    inset-inline-end: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 3px;
    padding-inline: 9px;
    border-radius: var(--m-badge-radius);
    background: var(--m-badge-bg);
    box-shadow: inset 0 0 0 1px var(--m-badge-ink);
    color: var(--m-badge-ink);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  .product-badges__badge--muted {
    box-shadow: inset 0 0 0 1px var(--m-badge-ink-muted);
    color: var(--m-badge-ink-muted);
  }
{% endstylesheet %}
