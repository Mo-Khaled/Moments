{%- doc -%}
  The panel under a primary navigation item. Two modes, both inside the shared gutter, both simple on purpose.

  mode "moments" (Shop by Moment): on the start side the six moments as a 3 x 2 grid of compact cards (large mark, name, product
  count; same size, same alignment); on the end side two short columns, "Shop by" (For Her, For Him, Unisex) and "The edits"
  (Best sellers, New arrivals, Gifts). At most four links per column, and a column whose links do not exist is not rendered at all,
  heading included (nothing may ever show an empty heading). Links that need a store page that does not exist yet (Unisex,
  New arrivals) are left out until it exists; see docs/needs-from-owner.md.
  mode "brands": one row of up to eight featured brand logos (the "Brands panel" collection settings of the header menu block)
  and an "All brands" link. No 24-link list.
  No photographs in either mode, so nothing is cover-cropped. Nothing here edits store navigation: the links come from existing
  menu items and collections.

  @param {object} link - The top-level menu link that owns the panel.
  @param {string} [mode] - moments or brands. Default moments.
  @param {object} [all_links] - All top-level links of the menu (For Her and For Him are found here).
  @param {object} [panel_settings] - The header menu block settings (brand_1 to brand_8).

  @example
  {% render 'moments-mega', link: link, mode: 'moments', all_links: all_links, panel_settings: block.settings %}
{%- enddoc -%}

{%- liquid
  assign panel_mode = mode | default: 'moments'
  assign logo_handles = 'afnan,khadlaj,lattafa,faan,assaf,rasasi-perfumes,laverne,nabeel-perfumes,ibraq,le-falcone,lattafa-pride,armaf,zimaya,dkhoon-emirates' | split: ','
-%}

{%- if panel_mode == 'brands' -%}
  <div class="m-mega m-mega--brands m-wrap">
    <ul class="m-mega__logos">
      {%- for i in (1..8) -%}
        {%- assign setting_key = 'brand_' | append: i -%}
        {%- assign brand = panel_settings[setting_key] -%}
        {%- if brand != blank -%}
          <li>
            <a class="m-mega__logo" href="{{ brand.url }}">
              {%- if logo_handles contains brand.handle -%}
                {%- assign logo_file = 'brand-' | append: brand.handle | append: '.png' -%}
                <img src="{{ logo_file | asset_url }}" alt="{{ brand.title | escape }}" width="120" height="24" loading="lazy" decoding="async">
              {%- else -%}
                <span>{{ brand.title }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <a class="m-mega__all" href="{{ link.url }}">{{ 'homepage.mega.all_brands' | t }}{% render 'moments-chevron' %}</a>
  </div>
{%- else -%}
  {%- liquid
    assign shop_by = ''
    for item in all_links
      # matched on the link's handle, not its title: titles are translated on /ar
      assign item_key = item.url | split: '?' | first | split: '/' | last | downcase
      if item_key == 'for-her' or item_key == 'for-him' or item_key == 'unisex'
        assign shop_by = shop_by | append: item.url | append: '|' | append: item.title | append: ';'
      endif
    endfor
    unless shop_by contains '/unisex|'
      if collections['unisex'] != blank
        assign shop_by = shop_by | append: collections['unisex'].url | append: '|Unisex;'
      endif
    endunless
    assign shop_by_items = shop_by | split: ';'
  -%}
  <div class="m-mega m-mega--moments m-wrap">
    <ul class="m-mega__moments">
      {%- capture moment_handles -%}{% render 'moments-config', part: 'handles' %}{%- endcapture -%}
      {%- assign moment_handles = moment_handles | strip | split: ',' -%}
      {%- capture moment_marks -%}{% render 'moments-config', part: 'keys' %}{%- endcapture -%}
      {%- assign moment_marks = moment_marks | strip | split: ',' -%}
      {%- capture moment_keys -%}{% render 'moments-config', part: 'labels' %}{%- endcapture -%}
      {%- assign moment_keys = moment_keys | strip | split: ',' -%}
      {%- for handle in moment_handles -%}
        {%- assign moment_collection = collections[handle] -%}
        {%- if moment_collection != blank -%}
          {%- assign mark = moment_marks[forloop.index0] -%}
          <li class="m-mega__moment-item">
            <a class="m-mega__moment m-tone--{{ mark }}" href="{{ moment_collection.url }}" data-moment-host>
              <span class="m-mega__moment-art" aria-hidden="true">{% render 'moment-mark', mark: mark, size: 'lg' %}</span>
              <span class="m-mega__moment-name">{{ moment_keys[forloop.index0] | t }}</span>
              <span class="m-mega__moment-count">{{ 'homepage.moments.count' | t: count: moment_collection.products_count }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="m-mega__columns">
      {%- if shop_by_items.size > 0 -%}
        <div class="m-mega__col">
          <p class="m-mega__heading">{{ 'homepage.mega.shop_by' | t }}</p>
          <ul>
            {%- for entry in shop_by_items limit: 4 -%}
              {%- assign parts = entry | split: '|' -%}
              <li><a href="{{ parts[0] }}">{% render 'title-case', text: parts[1] %}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if collections['best-sellers'] != blank or collections['new-arrivals'] != blank or collections['gift-moment'] != blank -%}
        <div class="m-mega__col">
          <p class="m-mega__heading">{{ 'homepage.mega.edits' | t }}</p>
          <ul>
            {%- if collections['best-sellers'] != blank -%}
              <li><a href="{{ collections['best-sellers'].url }}">{{ 'homepage.mega.bestsellers' | t }}</a></li>
            {%- endif -%}
            {%- if collections['new-arrivals'] != blank -%}
              <li><a href="{{ collections['new-arrivals'].url }}">{{ 'homepage.mega.new' | t }}</a></li>
            {%- endif -%}
            {%- if collections['gift-moment'] != blank -%}
              <li><a href="{{ collections['gift-moment'].url }}">{{ 'homepage.mega.gifts' | t }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* The panel opens and closes by animating a clip (blocks/_header-menu.liquid). The content follows the theme's content opacity: it fades in
     once the item is open and disappears at once when it closes, so a quick hover-and-leave never leaves a cropped strip of tiles under the
     header while the clip runs back to zero. */
  .m-mega {
    display: grid;
    padding-block: 16px 24px;
    opacity: var(--submenu-content-opacity, 1);
    transition: opacity 160ms var(--m-ease, ease-out);
  }

  .menu-list__list-item:not(:has([aria-expanded='true'])) .m-mega {
    transition-duration: 0s;
  }

  /* A closed panel is not rendered at all, so Chrome can never show a stale piece of it (owner screenshots 2026-10-30: a strip of
     tiles under the header after leaving the menu, and a pale band across the tiles). Open or hovered, it renders as usual. */
  .menu-list__list-item:not(:has(> .menu-list__link[aria-expanded='true'])):not(:has(> .menu-list__submenu:hover)) .m-mega {
    content-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-mega {
      transition: none;
    }
  }

  .m-mega ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-mega a {
    color: inherit;
    text-decoration: none;
  }

  .m-mega--moments {
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .m-mega__moments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .m-mega__moment-item {
    container-type: inline-size;
  }

  .m-mega__moment {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    position: relative;
    display: grid;
    align-content: end;
    gap: 2px;
    aspect-ratio: 5 / 4;
    padding: 12cqi;
    border-radius: var(--m-radius-card);
    overflow: clip;
    background: var(--tile-bg);
    color: var(--tile-ink);
    box-shadow: inset 0 0 0 1px rgb(250 246 242 / 0.12);
  }

  .m-mega__moment-art {
    position: absolute;
    inset-block-start: 2cqi;
    inset-inline-end: 4cqi;
    inline-size: 52cqi;
    block-size: 52cqi;
  }

  .m-mega__moment-art moment-mark {
    --mm-size: 100%;
    --mm-amp: 1.2;
  }

  .m-mega__moment-name {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 8cqi, 1.75rem);
    line-height: 1.1;
  }

  .m-mega__moment-count {
    font-size: 0.8125rem;
  }

  .m-mega a.m-mega__moment {
    color: var(--tile-ink);
  }

  .m-mega__moment:focus-visible,
  .m-mega a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .m-mega__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-content: start;
  }

  .m-mega__heading {
    margin: 0 0 12px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  html[lang='ar'] .m-mega__heading {
    letter-spacing: 0;
    text-transform: none;
  }

  .m-mega__col li a {
    display: block;
    padding-block: 7px;
    font-size: 1.0625rem;
  }

  .m-mega__col li a:hover,
  .m-mega__all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* "All brands" follows the last logo on the same line (it used to sit alone at the far edge of the panel), set off by a hairline */
  .m-mega--brands {
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: center;
    gap: 16px 32px;
  }

  .m-mega__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  .m-mega__logo {
    display: block;
  }

  .m-mega__logo img {
    display: block;
    inline-size: auto;
    block-size: 24px;
    /* The logo files are pearl on transparent; on the light panel they are shown in plum. */
    filter: brightness(0) saturate(100%) invert(12%) sepia(23%) saturate(1432%) hue-rotate(264deg) brightness(92%);
  }

  .m-mega__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding-inline-start: 32px;
    border-inline-start: 1px solid var(--m-rule-quiet);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-mega__moment-art moment-mark {
      --mm-amp: 0;
    }
  }
{% endstylesheet %}
