{%- doc -%}
  The panel under a primary navigation item.

  mode "moments" (Shop by Moment): on the start side three image cards in one row, all the same ratio, each with a label and a
  chevron under it (All fragrances, Shop by moment, Brands); on the end side three link columns: Shop by moment (the six
  moments), The edits (Best sellers, New arrivals, Gifts) and Discover (the other menu links).
  mode "list" (every other item): the item's children in link columns, nothing else. No photographs in either mode, so nothing
  is ever cover-cropped; the cards are the moment colour fields with the large Moment mark.

  The links come from the existing main menu and collections (the six moments come from the "Moment collections" theme
  setting when the menu item has no children). Nothing here edits store navigation. Needed navigation
  changes (for example a "Unisex" link) are listed in docs/audit/navigation-changes.md and wait for approval.

  @param {object} link - The top-level menu link that owns the panel.
  @param {string} [mode] - moments or list. Default list.
  @param {object} [all_links] - All top-level links of the menu (used to build the Discover column).

  @example
  {% render 'moments-mega', link: link, mode: 'moments', all_links: block_settings.menu.links %}
{%- enddoc -%}

{%- liquid
  assign panel_mode = mode | default: 'list'
  assign brands_url = routes.collections_url
  for item in all_links
    assign item_key = item.title | downcase | strip
    if item_key == 'brands'
      assign brands_url = item.url
    endif
  endfor
-%}

{%- if panel_mode == 'moments' -%}
  <div class="m-mega m-mega--moments m-wrap">
    <ul class="m-mega__cards">
      <li>
        <a class="m-mega__card" href="{{ routes.all_products_collection_url }}" data-moment-host>
          <span class="m-mega__art m-tone--daily" aria-hidden="true">{% render 'moment-mark', mark: 'daily', size: 'lg' %}</span>
          <span class="m-mega__caption">{{ 'homepage.mega.all' | t }}{% render 'moments-chevron' %}</span>
        </a>
      </li>
      <li>
        <a class="m-mega__card" href="{{ link.url }}" data-moment-host>
          <span class="m-mega__art m-tone--allday" aria-hidden="true">{% render 'moment-mark', mark: 'allday', size: 'lg' %}</span>
          <span class="m-mega__caption">{{ 'homepage.mega.moments' | t }}{% render 'moments-chevron' %}</span>
        </a>
      </li>
      <li>
        <a class="m-mega__card" href="{{ brands_url }}" data-moment-host>
          <span class="m-mega__art m-tone--night" aria-hidden="true">{% render 'moment-mark', mark: 'night', size: 'lg' %}</span>
          <span class="m-mega__caption">{{ 'homepage.mega.brands' | t }}{% render 'moments-chevron' %}</span>
        </a>
      </li>
    </ul>

    <div class="m-mega__columns">
      <div class="m-mega__col">
        <p class="m-mega__heading">{{ 'homepage.mega.moments' | t }}</p>
        <ul>
          {%- if link.links != blank -%}
            {%- for child in link.links -%}
              <li><a href="{{ child.url }}">{% render 'title-case', text: child.title %}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign moment_handles = 'night-moment,gift-moment,all-day-moment,daily-moment,fresh-moment,love-moment' | split: ',' -%}
            {%- for handle in moment_handles -%}
              {%- assign handle_key = handle | strip -%}
              {%- assign moment_collection = collections[handle_key] -%}
              {%- if moment_collection != blank -%}
                <li><a href="{{ moment_collection.url }}">{{ moment_collection.title | replace: ' Moment', '' }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      <div class="m-mega__col">
        <p class="m-mega__heading">{{ 'homepage.mega.edits' | t }}</p>
        <ul>
          {%- if collections['best-sellers'] != blank -%}
            <li><a href="{{ collections['best-sellers'].url }}">{{ 'homepage.mega.bestsellers' | t }}</a></li>
          {%- endif -%}
          {%- if collections['new-arrivals'] != blank -%}
            <li><a href="{{ collections['new-arrivals'].url }}">{{ 'homepage.mega.new' | t }}</a></li>
          {%- endif -%}
          {%- if collections['gift-moment'] != blank -%}
            <li><a href="{{ collections['gift-moment'].url }}">{{ 'homepage.mega.gifts' | t }}</a></li>
          {%- endif -%}
        </ul>
      </div>
      <div class="m-mega__col">
        <p class="m-mega__heading">{{ 'homepage.mega.discover' | t }}</p>
        <ul>
          {%- for item in all_links -%}
            {%- assign item_key = item.title | downcase | strip -%}
            {%- unless item.url == link.url or item_key == 'gifts' -%}
              <li><a href="{{ item.url }}">{% render 'title-case', text: item.title %}</a></li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="m-mega m-mega--list m-wrap">
    <p class="m-mega__heading">{% render 'title-case', text: link.title %}</p>
    <ul class="m-mega__flow">
      {%- for child in link.links -%}
        <li><a href="{{ child.url }}">{{ child.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .m-mega {
    display: grid;
    gap: 32px;
    padding-block: 8px 16px;
  }

  .m-mega ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .m-mega a {
    color: inherit;
    text-decoration: none;
  }

  .m-mega--moments {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .m-mega__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .m-mega__card {
    display: grid;
    gap: 10px;
  }

  .m-mega__art {
    --m-mark-ink: var(--tile-ink);
    --m-mark-body: var(--tile-body);
    --m-mark-accent: var(--tile-accent);
    --m-mark-gold: var(--tile-gold);

    container-type: inline-size;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    background: var(--tile-bg);
  }

  .m-mega__art moment-mark {
    --mm-size: 70cqi;
    --mm-amp: 1.2;
  }

  .m-mega__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .m-mega__card:hover .m-mega__caption,
  .m-mega__card:focus-visible .m-mega__caption {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .m-mega__card:focus-visible,
  .m-mega a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .m-mega__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .m-mega__heading {
    margin: 0 0 12px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  html[lang='ar'] .m-mega__heading {
    letter-spacing: 0;
    text-transform: none;
  }

  .m-mega__col li a,
  .m-mega__flow li a {
    display: block;
    padding-block: 6px;
    font-size: 1rem;
  }

  .m-mega__col li a:hover,
  .m-mega__flow li a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .m-mega__flow {
    columns: 4 180px;
    column-gap: 32px;
  }

  .m-mega__flow li {
    break-inside: avoid;
  }

  @media (prefers-reduced-motion: reduce) {
    .m-mega__art moment-mark {
      --mm-amp: 0;
    }
  }
{% endstylesheet %}
