{%- doc -%}
  The small label rows under a product name on a card: the brand, then the moment mark and word.

  The moment comes from the six moment collections. They are manual collections (not tag based), so the
  product's collection handles are compared with the ordered list in the theme setting "Moment collections".
  When a product is in several moments the first handle in that list wins: the list runs from the most
  specific moment (Weddings & Eid) to the broadest (Office), which is the fixed tiebreak.
  A handle is turned into its mark and label by name: night-moment gives the night mark and the label
  from the locale key moments.night (Evening out), occasions-moment gives occasions and moments.occasions. Any other handle
  falls back to the collection title and no mark, so a new moment needs no code.

  @param {object} product - The product.
  @param {boolean} [show_moment] - Show the moment label. Default true.
  @param {boolean} [show_brand] - Show the vendor. Default true.

  @example
  {% render 'product-card-meta', product: product, show_moment: true, show_brand: true %}
{%- enddoc -%}

{%- liquid
  assign want_moment = show_moment | default: true
  assign want_brand = show_brand | default: true
  assign moment_collection = null
  assign moment_label = ''
  assign moment_key = ''

  comment
    The brand is shown once: when the product title already starts with the brand (for example "Afnan Gift Bag"), the card does not repeat it.
  endcomment
  assign vendor_text = product.vendor | downcase | strip
  assign title_text = product.title | downcase | strip
  assign vendor_len = vendor_text | size
  if want_brand and vendor_len > 0 and title_text contains vendor_text
    assign title_start = title_text | slice: 0, vendor_len
    if title_start == vendor_text
      assign want_brand = false
    endif
  endif

  if want_moment and settings.moments_handles != blank
    assign handles = settings.moments_handles | split: ','
    for handle in handles
      assign handle = handle | strip
      assign hit = product.collections | where: 'handle', handle | first
      if hit != blank
        assign moment_collection = hit
        assign moment_key = handle | remove: '-moment' | replace: '-', '_'
        break
      endif
    endfor

    if moment_collection != blank
      assign label_key = 'moments.' | append: moment_key
      assign moment_label = label_key | t
      if moment_label contains 'translation missing'
        assign moment_label = moment_collection.title
        assign moment_key = ''
      endif
    endif
  endif
-%}

{%- if moment_label != blank or want_brand and product.vendor != blank -%}
  <div class="card-meta">
    {%- if want_brand and product.vendor != blank -%}
      <span class="card-meta__brand">{% render 'vendor-name', vendor: product.vendor %}</span>
    {%- endif -%}
    {%- if moment_label != blank -%}
      <span class="card-meta__moment">
        {%- if moment_key != '' -%}
          {%- assign mark_name = moment_key | remove: '_' -%}
          {%- comment -%} self-care uses the sun-over-waves mark, the same as its collection header (owner 2026-11-22) {%- endcomment -%}
          {%- if mark_name == 'selfcare' -%}{%- assign mark_name = 'allday' -%}{%- endif -%}
          {%- comment -%} only the moments that have a drawing (self-care borrows the allday mark) {%- endcomment -%}
          {%- assign drawn = 'night,gift,allday,daily,fresh,love,occasions,winter,selfcare' | split: ',' -%}
          {%- if drawn contains mark_name -%}
            {% render 'moment-mark', mark: mark_name %}
          {%- endif -%}
        {%- endif -%}
        <span>{{ moment_label }}</span>
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-block-end: 6px;
    color: var(--m-card-meta);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .card-meta__moment {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* the drawing sits inside empty space in its box; pull it out so the moment lines up with the name and the brand
     (left edge in English, right edge in Arabic; owner 2026-11-22) */
  .card-meta__moment moment-mark {
    margin-inline: -7px -2px;
  }

  .card-meta__brand {
    color: var(--m-card-meta);
  }

  /* A thin rule between the brand and the moment, not a dot (brand first, owner 2026-11-22). */
  .card-meta__brand + .card-meta__moment {
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--m-rule-quiet);
  }

  /* Phones (owner 2026-11-23): the same one-row style as desktop, brand | moment with the thin rule. Every item carries the
     rule and 8px on its start side, and the first 9px of the row are cut off: the item that starts a line (the brand, or the
     moment when a long English pair wraps) starts flush with the name above, with no rule; items on the same line keep the
     rule between them. No script. */
  @media screen and (max-width: 749px) {
    .card-meta {
      column-gap: 0;
      row-gap: 2px;
      margin-inline-start: -9px;
      clip-path: inset(-4px -4px -4px 9px);
    }

    html[dir='rtl'] .card-meta {
      clip-path: inset(-4px 9px -4px -4px);
    }

    .card-meta > * {
      padding-inline-start: 8px;
      margin-inline-end: 8px;
      border-inline-start: 1px solid var(--m-rule-quiet);
    }

    .card-meta__brand + .card-meta__moment {
      padding-inline-start: 8px;
    }
  }
{% endstylesheet %}
