{%- doc -%}
  The small four-point diamond used as a separator in the tickers, echoing the diamond in the MOMENTS wordmark.
  Decorative. Colour follows currentColor.

  @param {string} [class] - Extra classes.

  @example
  {% render 'moments-diamond' %}
{%- enddoc -%}

<svg class="m-diamond {{ class }}" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M6 0l1.6 4.4L12 6 7.6 7.6 6 12 4.4 7.6 0 6l4.4-1.6z"/>
</svg>

{% stylesheet %}
  .m-diamond {
    flex: none;
  }
{% endstylesheet %}
