{%- doc -%}
  The MOMENTS pointer: a plum arrow with a thin white outline for the page (Fluent UI System Icons "cursor-24-filled", MIT) and a berry
  OK-hand for links and buttons (Hugeicons "ok-finger", MIT). Sources: assets/cursor-*.svg, built into PNG by scripts/build-cursors.mjs
  at 32x32 and 64x64 (2x). Hotspots in 1x pixels: the arrow tip (8, 3) and the raised fingertip of the hand (18, 3).
  Only for fine pointers (a mouse), never under forced-colors, and off with the theme setting "Custom pointer". Text fields, textareas,
  video controls, disabled controls and anything the theme already marks as grab, zoom or resize keep the native cursor.
  A native keyword always follows the images, so the cursor falls back to the system one if an image fails.

  @example
  {% render 'moment-pointer' %}
{%- enddoc -%}

{%- if settings.moments_pointer -%}
  {%- liquid
    assign d1 = 'cursor-default.png' | asset_url
    assign d2 = 'cursor-default-2x.png' | asset_url
    assign l1 = 'cursor-link.png' | asset_url
    assign l2 = 'cursor-link-2x.png' | asset_url
  -%}
  <style id="moment-pointer-css">
    @media (pointer: fine) and (not (forced-colors: active)) {
      html:root {
        --m-pointer-default: url('{{ d1 }}') 8 3, auto;
        --m-pointer-link: url('{{ l1 }}') 18 3, pointer;
      }

      @supports (cursor: image-set(url('{{ d1 }}') 1x) 8 3) {
        html:root {
          --m-pointer-default: image-set(url('{{ d1 }}') 1x, url('{{ d2 }}') 2x) 8 3, auto;
          --m-pointer-link: image-set(url('{{ l1 }}') 1x, url('{{ l2 }}') 2x) 18 3, pointer;
        }
      }

      @supports (cursor: -webkit-image-set(url('{{ d1 }}') 1x) 8 3) and (not (cursor: image-set(url('{{ d1 }}') 1x) 8 3)) {
        html:root {
          --m-pointer-default: -webkit-image-set(url('{{ d1 }}') 1x, url('{{ d2 }}') 2x) 8 3, auto;
          --m-pointer-link: -webkit-image-set(url('{{ l1 }}') 1x, url('{{ l2 }}') 2x) 18 3, pointer;
        }
      }

      html:root:root,
      html:root:root body {
        cursor: var(--m-pointer-default);
      }

      html:root:root :where(
        a[href],
        button:not(:disabled),
        [role='button']:not([aria-disabled='true']),
        input:is([type='submit'], [type='button'], [type='checkbox'], [type='radio'], [type='range']):not(:disabled),
        summary,
        label,
        select:not(:disabled)
      ):not([data-zoom], [aria-disabled='true']) {
        cursor: var(--m-pointer-link);
      }

      /* the theme sets cursor: pointer on parts INSIDE clickable elements (a filter heading's text, a card's inner span), which showed
         the system hand there; everything inside a link, button, summary or label takes the berry hand too, except text fields */
      html:root:root :where(a[href], button:not(:disabled), [role='button'], summary, label) :where(*):not(input:not([type='checkbox'], [type='radio'], [type='submit'], [type='button']), textarea, select, [data-zoom]) {
        cursor: var(--m-pointer-link);
      }
    }
  </style>
{%- endif -%}
