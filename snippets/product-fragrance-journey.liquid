{% comment %}
  Fragrance Journey – colored dot chips + premium SVG attribute tags
{% endcomment %}

{%- liquid
  assign top_notes   = 'top_notes_1,top_notes_2,top_notes_3,top_notes_4,top_notes_5,top_notes_6' | split: ','
  assign heart_notes = 'heart_notes_1,heart_notes_2,heart_notes_3,heart_notes_4,heart_notes_5,heart_notes_6' | split: ','
  assign base_notes  = 'base_notes_1,base_notes_2,base_notes_3,base_notes_4,base_notes_5,base_notes_6' | split: ','

  assign p_season   = product.metafields.custom.season.value
  assign p_daynight = product.metafields.custom.day_night.value
  assign p_occasion = product.metafields.custom.occasion.value
-%}

<div class="fj" id="fj-{{ section.id }}">

  <div class="fj__title-bar">
    <span class="fj__title">Fragrance Journey</span>
    <span class="fj__rule" aria-hidden="true"></span>
  </div>

  {%- comment -%}── TOP NOTES ──{%- endcomment -%}
  <div class="fj__layer fj__layer--top fj__layer--open">
    <button class="fj__layer-hd fj__layer-hd--custom" type="button" aria-expanded="true">
      <span class="fj__lh-copy">
        <span class="fj__lh-eyebrow">Top Notes</span>
        <em class="fj__lh-name">{{ section.settings.top_name }}</em>
      </span>
      <span class="fj__lh-right">
        <em class="fj__lh-timing">{{ section.settings.top_timing }}</em>
        <span class="fj__lh-arrow" aria-hidden="true">▼</span>
      </span>
    </button>
    <div class="fj__body" aria-hidden="false">
      <div class="fj__chips">
        {%- for key in top_notes -%}
          {%- assign note_val = product.metafields.custom[key].value -%}
          {%- if note_val and note_val != blank -%}
            <span class="fj__chip{%- if forloop.first %} fj__chip--star{%- endif -%}">
              <span class="fj__dot" data-note="{{ note_val | downcase | escape }}"></span>{{ note_val }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%}── HEART NOTES ──{%- endcomment -%}
  <div class="fj__layer fj__layer--heart fj__layer--open">
    <button class="fj__layer-hd fj__layer-hd--custom" type="button" aria-expanded="true">
      <span class="fj__lh-copy">
        <span class="fj__lh-eyebrow">Heart Notes</span>
        <em class="fj__lh-name">{{ section.settings.heart_name }}</em>
      </span>
      <span class="fj__lh-right">
        <em class="fj__lh-timing">{{ section.settings.heart_timing }}</em>
        <span class="fj__lh-arrow" aria-hidden="true">▼</span>
      </span>
    </button>
    <div class="fj__body" aria-hidden="false">
      <div class="fj__chips">
        {%- for key in heart_notes -%}
          {%- assign note_val = product.metafields.custom[key].value -%}
          {%- if note_val and note_val != blank -%}
            <span class="fj__chip">
              <span class="fj__dot" data-note="{{ note_val | downcase | escape }}"></span>{{ note_val }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%}── BASE NOTES ──{%- endcomment -%}
  <div class="fj__layer fj__layer--base fj__layer--open">
    <button class="fj__layer-hd fj__layer-hd--custom" type="button" aria-expanded="true">
      <span class="fj__lh-copy">
        <span class="fj__lh-eyebrow">Base Notes</span>
        <em class="fj__lh-name">{{ section.settings.base_name }}</em>
      </span>
      <span class="fj__lh-right">
        <em class="fj__lh-timing">{{ section.settings.base_timing }}</em>
        <span class="fj__lh-arrow" aria-hidden="true">▼</span>
      </span>
    </button>
    <div class="fj__body" aria-hidden="false">
      <div class="fj__chips">
        {%- for key in base_notes -%}
          {%- assign note_val = product.metafields.custom[key].value -%}
          {%- if note_val and note_val != blank -%}
            <span class="fj__chip{%- if forloop.first %} fj__chip--star{%- endif -%}">
              <span class="fj__dot" data-note="{{ note_val | downcase | escape }}"></span>{{ note_val }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%}── META ROW ──{%- endcomment -%}
  {%- assign has_meta_blocks = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'meta_tag' -%}{%- assign has_meta_blocks = true -%}{%- endif -%}
  {%- endfor -%}

  {%- if p_season or p_daynight or p_occasion or has_meta_blocks -%}
  <div class="fj__meta-row">

    {%- if p_season and p_season != blank -%}
    <span class="fj__chip fj__chip--attr">
      <span class="fj__attr-icon" aria-hidden="true">
        {%- if p_season == 'Summer' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/><line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/></svg>
        {%- elsif p_season == 'Winter' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 7l-5 5-5-5"/><path d="M17 17l-5-5-5 5"/><path d="M2 12h20"/><path d="M7 7l-5 5 5 5"/><path d="M17 7l5 5-5 5"/></svg>
        {%- else -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/></svg>
        {%- endif -%}
      </span>
      {{ p_season }}
    </span>
    {%- endif -%}

    {%- if p_daynight and p_daynight != blank -%}
    <span class="fj__chip fj__chip--attr">
      <span class="fj__attr-icon" aria-hidden="true">
        {%- if p_daynight == 'Morning' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="4.22" y1="10.22" x2="5.64" y2="11.64"/><line x1="1" y1="18" x2="3" y2="18"/><line x1="21" y1="18" x2="23" y2="18"/><line x1="18.36" y1="11.64" x2="19.78" y2="10.22"/><line x1="23" y1="22" x2="1" y2="22"/><polyline points="8 6 12 2 16 6"/></svg>
        {%- elsif p_daynight == 'Evening' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        {%- else -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14" opacity=".35"/><path d="M4.93 19.07a10 10 0 0 1 0-14.14" opacity=".35"/></svg>
        {%- endif -%}
      </span>
      {{ p_daynight }}
    </span>
    {%- endif -%}

    {%- if p_occasion and p_occasion != blank -%}
    <span class="fj__chip fj__chip--attr">
      <span class="fj__attr-icon" aria-hidden="true">
        {%- if p_occasion == 'Formal' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L8 7l4 1 4-1-4-5z"/><path d="M8 7l-4 14h16L16 7"/><path d="M8 7l4 8 4-8"/></svg>
        {%- elsif p_occasion == 'Outing' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        {%- elsif p_occasion == 'Office' -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
        {%- else -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        {%- endif -%}
      </span>
      {{ p_occasion }}
    </span>
    {%- endif -%}

    {%- if has_meta_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'meta_tag' and block.settings.label != blank -%}
          <span class="fj__chip fj__chip--meta">
            {%- if block.settings.emoji and block.settings.emoji != '-' -%}
              <span class="fj__chip-em" aria-hidden="true">{{ block.settings.emoji }}</span>
            {%- endif -%}
            {{ block.settings.label }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

  </div>
  {%- endif -%}

</div>

<style>
.fj__dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 4px;
  background: var(--m-taupe);
}
.fj__chip--attr {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.85rem;
  background: transparent;
  border: 1px solid var(--m-nude-deep);
  border-radius: 999px;
  font-size: 0.8125rem;
  letter-spacing: 0.01em;
  color: var(--m-text);
  line-height: 1.4;
  font-family: var(--font-body--family, inherit);
  transition: border-color 0.2s ease;
}
.fj__chip--attr:hover {
  border-color: var(--m-mauve);
}
.fj__attr-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--m-text-muted);
  opacity: 0.85;
}
.fj__attr-icon svg { display: block; }
</style>

<script>
(function(){
  var colors = {
    // note families drawn in the six moment colours (assets/moments.css), so the journey speaks the site's colour language
    citrus:'var(--moment-allday-field)',floral:'var(--moment-gift-field)',rose:'var(--moment-love-field)',herbal:'var(--moment-fresh-field)',
    spice:'var(--moment-daily-field)',woody:'var(--moment-daily-deep)',oud:'var(--moment-night-deep)',amber:'var(--moment-daily-field)',
    musk:'var(--m-nude-deep)',moss:'var(--moment-fresh-deep)',incense:'var(--moment-night-field)',tobacco:'var(--moment-daily-deep)',
    leather:'var(--moment-daily-deep)',aquatic:'var(--moment-fresh-field)',gourmand:'var(--moment-gift-field)',fruity:'var(--moment-love-field)',
    coffee:'var(--moment-night-deep)'
  };
  var map = {
    'bergamot':'citrus','lemon':'citrus','lime':'citrus','grapefruit':'citrus',
    'orange':'citrus','mandarin':'citrus','tangerine':'citrus','blood orange':'citrus',
    'sicilian lemon':'citrus','citron':'citrus','lemongrass':'herbal',
    'neroli':'floral','jasmine':'floral','jasmine sambac':'floral','freesia':'floral',
    'lily':'floral','lily of the valley':'floral','tuberose':'floral',
    'ylang ylang':'floral','ylang-ylang':'floral','heliotrope':'floral',
    'gardenia':'floral','magnolia':'floral','peony':'floral','orchid':'floral',
    'orange blossom':'floral','cherry blossom':'floral','orange flower':'floral',
    'iris':'floral','violet':'floral','violet leaf':'floral','geranium':'floral',
    'rose':'rose','turkish rose':'rose','damask rose':'rose','bulgarian rose':'rose',
    'lavender':'herbal','wild lavender':'herbal','mint':'herbal','rosemary':'herbal',
    'basil':'herbal','sage':'herbal','clary sage':'herbal','thyme':'herbal',
    'fig leaf':'herbal','petitgrain':'herbal','artemisia':'herbal',
    'cardamom':'spice','cinnamon':'spice','nutmeg':'spice','saffron':'spice',
    'clove':'spice','ginger':'spice','pepper':'spice','pink pepper':'spice',
    'black pepper':'spice','sichuan pepper':'spice',
    'cedarwood':'woody','cedar':'woody','sandalwood':'woody','patchouli':'woody',
    'guaiac wood':'woody','birch':'woody','vetiver':'woody','akigalawood':'woody',
    'woody notes':'woody','driftwood':'woody',
    'oud':'oud','agarwood':'oud','oud wood':'oud',
    'amber':'amber','dry amber':'amber','amberwood':'amber',
    'musk':'musk','white musk':'musk','ambergris':'musk','ambroxan':'musk','cashmeran':'musk',
    'oakmoss':'moss','moss':'moss',
    'incense':'incense','frankincense':'incense','benzoin':'incense',
    'olibanum':'incense','myrrh':'incense','labdanum':'incense',
    'tobacco':'tobacco',
    'leather':'leather','suede':'leather',
    'marine':'aquatic','sea notes':'aquatic','aquatic notes':'aquatic','sea salt':'aquatic','ozonic':'aquatic',
    'vanilla':'gourmand','caramel':'gourmand','praline':'gourmand','honey':'gourmand',
    'sugar':'gourmand','tonka bean':'gourmand','cream':'gourmand','milk':'gourmand',
    'almond':'gourmand','marshmallow':'gourmand','rum':'gourmand','dates':'gourmand',
    'raspberry':'fruity','blackcurrant':'fruity','black currant':'fruity','cassis':'fruity',
    'lychee':'fruity','litchi':'fruity','peach':'fruity','apple':'fruity','green apple':'fruity',
    'pear':'fruity','pineapple':'fruity','mango':'fruity','cherry':'fruity',
    'plum':'fruity','apricot':'fruity','strawberry':'fruity','red berries':'fruity',
    'red fruits':'fruity','berries':'fruity','fig':'fruity','rhubarb':'fruity','coconut':'fruity',
    'coffee':'coffee','dark chocolate':'coffee','cocoa':'coffee'
  };
  function getCategory(n){
    if(!n) return 'default';
    n = n.toLowerCase().trim();
    if(map[n]) return map[n];
    for(var k in map){ if(n.indexOf(k)!==-1) return map[k]; }
    return 'default';
  }
  document.querySelectorAll('#fj-{{ section.id }} .fj__dot').forEach(function(d){
    var cat = getCategory(d.getAttribute('data-note'));
    d.style.background = colors[cat] || 'var(--m-taupe)';
  });
})();
</script>
