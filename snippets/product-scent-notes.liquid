{%- liquid
  assign note_keys = 'top_notes_1,top_notes_2,top_notes_3,top_notes_4,top_notes_5,top_notes_6,heart_notes_1,heart_notes_2,heart_notes_3,heart_notes_4,heart_notes_5,heart_notes_6,base_notes_1,base_notes_2,base_notes_3,base_notes_4,base_notes_5,base_notes_6' | split: ','
  assign has_notes = false
  for key in note_keys
    assign val = product.metafields.custom[key].value
    if val and val != blank
      assign has_notes = true
      break
    endif
  endfor
-%}

{% if has_notes %}
{{ sn_svg_sprites }}

<div class="sn" id="sn-{{ section.id }}">
  <div class="sn__title-bar">
    <span class="sn__title">{{ section.settings.title }}</span>
    <span class="sn__rule" aria-hidden="true"></span>
  </div>
  <div class="sn__chips">
    {%- for key in note_keys -%}
      {%- assign note_val = product.metafields.custom[key].value -%}
      {%- if note_val and note_val != blank -%}
        <span class="sn__chip">
          <span class="sn__chip-icon" data-note="{{ note_val | downcase | escape }}"></span>{{ note_val }}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
.sn {
  box-sizing: border-box;
  inline-size: 100%;
  max-inline-size: calc(var(--m-content) + 2 * var(--m-gutter));
  margin-inline: auto;
  padding: 28px var(--m-gutter);
}
.sn__title-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}
.sn__title {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-foreground);
  opacity: 0.45;
  white-space: nowrap;
}
.sn__rule {
  flex: 1;
  height: 1px;
  background: currentColor;
  opacity: 0.1;
}
.sn__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.sn__chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 50px;
  font-size: 0.82rem;
  border: 1px solid currentColor;
  color: var(--color-foreground);
  opacity: 0.72;
  line-height: 1;
}
.sn__chip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}
.sn__chip-svg {
  width: 14px;
  height: 14px;
  stroke: currentColor;
  opacity: 0.65;
  fill: none;
}
</style>

<script>
(function(){
  var map = {
    'bergamot':'citrus','lemon':'citrus','lime':'citrus','grapefruit':'citrus','orange':'citrus','mandarin':'citrus','tangerine':'citrus','lemongrass':'citrus','blood orange':'citrus',
    'neroli':'floral','jasmine':'floral','freesia':'floral','lily':'floral','muguet':'floral','tuberose':'floral','ylang':'floral','gardenia':'floral','magnolia':'floral','peony':'floral','orchid':'floral','iris':'floral','violet':'floral','blossom':'floral','flower':'floral','lotus':'floral','geranium':'floral','orange blossom':'floral','orange flower':'floral',
    'rose':'rose','turkish rose':'rose','damask rose':'rose',
    'lavender':'herbal','mint':'herbal','rosemary':'herbal','sage':'herbal','basil':'herbal','thyme':'herbal','petitgrain':'herbal','fig leaf':'herbal',
    'cardamom':'spice','cinnamon':'spice','nutmeg':'spice','saffron':'spice','clove':'spice','ginger':'spice','pepper':'spice','pimento':'spice','pink pepper':'spice','black pepper':'spice',
    'cedarwood':'woody','cedar':'woody','sandalwood':'woody','patchouli':'woody','guaiac wood':'woody','vetiver':'woody','akigalawood':'woody','amberwood':'woody',
    'oud':'oud','agarwood':'oud','oud wood':'oud',
    'amber':'amber','dry amber':'amber','grey amber':'amber',
    'musk':'musk','white musk':'musk','ambergris':'musk','ambroxan':'musk','cashmeran':'musk',
    'oakmoss':'moss','moss':'moss','crystal moss':'moss',
    'incense':'incense','frankincense':'incense','benzoin':'incense','labdanum':'incense','myrrh':'incense','cistus':'incense',
    'tobacco':'tobacco','smoke':'tobacco',
    'leather':'leather','suede':'leather',
    'marine':'aquatic','sea':'aquatic','aquatic':'aquatic','ozonic':'aquatic','dewdrop':'aquatic',
    'vanilla':'gourmand','caramel':'gourmand','praline':'gourmand','honey':'gourmand','tonka':'gourmand','milk':'gourmand','cream':'gourmand',
    'raspberry':'fruity','peach':'fruity','apple':'fruity','pear':'fruity','pineapple':'fruity','cherry':'fruity','plum':'fruity','coconut':'fruity','mango':'fruity','lychee':'fruity','berries':'fruity','fig':'fruity','strawberry':'fruity','blackcurrant':'fruity','cassis':'fruity','dates':'fruity',
    'coffee':'coffee','cacao':'coffee','cocoa':'coffee','dark chocolate':'coffee'
  };
  function getIcon(n){
    if(!n) return 'default';
    n = n.toLowerCase().trim();
    if(map[n]) return map[n];
    var keys = Object.keys(map);
    for(var i=0;i<keys.length;i++){
      if(n.indexOf(keys[i])!==-1) return map[keys[i]];
    }
    return 'default';
  }
  document.querySelectorAll('#sn-{{ section.id }} .sn__chip-icon').forEach(function(s){
    var key = getIcon(s.getAttribute('data-note'));
    s.innerHTML = '<svg class="sn__chip-svg"><use href="#fji-'+key+'"/></svg>';
  });
})();
</script>
{% endif %}
