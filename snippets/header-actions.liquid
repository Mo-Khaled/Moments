<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

<header-actions
  {{- block.shopify_attributes -}}
>
  {%- comment -%} MOMENTS: EN / AR switch beside the account and cart (owner request 2026-10-30) {%- endcomment -%}
  {% render 'moments-language-toggle' %}

  {% if shop.customer_accounts_enabled %}
    {% render 'account-popover' %}
    {% render 'account-drawer' %}
  {% endif %}

  {%- comment -%}
    Wishlist heart (2026-11-20, owner): next to the cart, phone and desktop. Signed-out visitors go to sign in first and come
    back to the wishlist (new customer accounts: /account/login?return_url= becomes return_to). The wishlist page itself is
    /pages/wishlist (Zooomy template; the app is not active, see PROGRESS.md).
  {%- endcomment -%}
  {%- liquid
    assign wl_url = routes.root_url | append: '/pages/wishlist' | replace: '//', '/'
    if customer
      assign wl_href = wl_url
    else
      assign login_base = routes.root_url | append: '/account/login' | replace: '//', '/'
      assign wl_href = login_base | append: '?return_url=' | append: wl_url
    endif
  -%}
  <a
    href="{{ wl_href }}"
    class="header-actions__action m-wishlist-action" data-m-wishlist data-signed-in="{% if customer %}true{% else %}false{% endif %}"
    aria-label="{% if request.locale.iso_code == 'ar' %}المفضلة{% else %}Wishlist{% endif %}"
  >
    <span class="svg-wrapper" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span class="m-wishlist-count" data-m-wishlist-count hidden></span>
    </span>
  </a>

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    {% render 'cart-drawer' %}
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
    >
      {% render 'cart-icon-component' %}
    </a>
  {% endif %}
</header-actions>

{% stylesheet %}
  .cart-drawer {
    --cart-drawer-padding: var(--padding-lg) var(--padding-xl);
    --cart-drawer-padding-desktop: var(--padding-xl) var(--padding-2xl);
    --cart-font-size--2xs: var(--font-size--2xs);
    --cart-font-size--xs: var(--font-size--xs);
    --cart-font-size--sm: var(--font-size--sm);
    --cart-font-size--md: var(--font-size--md);
    --cart-font-size--2xl: var(--font-size--2xl);
  }

  .cart-drawer__dialog {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border-left: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
    background-color: var(--color-background);
  }

  /* Needed to ensure the drawer is full height */
  .cart-drawer__dialog:modal {
    max-height: 100dvh;
    overflow-y: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
  }

  .cart-drawer__content {
    padding: 0;
    background-color: var(--color-background);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .cart-drawer__close-button {
    margin-right: calc(var(--padding-sm) * -1);
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__heading {
    margin-bottom: var(--margin-md);
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid var(--color-border);
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__original-total-container:empty)) {
    border-block-start: var(--style-border-width) solid var(--color-border);
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer__heading--empty {
    display: flex;
    justify-content: center;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;

    @media screen and (min-width: 750px) {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid var(--color-border);
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer--empty .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    margin-top: 0;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: center;
  }

  .cart-drawer--empty .cart-drawer__header {
    justify-content: right;
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-drawer--empty .cart-drawer__heading {
    text-align: center;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-items__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  header-actions {
    display: flex;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
    }
  }

  .header__column--right header-actions {
    margin-inline-start: calc(var(--gap-md) * -1);
  }

  .header-actions__action {
    --button-color: var(--color-foreground);

    cursor: pointer;
    display: flex;
    justify-content: center;
  }

  /* Phone: no profile icon in the header (it is in the bottom tab bar); the wishlist heart takes its place next to the cart. */
  @media screen and (max-width: 749px) {
    header-actions .account-drawer,
    header-actions account-drawer-component,
    header-actions [class*='account-drawer'] {
      display: none;
    }
  }

  .m-wishlist-action svg {
    inline-size: 22px;
    block-size: 22px;
  }

  .header-actions__action .svg-wrapper {
    height: var(--button-size);
    width: var(--button-size);
  }

  .header-actions__action svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .header-actions__cart-icon {
    --cart-bubble-size: 20px;
    --cart-bubble-top: 4.5px;
    --cart-bubble-right: 2.5px;

    position: relative;
  }

  .header-actions__cart-icon .cart-bubble {
    position: absolute;
    width: var(--cart-bubble-size, 20px);
    top: var(--cart-bubble-top);
    right: var(--cart-bubble-right);
  }

  .header-actions__cart-icon .cart-bubble__text,
  .cart-drawer__heading .cart-bubble__text {
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
  }

  .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
    /* Create donut mask where the cart bubble sits */
    mask: radial-gradient(
      calc(var(--cart-bubble-size) + 2px) at calc(100% - var(--cart-bubble-right)) var(--cart-bubble-top),
      transparent 45.45%,
      #fff 45.45%,
      #fff 100%
    );
  }

  .cart-drawer__heading .cart-bubble__background {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-drawer__heading .cart-bubble__text {
    color: var(--color-foreground);
    font-size: var(--font-size--xs);
  }

  .cart-bubble--animating .cart-bubble__background {
    animation: grow var(--animation-speed) var(--animation-easing);
  }

  .cart-bubble--animating .cart-bubble__text {
    animation: cartBubbleSlideIn var(--animation-speed) var(--animation-easing);
  }

  /* Wishlist Guru shows its own header heart and a floating pink heart. We keep ONE heart (ours) and hide both (owner 2026-11-21). */
  .wg-tinker-headerIcon-desktop,
  #wf-float-heart-bottom-right,
  .wf-floating-launcher {
    display: none !important;
  }

  .m-wishlist-action { position: relative; }

  .m-wishlist-count {
    position: absolute;
    inset-block-start: 2px;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    min-inline-size: 18px;
    block-size: 18px;
    padding-inline: 4px;
    border-radius: 9999px;
    background: var(--m-berry);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  .m-wishlist-count[hidden] { display: none; }
{% endstylesheet %}

{% javascript %}
  // Our header heart is the only one. Signed in: it opens the wishlist app's own list. Signed out: it goes to sign-in first (the link).
  // The count is copied from the app (its own header icon is hidden by CSS but still keeps the number up to date).
  (() => {
    const heart = document.querySelector('[data-m-wishlist]');
    if (!heart || heart.dataset.mWired) return;
    heart.dataset.mWired = '1';
    heart.addEventListener('click', (e) => {
      if (heart.dataset.signedIn === 'true' && typeof window.heartButtonHandle === 'function') {
        e.preventDefault();
        window.heartButtonHandle();
      }
    });
    const badge = heart.querySelector('[data-m-wishlist-count]');
    let last = null;
    const sync = () => {
      const src = document.querySelector('.wg-tinker-headerIcon-desktop .show-count b');
      const n = src ? parseInt(src.textContent, 10) || 0 : 0;
      if (n === last) return; // never write when nothing changed (writing re-triggers the observer)
      last = n;
      badge.textContent = document.documentElement.lang === 'ar' ? n.toLocaleString('ar-EG') : String(n);
      badge.hidden = n === 0;
    };
    sync();
    // watch only the app's own counter, not the whole page
    const watch = () => {
      const host = document.querySelector('.wg-tinker-headerIcon-desktop');
      if (!host) return false;
      new MutationObserver(sync).observe(host, { childList: true, subtree: true, characterData: true });
      return true;
    };
    let tries = 0;
    const t = setInterval(() => { sync(); if (watch() || ++tries > 20) clearInterval(t); }, 400);
  })();

  // Wishlist Guru shows its popup in English only (one language per app). On Arabic pages we swap its fixed texts for Arabic here, in the theme.
  // Only exact known strings are replaced (case-insensitive); the app's settings are not touched. Unknown strings stay English.
  (() => {
    if (document.documentElement.lang !== 'ar') return;
    const AR = {
      'your wishlist': 'قائمة مفضلتك',
      'wishlist is not saved permanently yet. please': 'قائمتك غير محفوظة بشكل دائم بعد. يرجى',
      'login': 'تسجيل الدخول',
      'or': 'أو',
      'create account': 'إنشاء حساب',
      'clear wishlist': 'مسح القائمة',
      'view as:': 'عرض كـ:',
      'share': 'مشاركة',
      'your wishlist is empty': 'قائمة مفضلتك فارغة',
      'continue shopping': 'تابع التسوق',
      'view cart': 'عرض السلة',
      'powered by': 'بدعم من',
      'search here': 'ابحث هنا',
      'add to wishlist': 'أضف إلى المفضلة',
      'added to wishlist': 'في المفضلة',
      'remove from wishlist': 'إزالة من المفضلة',
      'view wishlist': 'عرض المفضلة'
    };
    const swap = (root) => {
      const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      let n;
      while ((n = w.nextNode())) {
        const t = n.nodeValue.replace(/\s+/g, ' ').trim();
        const a = AR[t.toLowerCase()];
        if (a && a !== t) n.nodeValue = n.nodeValue.replace(t, a);
      }
      root.querySelectorAll('input[placeholder]').forEach((i) => {
        const a = AR[i.placeholder.trim().toLowerCase()];
        if (a && a !== i.placeholder) i.placeholder = a;
      });
    };
    const watched = new WeakSet();
    const watchEl = (el) => {
      if (!el || watched.has(el)) return !!el;
      watched.add(el);
      swap(el);
      new MutationObserver(() => swap(el)).observe(el, { childList: true, subtree: true, characterData: true });
      return true;
    };
    const watch = () => {
      const a = watchEl(document.getElementById('inject_wish_button'));
      const b = watchEl(document.getElementById('wg-myModal'));
      return a && b;
    };
    watch();
    // The app can add or rebuild its button and popup at any time (slow load, variant change): keep watching the page,
    // cheaply (one check per animation frame at most), and never stop.
    let queued = false;
    new MutationObserver(() => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        ['inject_wish_button', 'wg-myModal'].forEach((id) => { const el = document.getElementById(id); if (el) { watchEl(el); swap(el); } });
      });
    }).observe(document.body, { childList: true, subtree: true });
  })();
{% endjavascript %}
