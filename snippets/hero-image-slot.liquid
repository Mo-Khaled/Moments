{%- doc -%}
  Placeholder shown in a hero when no image or video is set. It stands in for the
  Shopify demo illustration until real fragrance photography is uploaded in the
  theme editor. In the theme editor a label marks the empty slot, so it can't be
  forgotten; on the storefront it is a plain plum field (no TODO text for shoppers).

  @param {string} [class] - CSS classes added to the slot (pass the hero image classes for sizing).

  @example
  {% render 'hero-image-slot', class: 'hero__image' %}
{%- enddoc -%}

{%- comment -%} The label is for the theme editor only; shoppers see a plain plum field. {%- endcomment -%}
<div
  class="hero-image-slot {{ class }}"
  {% if request.design_mode %}role="img" aria-label="{{ 'placeholders.hero_image_todo' | t }}"{% else %}aria-hidden="true"{% endif %}
>
  {%- if request.design_mode -%}
    <span class="hero-image-slot__label">{{ 'placeholders.hero_image_todo' | t }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero-image-slot {
    display: flex;
    align-items: flex-end;
    background: var(--m-plum);
    color: var(--m-pearl);
  }

  /* A thin strip along the bottom edge: it sits inside the hero's bottom padding, so it never overlaps the buttons. */
  .hero-image-slot__label {
    inline-size: 100%;
    padding-block: var(--padding-2xs, 4px);
    padding-inline: var(--padding-sm, 12px);
    border-block-start: 1px dashed currentcolor;
    font-size: var(--font-size--xs, 0.75rem);
    line-height: 1.4;
    text-align: center;
  }
{% endstylesheet %}
