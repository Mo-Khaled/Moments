{%- doc -%}
  Renders a free-shipping progress bar inside the cart drawer.

  @param {number} [threshold_cents] - Free shipping threshold in cents. Defaults to 250000 (2,500 EGP).
  @param {number} [suggestion_window_cents] - Max remaining gap to show collection link. Defaults to 30000 (300 EGP).
{%- enddoc -%}

{%- liquid
  assign threshold_cents = threshold_cents | default: 250000
  assign suggestion_window_cents = suggestion_window_cents | default: 30000
  assign remaining_cents = threshold_cents | minus: cart.total_price
  assign progress_percent = cart.total_price | times: 100 | divided_by: threshold_cents
  if progress_percent > 100
    assign progress_percent = 100
  endif

  assign is_arabic = false
  if request.locale.iso_code == 'ar'
    assign is_arabic = true
  endif
-%}

<div class="free-shipping-bar" data-free-shipping-bar>
  <p class="free-shipping-bar__eyebrow">
    {%- if is_arabic -%}
      الشحن المجاني
    {%- else -%}
      Free Shipping
    {%- endif -%}
  </p>

  {%- if remaining_cents > 0 -%}
    <p class="free-shipping-bar__message">
      {%- if is_arabic -%}
        باقيلك <strong>{{ remaining_cents | money }}</strong> علشان تاخد شحن مجاني
      {%- else -%}
        You're <strong>{{ remaining_cents | money }}</strong> away from free shipping
      {%- endif -%}
    </p>
  {%- else -%}
    <p class="free-shipping-bar__message free-shipping-bar__message--complete">
      <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
      {%- if is_arabic -%}
        مبروك! هتاخد شحن مجاني على أوردرك
      {%- else -%}
        You've unlocked free shipping
      {%- endif -%}
    </p>
  {%- endif -%}

  <div
    class="free-shipping-bar__track"
    role="progressbar"
    aria-valuenow="{{ progress_percent }}"
    aria-valuemin="0"
    aria-valuemax="100"
  >
    <div class="free-shipping-bar__fill" style="--progress: {{ progress_percent }}%;"></div>
  </div>

  {%- if remaining_cents > 0 and remaining_cents <= suggestion_window_cents -%}
    <a href="/collections/under-300-egp" class="free-shipping-bar__collection-link">
      <span>Shop Picks Under 300 EGP</span>
      <span class="svg-wrapper free-shipping-bar__collection-link-icon">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </span>
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .free-shipping-bar {
    padding: var(--padding-sm) var(--cart-drawer-padding, var(--padding-sm));
    border-block-end: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .free-shipping-bar__eyebrow {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--m-text-muted);
  }

  .free-shipping-bar__message {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--m-text);
    letter-spacing: 0.005em;
  }

  .free-shipping-bar__message strong {
    font-weight: 700;
  }

  .free-shipping-bar__message--complete {
    font-weight: 600;
  }

  .free-shipping-bar__message--complete .svg-wrapper {
    display: inline-flex;
    vertical-align: -3px;
    margin-inline-end: 4px;
  }

  .free-shipping-bar__message--complete .svg-wrapper svg {
    width: 14px;
    height: 14px;
    fill: var(--m-text);
  }

  .free-shipping-bar__track {
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: var(--m-taupe-light);
    overflow: hidden;
    margin-block-start: 2px;
  }

  .free-shipping-bar__fill {
    height: 100%;
    width: var(--progress, 0%);
    background: var(--m-action);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .free-shipping-bar__collection-link {
    margin-block-start: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid var(--m-action);
    background: var(--m-action);
    color: var(--m-action-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .free-shipping-bar__collection-link:hover {
    background: var(--m-berry-600);
    border-color: var(--m-berry-600);
  }

  .free-shipping-bar__collection-link-icon {
    display: inline-flex;
  }

  .free-shipping-bar__collection-link-icon svg {
    width: 11px;
    height: 11px;
    display: block;
    flex-shrink: 0;
    fill: var(--m-action-text);
  }

  [dir='rtl'] .free-shipping-bar__collection-link-icon svg {
    transform: scaleX(-1);
  }
{% endstylesheet %}
