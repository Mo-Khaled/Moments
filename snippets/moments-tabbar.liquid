{%- doc -%}
  Phone tab bar (2026-11-20, owner request): a fixed bottom navigation on phones only (under 750px). Five tabs, the ones a
  shopper needs to move around MOMENTS with one thumb: Home, Moments (the "find your moment" page), Bundle, Cart (with the live
  count; opens the cart drawer) and Account. No wishlist (the store has none) and no AI.

  2026-11-20 (owner): Cart left the bar (it is in the header); a Language switch with a round flag took its place.
  Look: the page white with one hairline, plum line icons and labels (Readex Pro 11px), the active tab marked in rose (brand guide:
  "Rose marks the active tab"). RTL follows the document direction. It respects the iPhone home indicator (safe-area inset).
  The product page's sticky add-to-cart bar and the bundle page's summary bar sit just above it (see the stylesheet).

  @example
  {% render 'moments-tabbar' %}
{%- enddoc -%}

{%- liquid
  assign active = ''
  if template.name == 'index'
    assign active = 'home'
  elsif template.name == 'cart'
    assign active = 'cart'
  elsif template.name contains 'customers'
    assign active = 'account'
  elsif template.name == 'page' and page.handle == 'make-a-bundle'
    assign active = 'bundle'
  elsif template.name == 'page' and page.handle == 'moments'
    assign active = 'moments'
  elsif template.name == 'collection' and collection.handle contains '-moment'
    assign active = 'moments'
  endif
  assign moments_page = pages['moments']
  assign moments_url = moments_page.url | default: routes.collections_url
  assign bundle_page = pages['make-a-bundle']
  assign bundle_url = bundle_page.url | default: routes.collections_url
  if shop.customer_accounts_enabled
    assign account_url = routes.account_url
  endif
-%}

<nav class="m-tabbar" aria-label="{{ 'tabbar.label' | t }}" data-m-tabbar>
  <a class="m-tabbar__tab" href="{{ routes.root_url }}"{% if active == 'home' %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/></svg>
    <span>{{ 'tabbar.home' | t }}</span>
  </a>
  <a class="m-tabbar__tab" href="{{ moments_url }}"{% if active == 'moments' %} aria-current="page"{% endif %}>
    <span class="m-tabbar__mark">{{ 'moments-mark.svg' | inline_asset_content }}</span>
    <span>{{ 'tabbar.moments' | t }}</span>
  </a>
  <a class="m-tabbar__tab" href="{{ bundle_url }}"{% if active == 'bundle' %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM3 6h18v3H3zM12 6v15M12 6c-1.5-3-5-3.2-5-1.2C7 6 9.5 6 12 6zm0 0c1.5-3 5-3.2 5-1.2C17 6 14.5 6 12 6z"/></svg>
    <span>{{ 'tabbar.bundle' | t }}</span>
  </a>
  {%- comment -%}
    Language (owner 2026-11-20): replaces Cart (the cart is in the header). Shows the CURRENT language as a round flag
    (English: UK, Arabic: Egypt) and switches to the other one on the same page through Shopify's localization form
    (return_to is rewritten to the address bar by snippets/moments-language-toggle.liquid). Inline SVG, no image requests.
  {%- endcomment -%}
  {%- if localization.available_languages.size > 1 -%}
    {%- liquid
      assign cur = localization.language.iso_code | split: '-' | first
      assign other = 'ar'
      if cur == 'ar'
        assign other = 'en'
      endif
      for l in localization.available_languages
        assign lc = l.iso_code | split: '-' | first
        if lc == other
          assign other_code = l.iso_code
        endif
      endfor
    -%}
    {%- assign cur_flag = 'flag-gb.svg' -%}
    {%- if cur == 'ar' -%}{%- assign cur_flag = 'flag-eg.svg' -%}{%- endif -%}
    <button class="m-tabbar__tab" type="button" data-m-lang-open aria-haspopup="dialog"
      aria-label="{% if cur == 'ar' %}اللغة: عربي. اختيار اللغة{% else %}Language: English. Choose language{% endif %}">
      <span class="m-tabbar__flag" aria-hidden="true">
        <img src="{{ cur_flag | asset_url }}" alt="" width="24" height="24" loading="eager" decoding="async">
      </span>
      <span>{% if cur == 'ar' %}عربي{% else %}English{% endif %}</span>
    </button>
    <dialog class="m-langsheet" data-m-lang-sheet aria-labelledby="m-langsheet-title">
      <div class="m-langsheet__grip" aria-hidden="true"></div>
      <div class="m-langsheet__head">
        <h2 class="m-langsheet__title" id="m-langsheet-title">{% if cur == 'ar' %}اختر اللغة{% else %}Choose your language{% endif %}</h2>
        <button class="m-langsheet__close" type="button" data-m-lang-close aria-label="{% if cur == 'ar' %}إغلاق{% else %}Close{% endif %}">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      {%- form 'localization', class: 'm-langsheet__list', return_to: request.path -%}
        {%- for l in localization.available_languages -%}
          {%- assign lc = l.iso_code | split: '-' | first -%}
          {%- assign row_flag = 'flag-gb.svg' -%}
          {%- if lc == 'ar' -%}{%- assign row_flag = 'flag-eg.svg' -%}{%- endif -%}
          <button class="m-langsheet__row" type="submit" name="language_code" value="{{ l.iso_code }}" lang="{{ l.iso_code }}" dir="{% if lc == 'ar' %}rtl{% else %}ltr{% endif %}"{% if l.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}>
            <img src="{{ row_flag | asset_url }}" alt="" width="40" height="40" loading="lazy" decoding="async">
            <span class="m-langsheet__name">{{ l.endonym_name }}</span>
          </button>
        {%- endfor -%}
      {%- endform -%}
    </dialog>
  {%- endif -%}
  {%- if account_url -%}
    <a class="m-tabbar__tab" href="{{ account_url }}"{% if active == 'account' %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
      <span>{{ 'tabbar.account' | t }}</span>
    </a>
  {%- endif -%}
</nav>

<script>
  (() => {
    const bar = document.querySelector('[data-m-tabbar]');
    if (!bar) return;
    // Language sheet (owner 2026-11-20): the language tab opens a bottom sheet with the language choices.
    const lang = document.querySelector('[data-m-lang-sheet]');
    const langOpen = bar.querySelector('[data-m-lang-open]');
    if (lang && langOpen) {
      langOpen.addEventListener('click', () => lang.showModal());
      lang.querySelector('[data-m-lang-close]').addEventListener('click', () => lang.close());
      lang.addEventListener('click', (e) => { if (e.target === lang) lang.close(); });
    }
    const count = bar.querySelector('[data-m-tabbar-count]');
    if (!count) return; // the Cart tab was replaced by the language switch (2026-11-20)
    // Live count: the theme fires 'cart:update' with the new cart (or an item count) after every change.
    document.addEventListener('cart:update', (e) => {
      const d = e.detail || {};
      const n = d.resource && typeof d.resource.item_count === 'number' ? d.resource.item_count : d.data && d.data.itemCount;
      if (typeof n !== 'number') return;
      count.textContent = n;
      count.hidden = n === 0;
    });
    // Cart opens the drawer when the theme has one (Horizon's cart-drawer-component); otherwise the link goes to /cart.
    bar.querySelector('[data-m-tabbar-cart]').addEventListener('click', (e) => {
      const drawer = document.querySelector('cart-drawer-component');
      if (drawer && typeof drawer.open === 'function' && !document.documentElement.matches('[data-template="cart"]')) {
        e.preventDefault();
        drawer.open();
      }
    });
  })();
</script>

{% stylesheet %}
  .m-tabbar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    :root {
      --m-tabbar-h: 60px;
      --m-tabbar-space: calc(var(--m-tabbar-h) + env(safe-area-inset-bottom, 0px));
    }

    body {
      padding-block-end: var(--m-tabbar-space);
    }

    .m-tabbar {
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 40;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      block-size: var(--m-tabbar-space);
      padding-block-end: env(safe-area-inset-bottom, 0px);
      background: var(--m-surface);
      border-block-start: 1px solid rgb(59 30 58 / 0.1);
      box-shadow: 0 -8px 20px -16px rgb(59 30 58 / 0.25);
    }

    .m-tabbar__tab {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-block-size: 44px;
      color: var(--m-plum);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      line-height: 1.1;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .m-tabbar__tab svg {
      inline-size: 24px;
      block-size: 24px;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Active tab: a rose pill above the icon, the label in berry ink (rose as text fails contrast on white). */
    .m-tabbar__tab[aria-current='page'] {
      color: var(--m-berry-ink);
      font-weight: 600;
    }

    .m-tabbar__tab[aria-current='page']::before {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inline-size: 28px;
      block-size: 3px;
      border-radius: 0 0 3px 3px;
      background: #E68BA2;
    }

    /* The MOMENTS mark (assets/moments-mark.svg, the brand kit's small icon): a filled shape, so it fills instead of stroking. */
    .m-tabbar__mark {
      display: grid;
      place-items: center;
      inline-size: 24px;
      block-size: 24px;
    }

    .m-tabbar__tab .m-tabbar__mark svg {
      inline-size: 24px;
      block-size: 24px;
      fill: currentcolor;
      stroke: none;
    }

    .m-langsheet {
      position: fixed;
      inset: auto 0 0 0;
      inline-size: 100%;
      max-inline-size: none;
      margin: 0;
      padding: 8px 20px calc(28px + env(safe-area-inset-bottom));
      border: 0;
      border-radius: 24px 24px 0 0;
      background: var(--m-pearl);
      color: var(--m-plum);
      box-shadow: 0 -8px 32px rgb(59 30 58 / 0.18);
    }

    .m-langsheet::backdrop { background: rgb(37 18 36 / 0.45); }

    .m-langsheet__grip {
      inline-size: 40px;
      block-size: 4px;
      margin: 4px auto 12px;
      border-radius: 9999px;
      background: rgb(59 30 58 / 0.2);
    }

    .m-langsheet__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-block-end: 8px; }
    .m-langsheet__title { margin: 0; font-size: 1.375rem; line-height: 1.2; }
    .m-langsheet__close {
      display: grid;
      place-items: center;
      flex: none;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      -webkit-appearance: none;
      appearance: none;
      border: 1px solid rgb(59 30 58 / 0.2);
      border-radius: 14px;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    .m-langsheet__list { display: grid; gap: 10px; margin-block-start: 12px; }

    .m-langsheet__row {
      display: flex;
      align-items: center;
      gap: 16px;
      inline-size: 100%;
      min-block-size: 64px;
      padding-inline: 16px;
      border: 1px solid rgb(59 30 58 / 0.2);
      border-radius: 16px;
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 1.0625rem;
      text-align: start;
      -webkit-appearance: none;
      appearance: none;
      cursor: pointer;
    }

    .m-langsheet__row img { inline-size: 40px; block-size: 40px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1px rgb(59 30 58 / 0.2); }
    .m-langsheet__row[aria-current='true'] { border: 2px solid var(--m-plum); background: #F7F3F5; }
    .m-langsheet__row:focus-visible, .m-langsheet__close:focus-visible { outline: 2px solid var(--m-plum); outline-offset: 2px; }

    .m-tabbar__form {
      display: contents;
    }

    button.m-tabbar__tab {
      -webkit-appearance: none;
      appearance: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--m-plum);
      font: inherit;
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      line-height: 1.1;
      cursor: pointer;
    }

    .m-tabbar__flag {
      display: grid;
      inline-size: 24px;
      block-size: 24px;
    }

    .m-tabbar__flag img {
      inline-size: 24px;
      block-size: 24px;
      object-fit: cover;
      border-radius: 50%;
      box-shadow: 0 0 0 1px rgb(59 30 58 / 0.25);
    }

    .m-tabbar__tab span:last-child {
      white-space: nowrap;
    }

    .m-tabbar__icon {
      position: relative;
      display: grid;
    }

    .m-tabbar__count {
      position: absolute;
      inset-block-start: -5px;
      inset-inline-end: -9px;
      min-inline-size: 17px;
      block-size: 17px;
      padding-inline: 4px;
      border-radius: 9999px;
      background: var(--m-berry);
      color: #fff;
      font-size: 0.625rem;
      font-weight: 600;
      line-height: 17px;
      text-align: center;
    }

    .m-tabbar__count[hidden] {
      display: none;
    }

    .m-tabbar__tab:focus-visible {
      outline: 2px solid var(--m-focus);
      outline-offset: -4px;
      border-radius: 8px;
    }

    @media (hover: hover) and (pointer: fine) {
      .m-tabbar__tab:hover {
        color: var(--m-berry-ink);
      }
    }

    /* Bars that were pinned to the bottom of the screen now sit on top of the tab bar. */
    html body .sticky-atc,
    html body .m-bundle__bar {
      bottom: var(--m-tabbar-space);
      inset-block-end: var(--m-tabbar-space);
      padding-bottom: 10px;
    }
  }

  @media print {
    .m-tabbar {
      display: none;
    }
  }
{% endstylesheet %}
