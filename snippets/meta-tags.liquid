<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content="#FCFCFA"
>

{%- comment -%}
  SEO (owner 2026-11-22). One description per page, used for <meta name="description">, og:description and twitter:description:
  home: locale seo.home_description (EN/AR, 150-160 characters)
  product: the product description as plain text (escaped HTML such as &lt;p&gt; is turned
           back into tags first, then all tags are removed), cut to 155 characters; fallback seo.product_description
  collection / brand / all products: the SEO description if set, else the collection description as plain text, else
           seo.all_description (/collections/all) or seo.collection_description
  og:image: product featured image, collection image (or its first product), else the theme setting "Share image".
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign m_desc = ''
  assign og_img = page_image

  case request.page_type
    when 'index'
      assign og_title = 'seo.home_title' | t
      assign m_desc = 'seo.home_description' | t
    when 'product'
      assign og_type = 'product'
      comment
        the product description itself (owner's rule), in the page's language; the SEO description field is not used
        because several products hold Arabic text there, which showed on English pages
      endcomment
      assign m_desc = product.description

      comment
        Product title (owner 2026-11-22). EN: "{vendor} {name} {size} | Original Perfume in Egypt – MOMENTS";
        AR: "{name} {vendor} {size} | عطر أصلي في مصر – MOMENTS". The name and size come from snippets/product-name (the
        translated title on /ar, size from the title, the size tag or custom.volume; nothing is invented), the vendor from
        snippets/vendor-name. The vendor is left out when the name already starts with it. "Original Perfume" only for
        perfumes; other products end "in Egypt – MOMENTS". About 60 characters at most: first the "| …" part goes, then the
        size; words are never cut. The visible H1 does not change.
      endcomment
      capture t_name
        render 'product-name', product: product, plain: true
      endcapture
      capture t_size
        render 'product-name', product: product, size_only: true
      endcapture
      capture t_vendor
        render 'vendor-name', vendor: product.vendor
      endcapture
      assign t_name = t_name | strip_html | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip | split: ' ' | join: ' '
      assign t_size = t_size | strip_html | strip
      assign t_vendor = t_vendor | strip_html | strip
      assign t_name_dc = t_name | downcase
      assign t_vendor_dc = t_vendor | downcase
      assign t_vlen = t_vendor_dc.size
      assign t_start = t_name_dc | slice: 0, t_vlen
      if t_vendor == blank or t_start == t_vendor_dc
        assign t_vendor = ''
      endif
      assign t_is_perfume = false
      assign t_type = product.type | downcase
      comment
        product.type is translated on /ar (Perfume = عطر), so both spellings count
      endcomment
      if t_type == 'perfume' or t_type == 'extrait de parfum' or t_type == 'perfume oil' or t_type == 'eau de parfum' or t_type == 'eau de toilette' or t_type == 'عطر' or t_type == 'زيت عطري' or t_type == 'إكسترية دو بارفان'
        assign t_is_perfume = true
      endif
      if t_name_dc contains ' set' or t_name_dc contains 'طقم' or t_name_dc contains 'collection' or t_name_dc contains 'مجموعة'
        assign t_is_perfume = false
      endif
      if request.locale.iso_code == 'ar'
        comment
          the Arabic brand name, the same list snippets/moments-arabic-digits uses on the page
        endcomment
        assign t_brands = 'AFNAN:أفنان|AJMAL:أجمل|ALMAS PERFUMES:عطور ألماس|AMARAH PERFUMES:عطور أمارة|ARABIYAT SUGAR:عربيات شوجر|ARABIYAT PRESTIGE:عربيات بريستيج|ARMAF:أرماف|ASDAF:أصداف|ASSAF:عساف|AL EZZ FOR OUD:العز للعود|BANAFA FOR OUD:بنافع للعود|DKHOON EMIRATES:دخون الإمارات|FAAN:فان|FRENCH AVENUE:فرنش أفينيو|GULF ORCHID:جلف أوركيد|IBRAQ:إبراق|JEAN ANTOINE:جان أنطوان|KHADLAJ:خدلج|LATTAFA:لطافة|LATTAFA PRIDE:لطافة برايد|LAVERNE:لافيرن|LE BONHEUR:لو بونور|LE FALCONE:لو فالكون|MAISON ALHAMBRA:ميزون الحمراء|MAISON ASRAR:ميزون أسرار|NABEEL PERFUMES:عطور نبيل|NABEEL:نبيل|NASEEM:نسيم|RASASI PERFUMES:عطور الرصاصي|RASASI:الرصاصي|SAINTE VALERE:سانت فاليري|ZIMAYA:زيمايا' | split: '|'
        assign t_vendor_up = t_vendor | upcase | append: ':'
        for pair in t_brands
          assign pair_start = pair | slice: 0, t_vendor_up.size
          if pair_start == t_vendor_up
            assign t_vendor = pair | remove_first: t_vendor_up
            break
          endif
        endfor
        if t_vendor != blank
          assign t_vdc = t_vendor | downcase
          if t_name_dc contains t_vdc
            assign t_vendor = ''
          endif
        endif
        assign t_base = t_name | append: ' ' | append: t_vendor | strip
        if t_is_perfume
          assign t_tail = ' | عطر أصلي في مصر – MOMENTS'
        else
          assign t_tail = ' في مصر – MOMENTS'
        endif
      else
        assign t_base = t_vendor | append: ' ' | append: t_name | strip
        if t_is_perfume
          assign t_tail = ' | Original Perfume in Egypt – MOMENTS'
        else
          assign t_tail = ' in Egypt – MOMENTS'
        endif
      endif
      assign t_sized = t_base
      if t_size != blank
        assign t_sized = t_base | append: ' ' | append: t_size
      endif
      assign p_title = t_sized | append: t_tail
      if p_title.size > 60
        assign p_title = t_sized | append: ' – MOMENTS'
      endif
      if p_title.size > 60
        assign p_title = t_base | append: ' – MOMENTS'
      endif
      assign og_title = p_title
      assign og_img = product.featured_image | default: page_image
    when 'collection'
      assign m_desc = collection.metafields.global.description_tag.value | default: collection.metafields.global.description_tag
      if m_desc == blank
        assign m_desc = collection.description
      endif
      assign og_img = collection.image | default: collection.featured_image | default: page_image
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase

  assign m_desc = m_desc | newline_to_br | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip_newlines | split: ' ' | join: ' ' | strip
  if m_desc == blank
    case request.page_type
      when 'product'
        assign m_desc = 'seo.product_description' | t: title: product.title, vendor: product.vendor
      when 'collection'
        if collection.handle == 'all'
          assign m_desc = 'seo.all_description' | t
        else
          assign m_desc = 'seo.collection_description' | t: title: collection.title
        endif
    endcase
  endif
  if m_desc == blank
    assign m_desc = page_description | newline_to_br | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip_newlines | split: ' ' | join: ' ' | strip
  endif
  if request.page_type != 'index'
    assign m_desc = m_desc | truncate: 155
  endif
  if m_desc == blank
    assign m_desc = 'seo.home_description' | t
  endif
  comment
    the cut also covers a fallback, so no page other than the home page can go over 155 characters
  endcomment
  if request.page_type != 'index'
    assign m_desc = m_desc | truncate: 155
  endif
  if og_img == blank
    assign og_img = settings.seo_share_image
  endif
  assign og_description = m_desc
-%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_img == blank -%}
  {%- comment -%} no image anywhere: the brand share image shipped with the theme (assets/moments-share.jpg, 1200 x 630) {%- endcomment -%}
  <meta
    property="og:image"
    content="https:{{ 'moments-share.jpg' | asset_url }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="630"
  >
  <meta
    property="og:image:alt"
    content="{{ shop.name | escape }}"
  >
{%- endif -%}
{%- if og_img != blank -%}
  <meta
    property="og:image"
    content="https:{{ og_img | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_img | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="{{ 1200 | divided_by: og_img.aspect_ratio | round }}"
  >
  {%- if og_img.alt != blank -%}
    <meta
      property="og:image:alt"
      content="{{ og_img.alt | escape }}"
    >
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  assign m_title = page_title
  if request.page_type == 'index'
    assign m_title = 'seo.home_title' | t
  elsif request.page_type == 'product'
    assign m_title = og_title
  elsif request.page_type == 'collection' and collection.handle == 'all'
    assign m_title = 'seo.all_title' | t
  endif
  if request.locale.iso_code == 'ar'
    if request.page_type == 'page' and page.handle == 'notes'
      assign m_title = 'النوتات – لحظات'
    elsif request.page_type == 'metaobject' and metaobject.type == 'note' and metaobject.name_ar.value != blank
      assign m_title = metaobject.name_ar.value | append: ' – لحظات'
    endif
  endif
-%}
<title>
  {{ m_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless m_title contains shop.name or m_title contains 'لحظات' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ m_desc | escape }}"
>
<link
  rel="preconnect"
  href="https://cdn.shopify.com"
  crossorigin
>
