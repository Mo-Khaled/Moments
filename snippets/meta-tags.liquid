<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- comment -%}
  SEO (owner 2026-11-22). One description per page, used for <meta name="description">, og:description and twitter:description:
  home: locale seo.home_description (EN/AR, 150-160 characters)
  product: the product description as plain text (escaped HTML such as &lt;p&gt; is turned
           back into tags first, then all tags are removed), cut to 155 characters; fallback seo.product_description
  collection / brand / all products: the SEO description if set, else the collection description as plain text, else
           seo.all_description (/collections/all) or seo.collection_description
  og:image: product featured image, collection image (or its first product), else the theme setting "Share image".
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign m_desc = ''
  assign og_img = page_image

  case request.page_type
    when 'index'
      assign og_title = 'seo.home_title' | t
      assign m_desc = 'seo.home_description' | t
    when 'product'
      assign og_type = 'product'
      comment
        the product description itself (owner's rule), in the page's language; the SEO description field is not used
        because several products hold Arabic text there, which showed on English pages
      endcomment
      assign m_desc = product.description
      assign og_img = product.featured_image | default: page_image
    when 'collection'
      assign m_desc = collection.metafields.global.description_tag.value | default: collection.metafields.global.description_tag
      if m_desc == blank
        assign m_desc = collection.description
      endif
      assign og_img = collection.image | default: collection.featured_image | default: page_image
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase

  assign m_desc = m_desc | newline_to_br | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip_newlines | split: ' ' | join: ' ' | strip
  if m_desc == blank
    case request.page_type
      when 'product'
        assign m_desc = 'seo.product_description' | t: title: product.title, vendor: product.vendor
      when 'collection'
        if collection.handle == 'all'
          assign m_desc = 'seo.all_description' | t
        else
          assign m_desc = 'seo.collection_description' | t: title: collection.title
        endif
    endcase
  endif
  if m_desc == blank
    assign m_desc = page_description | newline_to_br | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip_newlines | split: ' ' | join: ' ' | strip
  endif
  if request.page_type != 'index'
    assign m_desc = m_desc | truncate: 155
  endif
  if m_desc == blank
    assign m_desc = 'seo.home_description' | t
  endif
  comment
    the cut also covers a fallback, so no page other than the home page can go over 155 characters
  endcomment
  if request.page_type != 'index'
    assign m_desc = m_desc | truncate: 155
  endif
  if og_img == blank
    assign og_img = settings.seo_share_image
  endif
  assign og_description = m_desc
-%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_img == blank -%}
  {%- comment -%} no image anywhere: the brand share image shipped with the theme (assets/moments-share.jpg, 1200 x 630) {%- endcomment -%}
  <meta
    property="og:image"
    content="https:{{ 'moments-share.jpg' | asset_url }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="630"
  >
  <meta
    property="og:image:alt"
    content="{{ shop.name | escape }}"
  >
{%- endif -%}
{%- if og_img != blank -%}
  <meta
    property="og:image"
    content="https:{{ og_img | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_img | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="{{ 1200 | divided_by: og_img.aspect_ratio | round }}"
  >
  {%- if og_img.alt != blank -%}
    <meta
      property="og:image:alt"
      content="{{ og_img.alt | escape }}"
    >
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  assign m_title = page_title
  if request.page_type == 'index'
    assign m_title = 'seo.home_title' | t
  elsif request.page_type == 'collection' and collection.handle == 'all'
    assign m_title = 'seo.all_title' | t
  endif
  if request.locale.iso_code == 'ar'
    if request.page_type == 'page' and page.handle == 'notes'
      assign m_title = 'النوتات – لحظات'
    elsif request.page_type == 'metaobject' and metaobject.type == 'note' and metaobject.name_ar.value != blank
      assign m_title = metaobject.name_ar.value | append: ' – لحظات'
    endif
  endif
-%}
<title>
  {{ m_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless m_title contains shop.name or m_title contains 'لحظات' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ m_desc | escape }}"
>
<link
  rel="preconnect"
  href="https://cdn.shopify.com"
  crossorigin
>
