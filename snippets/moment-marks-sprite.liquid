{% stylesheet %}
  symbol,
  use {
    overflow: visible;
  }

  .mm-line {
    fill: none;
    stroke: var(--m-mark-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mm-fill {
    fill: var(--m-mark-body);
  }

  .mm-accent-fill {
    fill: var(--m-mark-accent);
  }

  .mm-soft {
    fill-opacity: 0.3;
  }

  .mm-gold {
    stroke: var(--m-mark-gold);
  }

  /* The groups read their transform from variables set on the host element (see moment-mark.liquid).
     Custom properties inherit through <use>, so the host can move one part of a shared symbol. */
  .mm-body,
  .mm-accent {
    transform-box: fill-box;
    transition: transform var(--m-dur-2, 240ms) var(--m-ease, ease-out);
  }

  .mm-body {
    transform-origin: var(--mm-box, 50%) var(--mm-boy, 50%);
    transform: translate(var(--mm-bx, 0px), var(--mm-by, 0px)) rotate(var(--mm-br, 0deg)) scale(var(--mm-bs, 1));
  }

  .mm-accent {
    transform-origin: var(--mm-aox, 50%) var(--mm-aoy, 50%);
    transform: translate(var(--mm-ax, 0px), var(--mm-ay, 0px)) rotate(var(--mm-ar, 0deg)) scale(var(--mm-as, 1));
  }

  /* A host selector cannot reach into a <use> clone, so the large size is switched on with a variable. */
  .mm-detail {
    display: var(--mm-detail-display, none);
  }
{% endstylesheet %}
