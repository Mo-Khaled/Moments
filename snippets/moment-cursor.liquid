{%- doc -%}
  The Moment cursor companion: a small round token carrying the active moment's mark that trails the pointer.
  Original artwork only (the Moment marks), no characters. Behaviour:
    - follows with exponential smoothing; leans into movement through a damped spring;
    - hops on click; bursts a few petals when a button or link is clicked;
    - grows over cards and shows a ring over call-to-action buttons;
    - the animation loop stops when the token has settled and restarts on the next pointer move.
  Off (not even created) on touch and coarse pointers, under 768px, and with prefers-reduced-motion. Turn it off for everyone with
  the theme setting "Moment cursor companion". The native cursor stays visible. Listeners and the frame loop are removed when the
  element leaves the page. Uses transform and opacity only; the token is fixed-position and never affects layout.

  @example
  {% render 'moment-cursor' %}
{%- enddoc -%}

{%- if settings.moments_cursor -%}
  <moment-cursor aria-hidden="true" hidden>
    <span class="moment-cursor__token">
      <svg viewBox="0 0 48 48" width="44" height="44" focusable="false"><use href="#moment-mark-night" data-cursor-use></use></svg>
    </span>
  </moment-cursor>
{%- endif -%}

{% stylesheet %}
  moment-cursor {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 2147483000;
    pointer-events: none;
    will-change: transform;
  }

  moment-cursor[hidden] {
    display: none;
  }

  .moment-cursor__token {
    --mc-scale: 1;

    position: absolute;
    top: 56px;
    left: 62px;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    margin: -32px 0 0 -32px;
    border: 1px solid var(--m-plum);
    border-radius: 9999px;
    background: var(--m-pearl);
    box-shadow: 0 0 0 0 transparent;
    transform: scale(var(--mc-scale));
    opacity: 0;
    transition: transform var(--m-dur-2) var(--m-ease), opacity var(--m-dur-2) var(--m-ease), box-shadow var(--m-dur-2) var(--m-ease), border-color var(--m-dur-2) var(--m-ease);
  }

  moment-cursor[data-on] .moment-cursor__token {
    opacity: 1;
  }

  moment-cursor[data-state='card'] .moment-cursor__token {
    --mc-scale: 1.2;
  }

  moment-cursor[data-state='cta'] .moment-cursor__token {
    --mc-scale: 1.1;
    border-color: var(--m-berry);
    box-shadow: 0 0 0 5px rgb(183 64 106 / 0.22);
  }

  .moment-cursor__token svg {
    --m-mark-ink: var(--m-plum);
    --m-mark-body: var(--m-nude);
    --m-mark-accent: var(--m-berry);
    --m-mark-gold: var(--m-gold-ink);
  }

  .moment-cursor__petal {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 10px;
    block-size: 14px;
    margin: -7px 0 0 -5px;
    border-radius: 80% 0 80% 0;
    background: var(--m-berry);
    pointer-events: none;
    opacity: 0;
    z-index: 2147483000;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('moment-cursor')) {
    class MomentCursor extends HTMLElement {
      connectedCallback() {
        this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.fine = window.matchMedia('(hover: hover) and (pointer: fine)');
        this.wide = window.matchMedia('(min-width: 768px)');
        this.use = this.querySelector('[data-cursor-use]');
        this.token = this.querySelector('.moment-cursor__token');
        this.pos = { x: -100, y: -100 };
        this.target = { x: -100, y: -100 };
        this.angle = 0;
        this.angleVel = 0;
        this.frame = 0;
        this.last = 0;
        this.seen = false;
        this.enabled = false;
        this.onChange = () => this.sync();
        [this.reduced, this.fine, this.wide].forEach((mq) => mq.addEventListener('change', this.onChange));
        this.onMove = (e) => this.move(e);
        this.onDown = (e) => this.click(e);
        this.onLeave = () => this.token.removeAttribute('data-visible');
        this.sync();
      }

      disconnectedCallback() {
        [this.reduced, this.fine, this.wide].forEach((mq) => mq.removeEventListener('change', this.onChange));
        this.detach();
      }

      allowed() {
        return this.fine.matches && this.wide.matches && !this.reduced.matches;
      }

      sync() {
        if (this.allowed() && !this.enabled) this.attach();
        else if (!this.allowed() && this.enabled) this.detach();
      }

      attach() {
        this.enabled = true;
        this.hidden = false;
        document.addEventListener('pointermove', this.onMove, { passive: true });
        document.addEventListener('pointerdown', this.onDown, { passive: true });
        document.documentElement.addEventListener('pointerleave', this.onLeave);
      }

      detach() {
        this.enabled = false;
        cancelAnimationFrame(this.frame);
        this.frame = 0;
        this.hidden = true;
        this.removeAttribute('data-on');
        this.seen = false;
        document.removeEventListener('pointermove', this.onMove);
        document.removeEventListener('pointerdown', this.onDown);
        document.documentElement.removeEventListener('pointerleave', this.onLeave);
      }

      stateFor(el) {
        if (!(el instanceof Element)) return '';
        if (el.closest('.m-btn, button, [role="button"], input[type="submit"], .button')) return 'cta';
        if (el.closest('product-card, .m-tile, .m-mega__moment, .m-chapter, .m-promise')) return 'card';
        return '';
      }

      move(e) {
        if (e.pointerType && e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        this.target.x = e.clientX;
        this.target.y = e.clientY;
        if (!this.seen) {
          this.seen = true;
          this.pos.x = e.clientX;
          this.pos.y = e.clientY;
          this.setAttribute('data-on', '');
        }
        const state = this.stateFor(e.target);
        if (state) this.dataset.state = state; else delete this.dataset.state;
        const moment = document.documentElement.dataset.moment;
        if (moment && this.use && this.use.dataset.moment !== moment) {
          this.use.dataset.moment = moment;
          this.use.setAttribute('href', '#moment-mark-' + moment);
        }
        if (!this.frame) { this.last = performance.now(); this.frame = requestAnimationFrame((t) => this.tick(t)); }
      }

      tick(now) {
        const dt = Math.min(0.05, (now - this.last) / 1000);
        this.last = now;
        // exponential smoothing toward the pointer
        const k = 1 - Math.exp(-dt * 14);
        const dx = this.target.x - this.pos.x;
        const dy = this.target.y - this.pos.y;
        this.pos.x += dx * k;
        this.pos.y += dy * k;
        // damped spring: the token leans in the direction it is moving, then settles upright
        const vx = (dx * k) / Math.max(dt, 0.001);
        const force = -160 * this.angle - 14 * this.angleVel + Math.max(-1, Math.min(1, vx / 900)) * 900;
        this.angleVel += force * dt;
        this.angle += this.angleVel * dt;
        this.style.transform = 'translate3d(' + this.pos.x.toFixed(1) + 'px,' + this.pos.y.toFixed(1) + 'px,0) rotate(' + this.angle.toFixed(2) + 'deg)';
        const settled = Math.abs(dx) < 0.1 && Math.abs(dy) < 0.1 && Math.abs(this.angle) < 0.05 && Math.abs(this.angleVel) < 0.05;
        if (settled) { this.frame = 0; return; }
        this.frame = requestAnimationFrame((t) => this.tick(t));
      }

      click(e) {
        if (!this.token || !this.token.animate) return;
        this.token.animate(
          [{ transform: 'scale(var(--mc-scale)) translateY(0)' }, { transform: 'scale(calc(var(--mc-scale) * 0.86)) translateY(-8px)', offset: 0.4 }, { transform: 'scale(var(--mc-scale)) translateY(0)' }],
          { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' }
        );
        if (this.stateFor(e.target) === 'cta') this.burst(e.clientX, e.clientY);
      }

      burst(x, y) {
        const count = 6;
        for (let i = 0; i < count; i++) {
          const petal = document.createElement('span');
          petal.className = 'moment-cursor__petal';
          petal.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
          document.body.appendChild(petal);
          const a = (Math.PI * 2 * i) / count + Math.random() * 0.5;
          const d = 36 + Math.random() * 26;
          const anim = petal.animate(
            [
              { transform: 'translate3d(' + x + 'px,' + y + 'px,0) rotate(0deg) scale(0.6)', opacity: 0.95 },
              { transform: 'translate3d(' + (x + Math.cos(a) * d) + 'px,' + (y + Math.sin(a) * d) + 'px,0) rotate(' + (a * 60) + 'deg) scale(1)', opacity: 0 },
            ],
            { duration: 520, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'forwards' }
          );
          anim.onfinish = () => petal.remove();
        }
      }
    }

    customElements.define('moment-cursor', MomentCursor);
  }
{% endjavascript %}
