{%- doc -%}
  One Moment mark: a small object illustration for a moment (Night, Gift, All day, Daily, Fresh, Love).
  Decorative by default (aria-hidden); pass `label` when the mark is the only content of a link or button.
  Small (menu rows, card labels) or large (the art on Shop by Moment tiles, 160 px, double the gesture amplitude).
  A merchant-uploaded image or SVG replaces the built-in drawing, and the gesture is set per use.

  Hover: one small gesture. Touch: runs once when the mark scrolls into view. Reduced motion: static.
  The mark reacts when it is hovered, or when any ancestor with the attribute data-moment-host is hovered or focused.

  @param {string} [mark] - night, gift, allday, daily, fresh or love. Blank with an image set means a custom mark.
  @param {image} [image] - Custom image or SVG from the theme editor, shown instead of the built-in drawing.
  @param {string} [gesture] - swing, tie, rise, open, sway, drift or none. Default depends on the mark.
  @param {string} [size] - sm (24 px) or lg (160 px). Default sm.
  @param {string} [label] - Accessible name. Leave blank when the mark is decorative.
  @param {string} [class] - Extra classes.

  @example
  {% render 'moment-mark', mark: 'night', size: 'lg' %}
{%- enddoc -%}

{%- liquid
  assign mark_key = mark | default: '' | downcase | remove: '-' | remove: '_'
  assign mark_size = size | default: 'sm'
  assign mark_gesture = gesture
  if mark_gesture == blank
    case mark_key
      when 'night'
        assign mark_gesture = 'swing'
      when 'gift'
        assign mark_gesture = 'tie'
      when 'allday'
        assign mark_gesture = 'rise'
      when 'daily'
        assign mark_gesture = 'open'
      when 'fresh'
        assign mark_gesture = 'sway'
      when 'love'
        assign mark_gesture = 'drift'
      else
        assign mark_gesture = 'swing'
    endcase
  endif
  assign known = 'night gift allday daily fresh love' | split: ' '
-%}

<moment-mark
  class="moment-mark moment-mark--{{ mark_size }} {{ class }}"
  data-mark="{{ mark_key }}"
  data-gesture="{{ mark_gesture }}"
  {% if label != blank %}
    role="img"
    aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
>
  {%- if image != blank -%}
    {{- image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '', class: 'moment-mark__image' -}}
  {%- elsif known contains mark_key -%}
    <svg viewBox="0 0 48 48" focusable="false"><use href="#moment-mark-{{ mark_key }}"></use></svg>
  {%- endif -%}
</moment-mark>

{% stylesheet %}
  moment-mark {
    --mm-size: 24px;
    --mm-amp: 1;

    display: inline-block;
    inline-size: var(--mm-size);
    block-size: var(--mm-size);
    flex: none;
    line-height: 0;
  }

  .moment-mark--lg {
    --mm-size: 160px;
    --mm-amp: 2;
    --mm-detail-display: inline;
  }

  moment-mark svg,
  .moment-mark__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    object-fit: contain;
  }

  /* Where each gesture pivots. */
  moment-mark[data-mark='night'] { --mm-box: 50%; --mm-boy: 0%; }
  moment-mark[data-mark='fresh'] { --mm-box: 0%; --mm-boy: 100%; --mm-aox: 50%; --mm-aoy: 0%; }
  moment-mark[data-mark='daily'] { --mm-aox: 50%; --mm-aoy: 100%; }
  moment-mark[data-mark='gift'] { --mm-aox: 50%; --mm-aoy: 50%; }
  moment-mark[data-mark='love'] { --mm-aox: 0%; --mm-aoy: 100%; }

  @media (prefers-reduced-motion: no-preference) {
    /* Touch: the script sets data-played once, on scroll-in. */
    moment-mark[data-played] {
      --mm-on: 1;
    }

    @media (hover: hover) and (pointer: fine) {
      moment-mark:hover,
      [data-moment-host]:is(:hover, :focus-within) moment-mark {
        --mm-on: 1;
      }
    }

    /* One small gesture each. The amplitude doubles at the large size through --mm-amp. */
    moment-mark[data-gesture='swing'] { --mm-br: calc(var(--mm-on, 0) * 4deg * var(--mm-amp)); }
    moment-mark[data-gesture='tie'] { --mm-as: calc(1 + var(--mm-on, 0) * 0.08 * var(--mm-amp)); }
    moment-mark[data-gesture='rise'] { --mm-ay: calc(var(--mm-on, 0) * -3px * var(--mm-amp)); }
    moment-mark[data-gesture='open'] { --mm-as: calc(1 + var(--mm-on, 0) * 0.06 * var(--mm-amp)); }
    moment-mark[data-gesture='sway'] { --mm-br: calc(var(--mm-on, 0) * 3deg * var(--mm-amp)); --mm-ay: calc(var(--mm-on, 0) * 4px * var(--mm-amp)); }
    moment-mark[data-gesture='drift'] { --mm-ax: calc(var(--mm-on, 0) * 6px * var(--mm-amp)); --mm-ay: calc(var(--mm-on, 0) * -2px * var(--mm-amp)); --mm-ar: calc(var(--mm-on, 0) * 10deg * var(--mm-amp)); }

    /* A custom image has no parts to move, so the whole image takes a small version of the gesture. */
    .moment-mark__image {
      transition: transform var(--m-dur-2, 240ms) var(--m-ease, ease-out);
      transform: translate(var(--mm-ax, 0px), var(--mm-ay, 0px)) rotate(calc(var(--mm-br, 0deg) + var(--mm-ar, 0deg))) scale(var(--mm-as, 1));
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('moment-mark')) {
    // Touch devices have no hover, so each mark plays its gesture once when it scrolls into view.
    class MomentMark extends HTMLElement {
      connectedCallback() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        this.observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            this.observer.disconnect();
            this.setAttribute('data-played', '');
            this.timer = window.setTimeout(() => this.removeAttribute('data-played'), 900);
          },
          { threshold: 0.6 }
        );
        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        window.clearTimeout(this.timer);
      }
    }

    customElements.define('moment-mark', MomentMark);
  }
{% endjavascript %}
